# semantic_view() plans its expanded SQL inside the caller's query
# (`bind_replace`), rather than running it on a connection of its own. So the
# query reads the caller's transaction, its columns keep DuckDB's own types,
# and it may refer to a lateral column.

require semantic_views

statement ok
CREATE TABLE cq_customers (id INTEGER, region VARCHAR);

statement ok
CREATE TABLE cq_orders (id INTEGER, customer_id INTEGER, amount INTEGER);

statement ok
INSERT INTO cq_customers VALUES (1, 'EU'), (2, 'US');

statement ok
INSERT INTO cq_orders VALUES (10, 1, 100), (11, 1, 50), (12, 2, 70);

statement ok
CREATE SEMANTIC VIEW cq_sv AS
  TABLES (
    o AS cq_orders PRIMARY KEY (id),
    c AS cq_customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    order_customer AS o(customer_id) REFERENCES c
  )
  DIMENSIONS (
    c.region AS c.region
  )
  METRICS (
    o.revenue AS sum(o.amount)
  );

# A row the caller's open transaction inserted is counted.

statement ok
BEGIN;

statement ok
INSERT INTO cq_orders VALUES (13, 2, 30);

query TI rowsort
SELECT * FROM semantic_view('cq_sv', dimensions := ['region'], metrics := ['revenue']);
----
EU	150
US	100

statement ok
ROLLBACK;

query TI rowsort
SELECT * FROM semantic_view('cq_sv', dimensions := ['region'], metrics := ['revenue']);
----
EU	150
US	70

# A semantic view over a temporary table is not reachable yet, although the
# query now runs in the caller's session: the expansion qualifies a bare table
# name with the database and schema stamped at CREATE (`memory.main`), and a
# temporary table lives in `temp.main` (TECH-DEBT #106). Pinned so that the
# fix shows up here.

statement ok
CREATE TEMP TABLE cq_scratch (id INTEGER, amount INTEGER);

statement ok
CREATE SEMANTIC VIEW cq_tmp AS
  TABLES (s AS cq_scratch PRIMARY KEY (id))
  METRICS (s.total AS sum(s.amount));

statement error
SELECT * FROM semantic_view('cq_tmp', metrics := ['total']);
----
Table with name cq_scratch does not exist

statement ok
DROP SEMANTIC VIEW cq_tmp;

statement ok
DROP TABLE cq_scratch;

# The result types are DuckDB's own: sum() over INTEGER is a HUGEINT.

query T
SELECT typeof(revenue) FROM semantic_view('cq_sv', metrics := ['revenue']);
----
HUGEINT

# A lateral column can be used in the predicate.

query TTI rowsort
SELECT t.r, s.region, s.revenue
FROM (VALUES ('EU'), ('US')) t(r),
     LATERAL (SELECT * FROM semantic_view('cq_sv', dimensions := ['region'], metrics := ['revenue'], where_clause := 'region = t.r')) s;
----
EU	EU	150
US	US	70

# Only where_clause may refer to an enclosing query. A member expression's bare
# column that the semantic view's tables lack still fails, as it does in a
# query of its own, rather than reading the outer row's column of that name:
# DuckDB binds a comma join's right side as LATERAL.

statement ok
CREATE TABLE cq_outer (price INTEGER);

statement ok
INSERT INTO cq_outer VALUES (7), (9);

statement ok
CREATE SEMANTIC VIEW cq_bare AS
  TABLES (o AS cq_orders PRIMARY KEY (id))
  METRICS (o.bad AS sum(price));

statement error
SELECT * FROM cq_outer, semantic_view('cq_bare', metrics := ['bad']);
----
Referenced column "price" not found

statement error
SELECT * FROM cq_outer JOIN semantic_view('cq_bare', metrics := ['bad']) ON true;
----
Referenced column "price" not found

statement error
SELECT (SELECT bad FROM semantic_view('cq_bare', metrics := ['bad'])) FROM cq_outer;
----
Referenced column "price" not found

# With nothing enclosing the call, the name fails all the same.

statement error
SELECT * FROM semantic_view('cq_bare', metrics := ['bad']), cq_outer;
----
Referenced column "price" not found

# The same holds for a member that only where_clause brings into the query:
# its expression is the semantic view's, not the caller's predicate.

statement ok
CREATE SEMANTIC VIEW cq_bare_dim AS
  TABLES (o AS cq_orders PRIMARY KEY (id))
  DIMENSIONS (o.d AS price)
  METRICS (o.revenue AS sum(o.amount));

statement error
SELECT * FROM cq_outer, semantic_view('cq_bare_dim', metrics := ['revenue'], where_clause := 'd = 7');
----
Referenced column "price" not found

statement ok
DROP SEMANTIC VIEW cq_bare_dim;

# The isolated bind takes the route the query takes. A filtered query is never
# answered from a materialization, so one whose table is gone does not stop it,
# in a join as at the top level.

statement ok
CREATE TABLE cq_mat (region VARCHAR, revenue HUGEINT);

statement ok
CREATE SEMANTIC VIEW cq_routed AS
  TABLES (o AS cq_orders PRIMARY KEY (id), c AS cq_customers PRIMARY KEY (id))
  RELATIONSHIPS (order_customer AS o(customer_id) REFERENCES c)
  DIMENSIONS (c.region AS c.region)
  METRICS (o.revenue AS sum(o.amount))
  MATERIALIZATIONS (m AS (TABLE cq_mat, DIMENSIONS (region), METRICS (revenue)));

statement ok
DROP TABLE cq_mat;

query ITI rowsort
SELECT p.price, s.region, s.revenue
FROM cq_outer p, semantic_view('cq_routed', dimensions := ['region'], metrics := ['revenue'], where_clause := 'region = ''EU''') s;
----
7	EU	150
9	EU	150

statement ok
DROP SEMANTIC VIEW cq_routed;

statement ok
DROP SEMANTIC VIEW cq_bare;

statement ok
DROP TABLE cq_outer;

# The predicate is spliced into the expansion, so a ';' in it is refused rather
# than ending the expansion's statement.

statement error
SELECT * FROM semantic_view('cq_sv', metrics := ['revenue'], where_clause := 'true; SELECT 1');
----
where_clause is one predicate, so it cannot contain ';'

# A table named in a member expression's subquery resolves in the caller's
# query, so a CTE of that name is read in its place (TECH-DEBT #108). Pinned so
# the fix shows up here: it should read cq_tiers' 1.

statement ok
CREATE TABLE cq_tiers (t INTEGER);

statement ok
INSERT INTO cq_tiers VALUES (1);

statement ok
CREATE SEMANTIC VIEW cq_tiered AS
  TABLES (o AS cq_orders PRIMARY KEY (id))
  DIMENSIONS (o.tier AS (SELECT max(t) FROM cq_tiers))
  METRICS (o.revenue AS sum(o.amount));

query II
WITH cq_tiers AS (SELECT 99 AS t) SELECT * FROM semantic_view('cq_tiered', dimensions := ['tier'], metrics := ['revenue']);
----
99	220

statement ok
DROP SEMANTIC VIEW cq_tiered;

statement ok
DROP TABLE cq_tiers;

# A prepared statement's parameter inside where_clause is refused: the
# expansion is bound in the caller's statement, so it would take one of the
# caller's parameters (TECH-DEBT #105).

statement error
PREPARE cq_p AS SELECT * FROM semantic_view('cq_sv', dimensions := ['region'], metrics := ['revenue'], where_clause := 'region <> ?') WHERE region = ?;
----
TECH-DEBT #105

# Cleanup

statement ok
DROP SEMANTIC VIEW cq_sv;

statement ok
DROP TABLE cq_orders;

statement ok
DROP TABLE cq_customers;
