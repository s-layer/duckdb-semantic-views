# A role-playing pair whose names differ only by quoting (`dep` departure,
# `"dep"` arrival), stored before CREATE rejected it (PR #249 review). Every
# lookup used to compare spellings, so `USING ("dep")` meant the quoted
# (arrival) edge; it must keep meaning it, not the first identifier match.
statement ok
INSERT INTO semantic_layer._definitions (schema_name, name, definition) VALUES (
  'main',
  'rn_stored_quoted_pair',
  '{"tables":[{"alias":"f","table":"rn_flights","pk_columns":["id"]},{"alias":"a","table":"rn_airports","pk_columns":["code"]}],"dimensions":[{"name":"city","expr":"a.city","source_table":"a"}],"metrics":[{"name":"departures","expr":"COUNT(*)","source_table":"f","using_relationships":["dep"]},{"name":"arrivals","expr":"COUNT(*)","source_table":"f","using_relationships":["\"dep\""]}],"joins":[{"table":"a","from_alias":"f","fk_columns":["dep_code"],"ref_columns":["code"],"name":"dep","cardinality":"ManyToOne"},{"table":"a","from_alias":"f","fk_columns":["arr_code"],"ref_columns":["code"],"name":"\"dep\"","cardinality":"ManyToOne"}],"schema_version":1}'
)

query TI rowsort
SELECT * FROM SEMANTIC_VIEW(rn_stored_quoted_pair DIMENSIONS city METRICS arrivals);
----
Denver	1
New York	1
San Francisco	1

query TI rowsort
SELECT * FROM SEMANTIC_VIEW(rn_stored_quoted_pair DIMENSIONS city METRICS departures);
----
Denver	1
San Francisco	2
