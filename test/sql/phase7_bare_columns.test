# TECH-DEBT #83, Phase 7 fixtures 9 and 9b as Snowflake wrote them: every
# member expression reads a BARE column, and several tables share the column
# names (`code` on airports, details, gates and lounges; `region_id` on
# airports and regions; `order_id` on orders, items and notes). Snowflake
# reads a bare column from the member's own table, so each case below is
# answered there (2026-11-12, phase7-fixture-9-10-snowflake.md). Before #83
# A2, A5, A6, C3 and O6, whose queries join two tables that have the column,
# failed here with DuckDB's `Ambiguous reference to column name`; the rest
# pass either way and guard the qualification against changing their rows.

require semantic_views

statement ok
CREATE TABLE bc9_airports (code VARCHAR, city VARCHAR, region_id INTEGER);

statement ok
CREATE TABLE bc9_regions (region_id INTEGER, region VARCHAR);

statement ok
CREATE TABLE bc9_flights (flight_id INTEGER, dep VARCHAR, arr VARCHAR);

statement ok
CREATE TABLE bc9_details (code VARCHAR, terminal VARCHAR);

statement ok
CREATE TABLE bc9_gates (gate_id INTEGER, code VARCHAR, gate VARCHAR);

statement ok
CREATE TABLE bc9_terminals (terminal VARCHAR, operator VARCHAR);

statement ok
CREATE TABLE bc9_lounges (lounge_id INTEGER, code VARCHAR);

