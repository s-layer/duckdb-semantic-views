INSERT INTO bc9_details VALUES ('CDG', 'T2'), ('LHR', 'T5'), ('JFK', 'T4');

statement ok
INSERT INTO bc9_gates VALUES (1, 'CDG', 'G1'), (2, 'CDG', 'G2'), (3, 'LHR', 'G3');

