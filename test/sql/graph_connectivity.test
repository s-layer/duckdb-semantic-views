# TECH-DEBT #72: a relationship graph with a table unreachable from the base
# table (the first one in TABLES) was accepted at CREATE. `check_no_orphans`
# exempts the root, so a FIRST table joined to nothing passed, and two
# components where every table has some edge passed too. Every query then
# emitted `FROM "<root>" LEFT JOIN … ON … = "<other>"."<col>"` — a reference to
# an alias that is never in scope — and failed at bind time
# (`Binder Error: Referenced table "o" not found`). CREATE now rejects both,
# naming the table.
#
# End-to-end coverage for the extension-load -> DDL -> graph-validation path;
# `graph::relationship::tests::disconnected_*` cover the checker directly.

require semantic_views

statement ok
CREATE TABLE gc_lonely (id INTEGER, v INTEGER);

statement ok
CREATE TABLE gc_orders (id INTEGER, customer_id INTEGER, amount INTEGER);

statement ok
CREATE TABLE gc_customers (id INTEGER, region VARCHAR);

statement ok
CREATE TABLE gc_products (id INTEGER, supplier_id INTEGER);

statement ok
CREATE TABLE gc_suppliers (id INTEGER, name VARCHAR);

statement ok
INSERT INTO gc_customers VALUES (1, 'east'), (2, 'west');

statement ok
INSERT INTO gc_orders VALUES (10, 1, 5), (11, 1, 7), (12, 2, 100);

# Case 1: the FIRST table has no relationship. It becomes the graph root and was
# exempt from the orphan check.
statement error
CREATE SEMANTIC VIEW gc_root_disconnected AS
  TABLES (
    x AS gc_lonely PRIMARY KEY (id),
    o AS gc_orders PRIMARY KEY (id),
    c AS gc_customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    o_to_c AS o(customer_id) REFERENCES c
  )
  DIMENSIONS (
    c.region AS c.region
  )
  METRICS (
    o.total AS SUM(o.amount)
  );
----
base table 'x' (the first table in TABLES) is not connected by any relationship

# Case 2: two components, {o, c} and {p, s}. No table is an orphan — each has an
# edge — but `p` and `s` cannot be reached from the base table `o`.
statement error
CREATE SEMANTIC VIEW gc_two_components AS
  TABLES (
    o AS gc_orders PRIMARY KEY (id),
    c AS gc_customers PRIMARY KEY (id),
    p AS gc_products PRIMARY KEY (id),
    s AS gc_suppliers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    o_to_c AS o(customer_id) REFERENCES c,
    p_to_s AS p(supplier_id) REFERENCES s
  )
  DIMENSIONS (
    c.region AS c.region,
    s.name AS s.name
  )
  METRICS (
    o.total AS SUM(o.amount)
  );
----
table 'p' is not reachable from the base table 'o'

# Case 3: several tables and NO relationships at all. `validate_graph` used to
# skip every check when no relationship carried FK columns (a "legacy" path),
# so this was accepted; a metric on the base table worked, but every member on
# `c` emitted `FROM "gc_orders" AS "o" … c.region` and failed at bind time with
# `Referenced table "c" not found`. Rejected now with #72's own error.
statement error
CREATE SEMANTIC VIEW gc_no_relationships AS
  TABLES (
    o AS gc_orders PRIMARY KEY (id),
    c AS gc_customers PRIMARY KEY (id)
  )
  DIMENSIONS (
    c.region AS c.region
  )
  METRICS (
    o.total AS SUM(o.amount)
  );
----
base table 'o' (the first table in TABLES) is not connected by any relationship to the other tables ('c')

# Case 4: the same shape through YAML import, which shares the CREATE-time
# validation.
statement error
CREATE SEMANTIC VIEW gc_no_relationships_yaml FROM YAML $$
tables:
  - alias: o
    table: gc_orders
    pk_columns: [id]
  - alias: c
    table: gc_customers
    pk_columns: [id]
dimensions:
  - name: region
    expr: c.region
    source_table: c
metrics:
  - name: total
    expr: SUM(o.amount)
    source_table: o
$$
----
base table 'o' (the first table in TABLES) is not connected by any relationship to the other tables ('c')

# Case 5: a YAML relationship with no FK columns (the DDL grammar cannot express
# one). It switched graph validation off for the whole view, and every query —
# even of a base-table metric — then failed the fan-trap fence with a
# misleading "legacy pre-Phase-24 definition format" error.
statement error
CREATE SEMANTIC VIEW gc_fkless_yaml FROM YAML $$
tables:
  - alias: o
    table: gc_orders
    pk_columns: [id]
  - alias: c
    table: gc_customers
    pk_columns: [id]
joins:
  - name: o_to_c
    from_alias: o
    table: c
dimensions:
  - name: region
    expr: c.region
    source_table: c
metrics:
  - name: total
    expr: SUM(o.amount)
    source_table: o
$$
----
relationship 'o_to_c' from 'o' to 'c' declares no foreign-key columns

# None of the rejected views was stored.
query I
SELECT count(*) FROM list_semantic_views() WHERE name LIKE 'gc_%';
----
0

# Control: the same tables, listed with a CONNECTED table first, are accepted
# and the query binds and returns the right numbers. Reachability ignores edge
# direction — `o -> c` points away from the root.
statement ok
CREATE SEMANTIC VIEW gc_connected AS
  TABLES (
    o AS gc_orders PRIMARY KEY (id),
    c AS gc_customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    o_to_c AS o(customer_id) REFERENCES c
  )
  DIMENSIONS (
    c.region AS c.region
  )
  METRICS (
    o.total AS SUM(o.amount)
  );

query TI rowsort
SELECT * FROM SEMANTIC_VIEW(gc_connected DIMENSIONS region METRICS total);
----
east	12
west	100

# Control: a single-table view has no graph to connect and is accepted exactly
# as before, through DDL and YAML alike.
statement ok
CREATE SEMANTIC VIEW gc_single AS
  TABLES (o AS gc_orders PRIMARY KEY (id))
  METRICS (o.total AS SUM(o.amount));

query I
SELECT * FROM SEMANTIC_VIEW(gc_single METRICS total);
----
112

statement ok
CREATE SEMANTIC VIEW gc_single_yaml FROM YAML $$
tables:
  - alias: o
    table: gc_orders
    pk_columns: [id]
dimensions:
  - name: order_id
    expr: o.id
    source_table: o
metrics:
  - name: total
    expr: SUM(o.amount)
    source_table: o
$$

query I
SELECT * FROM SEMANTIC_VIEW(gc_single_yaml METRICS total);
----
112

# A disconnected multi-table definition ALREADY STORED (written before this
# check, injected here bypassing the parser) is not re-validated on read, so it
# does not brick the catalog: it is still listed, and the queries that worked
# before still work. Only CREATE rejects the shape.
statement ok
INSERT INTO semantic_layer._definitions (schema_name, name, definition) VALUES (
  'main',
  'gc_stored_disconnected',
  '{"tables":[{"alias":"o","table":"gc_orders","pk_columns":["id"]},{"alias":"c","table":"gc_customers","pk_columns":["id"]}],"dimensions":[{"name":"region","expr":"c.region","source_table":"c"}],"metrics":[{"name":"total","expr":"SUM(o.amount)","source_table":"o"}],"schema_version":1}'
)

query T
SELECT name FROM list_semantic_views() WHERE name = 'gc_stored_disconnected';
----
gc_stored_disconnected

query I
SELECT * FROM SEMANTIC_VIEW(gc_stored_disconnected METRICS total);
----
112
