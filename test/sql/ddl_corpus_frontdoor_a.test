# F-013: ffi.rs::looks_multi_statement_ignores_trailing_semicolons — DuckDB accepts an empty statement between trailing semicolons (`SELECT 1; ;`), and so does a DROP or ALTER ending `; ;`: the parser override declines it, and DuckDB's grammar parses it with the extension's productions and runs it
statement ok
SELECT 1; ;

statement ok
CREATE SEMANTIC VIEW dcf_semi2 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

statement ok
ALTER SEMANTIC VIEW dcf_semi2 SET COMMENT = 'semi'; ;

query T
SELECT comment FROM (SHOW SEMANTIC VIEWS) WHERE name = 'dcf_semi2';
----
semi

statement ok
DROP SEMANTIC VIEW dcf_semi2; ;

query I
SELECT count(*) FROM list_semantic_views();
----
0

# F-013b: a CREATE ending `; ;` runs too, through the grammar (it was refused with a misleading "parser_override is not active" until CREATE moved onto the grammar)
statement ok
CREATE SEMANTIC VIEW dcf_semi3 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region); ;

query I
SELECT count(*) FROM list_semantic_views();
----
1

statement ok
DROP SEMANTIC VIEW dcf_semi3;

