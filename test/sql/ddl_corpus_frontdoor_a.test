require semantic_views

# Phase 3 grammar corpus -- slice F (statement front door), part A of 3.
#
# Ports the cases encoded by:
#   src/parse/detect.rs                  (#[test]s)
#   src/parse/ffi.rs                     (#[test]s)
#   tests/parse_proptest.rs              (proptest properties + #[test]s)
#   tests/create_front_door_proptest.rs  (proptest property)
#   tests/crlf_body_frontdoor.rs         (LF twins only -- see below)
#   tests/quoted_idents_regression.rs
# This part: DDL prefix detection, the view-name slot, and the shape of the
# CREATE body (whitespace, keyword case, missing pieces). Part B
# (ddl_corpus_frontdoor_b.test): body-clause properties, hostile bodies through
# the front door, and statement framing (ffi.rs). Part C
# (ddl_corpus_frontdoor_c.test): src/parse/search_path.rs and
# src/parse/show_clauses.rs. The per-test case map is
# _notes/phase3-corpus/map-F.md.
#
# Row markers: `[syntax]` = a syntactic reject (`statement error` with an empty
# `----` block, which accepts any message -- the runner insists on the line; its
# wording and caret will change under the grammar). `[text]` = today's
# contract for something a grammar might plausibly change (case folding,
# quoting in GET_DDL output, whitespace in stored text). `PRE-EXISTING` =
# today's behaviour pinned although it looks wrong.
#
# Bytes the .test format cannot carry. The runner drops every CR from the
# file, so a CR cannot be written into a statement. A few rows instead wrap a
# statement in query(...) to put a NUL, a 0x01, a CR or a 1 MB statement in
# front of the parser: query() parses its argument through the same parser
# (parser_override runs on it -- SHOW SEMANTIC VIEWS, which is not DuckDB SQL,
# works inside it), so those are genuine parser inputs. Only SELECT-shaped
# statements (SELECT, DESCRIBE, SHOW) can travel that way, so the CRLF CREATE
# bodies of crlf_body_frontdoor.rs are NOT portable: only their LF twins are
# here, and the CR axis is listed as unported in the case map.
#
# Some statements carry literal tabs and trailing whitespace on purpose (the
# whitespace axes of the ported properties); keep them when editing. The
# pre-commit `trailing-whitespace` hook excludes this file, and `.editorconfig`
# tells editors not to trim it.

statement ok
CREATE TABLE dcf_orders (id INTEGER PRIMARY KEY, region VARCHAR, amount INTEGER, status VARCHAR, customer_id INTEGER);

statement ok
INSERT INTO dcf_orders VALUES (1, 'north', 10, 'open', 1), (2, 'south', 20, 'closed', 2);

statement ok
CREATE TABLE dcf_customers (id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO dcf_customers VALUES (1, 'ann'), (2, 'bob');

statement ok
CREATE TABLE dcf_flights (id INTEGER PRIMARY KEY, airport_id INTEGER);

statement ok
CREATE TABLE dcf_airports (id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE dcf_t (a VARCHAR);

statement ok
CREATE TABLE dcf_tr (id INTEGER PRIMARY KEY, r VARCHAR);

statement ok
CREATE MACRO dcf_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

# --- DDL prefix detection: keyword case ---

# F-001: parse_proptest.rs::detect_create_case_insensitive, ::rewrite_create_forms (CREATE), ::as_body_detected_for_create_forms (CREATE), ::as_body_validate_and_rewrite_succeeds, ::detect_semantic_view_ddl_returns_detected (CREATE) — a case-scrambled CREATE SEMANTIC VIEW prefix is ours; the bare name is stored unqualified in the current schema
statement ok
cReAtE sEmAnTiC vIeW dcf_c1 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region) METRICS (t.revenue AS SUM(amount));

query T nosort
SELECT * FROM dcf_ddl('dcf_c1');
----
CREATE OR REPLACE SEMANTIC VIEW dcf_c1 AS
TABLES (
    t AS dcf_orders PRIMARY KEY (id)
)
DIMENSIONS (
    t.region AS region
)
METRICS (
    t.revenue AS SUM(amount)
)

query TTT
SELECT name, database_name, schema_name FROM list_semantic_views() WHERE name = 'dcf_c1';
----
dcf_c1	memory	main

# F-002: parse_proptest.rs::as_body_validate_and_rewrite_succeeds — plain CREATE takes the Create mode, not OR REPLACE: re-creating an existing name is refused and the stored definition is left alone
statement error
CREATE SEMANTIC VIEW dcf_c1 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.status AS status) METRICS (t.revenue AS SUM(amount));
----
already exists

query T nosort
SELECT line FROM dcf_ddl('dcf_c1') WHERE line LIKE '    t.%';
----
    t.region AS region
    t.revenue AS SUM(amount)

# F-003: parse_proptest.rs::detect_create_or_replace_case_insensitive, ::rewrite_create_forms (OR REPLACE), ::as_body_detected_for_create_forms (OR REPLACE) — case-scrambled CREATE OR REPLACE replaces the stored definition
statement ok
Create Or rEPLACE Semantic VIEW dcf_c1 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.status AS status) METRICS (t.revenue AS SUM(amount));

query T nosort
SELECT * FROM dcf_ddl('dcf_c1');
----
CREATE OR REPLACE SEMANTIC VIEW dcf_c1 AS
TABLES (
    t AS dcf_orders PRIMARY KEY (id)
)
DIMENSIONS (
    t.status AS status
)
METRICS (
    t.revenue AS SUM(amount)
)

# F-004: parse_proptest.rs::detect_create_if_not_exists_case_insensitive, ::rewrite_create_forms (IF NOT EXISTS), ::as_body_detected_for_create_forms (IF NOT EXISTS) — case-scrambled CREATE ... IF NOT EXISTS is a no-op on an existing name and creates a new one
statement ok
create SEMANTIC view IF not EXISTS dcf_c1 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region) METRICS (t.revenue AS SUM(amount));

query T nosort
SELECT line FROM dcf_ddl('dcf_c1') WHERE line LIKE '    t.%';
----
    t.status AS status
    t.revenue AS SUM(amount)

statement ok
