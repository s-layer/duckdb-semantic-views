# --- Not ours: ordinary SQL passes through untouched ---

# F-019: parse_proptest.rs::detect_non_ddl_returns_none, ::detect_semantic_view_ddl_returns_not_ours, ::near_miss_no_false_positives — SELECT / INSERT / UPDATE / DELETE / ALTER TABLE / CREATE TABLE / CREATE VIEW / BEGIN / COMMIT / ROLLBACK are neither detected nor near-missed
statement ok
BEGIN TRANSACTION;

statement ok
INSERT INTO dcf_orders VALUES (3, 'east', 30, 'open', 1);

statement ok
UPDATE dcf_orders SET amount = 31 WHERE id = 3;

statement ok
DELETE FROM dcf_orders WHERE id = 3;

statement ok
ALTER TABLE dcf_t ADD COLUMN x INT;

statement ok
CREATE TABLE dcf_plain (id INT);

statement ok
CREATE VIEW dcf_plain_v AS SELECT 1 AS one;

statement ok
COMMIT;

statement ok
BEGIN;

statement ok
ROLLBACK;

query IITTI rowsort
SELECT * FROM dcf_orders;
----
1	north	10	open	1
2	south	20	closed	2

query I
SELECT one FROM dcf_plain_v;
----
1

# --- Near-miss prefixes ---

# F-020: parse_proptest.rs::near_miss_detects_transposition — transposed prefix keywords (cretae / craete / dreop / descrbe / shwo) are rejected with a suggestion of the statement meant, as near misses of F-001 / F-010 / F-005 / F-008 [text]
statement error
cretae semantic view dcf_nm AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
Did you mean 'CREATE SEMANTIC VIEW'?

statement error
craete semantic view dcf_nm AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
Did you mean 'CREATE SEMANTIC VIEW'?

statement error
dreop semantic view dcf_nm;
----
Did you mean 'DROP SEMANTIC VIEW'?

statement error
descrbe semantic view dcf_nm;
----
Did you mean 'DESCRIBE SEMANTIC VIEW'?

statement error
shwo semantic views;
----
Did you mean 'SHOW SEMANTIC VIEWS'?

# F-021: parse_proptest.rs::near_miss_position_at_start — a near miss after leading spaces is still rejected with the suggestion (caret position not asserted) [text]
statement error
          cretae semantic view dcf_nm AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
Did you mean 'CREATE SEMANTIC VIEW'?

# F-022: parse_proptest.rs::test_unicode_homoglyph — a Cyrillic С (U+0421) in place of the Latin C is not the CREATE SEMANTIC VIEW prefix; near miss of F-001 [syntax]
statement error
СREATE SEMANTIC VIEW dcf_nm AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----

# F-023: parse_proptest.rs::test_large_input_no_panic — a 1 MB statement of 'A's (via query(), see header) is not ours and fails as an ordinary syntax error; the connection stays usable. The <50ms budget is not portable. [syntax]
statement error
SELECT * FROM query(repeat('A', 1000000));
----

query I
SELECT 1;
----
1

query I
SELECT count(*) FROM list_semantic_views();
----
0

