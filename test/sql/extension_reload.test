# Extension re-LOAD idempotency — end-to-end behaviour (Phase 62 Wave 3, B18).
#
# What this file pins is only the user-visible half: loading the extension
# twice into the same database must not crash, an already-created semantic
# view must still be listed afterwards, and DDL against it must still work.
#
# It does NOT pin the registration mechanics, and cannot — a `.test` file has
# no view of DBConfig. Those live where they can be observed:
#
#   * test/integration/test_load_extension_twice_idempotent.py — a repeat
#     LOAD in a real Python session, and the grammar's activation on
#     connections opened before and after the LOAD.
#
# (tests/parser_hook_idempotent.rs counted the parser-override entries a
# repeat LOAD registered; it went with the override in the Phase 3 deletion
# PR. The grammar is registered once per database, guarded in
# sv_register_grammar in cpp/src/shim.cpp.)
#
# The header here used to describe a pre-WR-09 architecture in which a re-LOAD
# left two SemanticViewsParserInfo objects registered, "each with its own
# OverrideContext". Both halves of that are gone: WR-09 (v0.10.0) added the
# dedup guard so a repeat LOAD registers nothing new, and AR-7 retired
# OverrideContext entirely (SemanticViewsParserInfo is now an empty marker).
# The assertions below were always architecture-independent, which is why they
# survived the change unaltered — but the description had rotted (code-review
# 2026-08-08).

require semantic_views

statement ok
LOAD semantic_views;

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY);

statement ok
CREATE SEMANTIC VIEW v_reload AS TABLES (t AS t PRIMARY KEY (id)) DIMENSIONS (t.id AS id) METRICS (t.c AS COUNT(*));

# B18: re-LOAD the extension. Whatever the registration layer does with the
# second call, the existing view must still be visible and DROP must still
# work.
statement ok
LOAD semantic_views;

# View is still there.
query I
SELECT count(*) FROM list_semantic_views() WHERE name = 'v_reload';
----
1

# DROP succeeds after re-LOAD -- proves the parser hook is still wired
# correctly after the second registration call.
statement ok
DROP SEMANTIC VIEW v_reload;
