# Phase 65.1 Plan 09 (IN-05, D-25) — null name vector input handling for
# scalar functions accepting a view-name argument.
#
# Each scalar function takes a view name (or related lookup key) as a
# VARCHAR argument. When the argument is NULL the function MUST short-
# circuit to NULL rather than raise or treat the literal string "NULL"
# as a lookup key.
#
# The second half of the file (FF-15) covers the *table*-function side, where
# a NULL argument must raise at bind time instead: `Value::GetValue<string>()`
# renders a NULL Value as the literal text "NULL", so an unguarded bind turns
# `NULL` into a real file path / view name.

require semantic_views

statement ok
LOAD semantic_views;

# --- read_yaml_from_semantic_view: single name argument --------------------

query I
SELECT read_yaml_from_semantic_view(NULL) IS NULL
----
true

# --- get_ddl: (object_type, object_name) - either arg NULL → NULL ----------

query I
SELECT get_ddl(NULL, 'x') IS NULL
----
true

query I
SELECT get_ddl('SEMANTIC_VIEW', NULL) IS NULL
----
true

# --- FF-15: __sv_compute_create_from_yaml — NULL positional args ------------
#
# Every other table function got an up-front IsNull() -> BinderException guard
# with FF-4; this helper TF (the execution-time half of
# `CREATE SEMANTIC VIEW ... FROM YAML FILE`) was missed. Unguarded,
# `GetValue<string>()` rendered a NULL argument as the literal string "NULL",
# so arg 0 opened a file literally named `NULL` and arg 1 created a view named
# `NULL`. Each argument is asserted separately so a regression in any one of
# them is visible on its own.

statement error
SELECT * FROM __sv_compute_create_from_yaml(NULL, 'v', '', '', false)
----
file path is required (positional arg 0)

statement error
SELECT * FROM __sv_compute_create_from_yaml('__TEST_DIR__/ff15_unused.yaml', NULL, '', '', false)
----
view name is required (positional arg 1)

statement error
SELECT * FROM __sv_compute_create_from_yaml('__TEST_DIR__/ff15_unused.yaml', 'v', NULL, '', false)
----
comment is required (positional arg 2

statement error
SELECT * FROM __sv_compute_create_from_yaml('__TEST_DIR__/ff15_unused.yaml', 'v', '', NULL, false)
----
schema and skip_if_present are required

statement error
SELECT * FROM __sv_compute_create_from_yaml('__TEST_DIR__/ff15_unused.yaml', 'v', '', '', NULL)
----
schema and skip_if_present are required

# The guards fire only on NULL: a non-NULL path that does not exist must still
# reach the file-read stage and keep the `FROM YAML FILE failed: ` prefix that
# `test/sql/phase53_yaml_file.test` pins, so the new checks did not swallow the
# existing error surface.
statement error
SELECT * FROM __sv_compute_create_from_yaml('__TEST_DIR__/ff15_nonexistent.yaml', 'v', '', '', false)
----
FROM YAML FILE failed
