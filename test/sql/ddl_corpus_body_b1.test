# --- qualified entries (DIMENSIONS / FACTS): alias.name AS expr ---

# C-012: body_parser/mod.rs::parse_qualified_entries_simple — `o.revenue AS SUM(amount)` in DIMENSIONS splits into alias o, name revenue, expr SUM(amount)
# PRE-EXISTING (TECH-DEBT #95): an aggregate DIMENSION expression is accepted at CREATE (DATA_TYPE
# BIGINT), but no query can use it (GROUP BY cannot contain aggregates). Snowflake
# rejects aggregates in a dimension at CREATE.
statement ok
CREATE SEMANTIC VIEW dcc_c012 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (o.revenue AS SUM(amount));

query T nosort
SELECT * FROM dcc_ddl('dcc_c012');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c012 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.revenue AS SUM(amount)
)

# C-013: body_parser/mod.rs::parse_qualified_entries_nested_parens — nested parens in the expression are kept verbatim
statement ok
CREATE SEMANTIC VIEW dcc_c013 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) FACTS (o.disc_price AS ROUND(o.price * (1 - o.discount))) DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcc_ddl('dcc_c013');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c013 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
FACTS (
    o.disc_price AS ROUND(o.price * (1 - o.discount))
)
DIMENSIONS (
    o.region AS o.region
)

# C-014: body_parser/mod.rs::parse_qualified_entries_trailing_comma — a trailing comma after the only entry adds no entry
statement ok
CREATE SEMANTIC VIEW dcc_c014 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (o.revenue AS o.amount,);

query T nosort
