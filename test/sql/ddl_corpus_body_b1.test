# --- whole body: clause set ---

# C-017: body_parser/mod.rs::parse_keyword_body_basic,
#   body_parser/mod.rs::parse_keyword_body_without_facts_still_works,
#   body_parser/mod.rs::parse_metrics_without_using_backward_compat,
#   body_parser/mod.rs::parse_metrics_window_over_no_over_returns_none,
#   body_parser/mod.rs::parse_keyword_body_without_materializations_has_empty_vec,
#   body_parser/mod.rs::f7_tables_explicit_alias_still_parses,
#   body_parser/mod.rs::f6_no_trailing_comment_is_none,
#   body_parser/mod.rs::test_default_public_metric,
#   body_parser/lexer.rs::bare_idents_and_symbols,
#   body_parser/cursor.rs::peek_bump_and_kw
#   — TABLES + DIMENSIONS + METRICS, no FACTS/RELATIONSHIPS/MATERIALIZATIONS, no view comment
# No WINDOW_SPEC row (plain metric), PUBLIC by default, no materializations,
# no view comment.
statement ok
CREATE SEMANTIC VIEW dcc_c017 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS region) METRICS (o.rev AS SUM(amount));

query T nosort
SELECT * FROM dcc_ddl('dcc_c017');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c017 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.region AS region
)
METRICS (
    o.rev AS SUM(amount)
)

query TTTT rowsort
SELECT object_kind, object_name, property, property_value FROM describe_semantic_view('dcc_c017') WHERE object_kind <> 'TABLE' AND property IN ('TABLE', 'EXPRESSION', 'ACCESS_MODIFIER', 'WINDOW_SPEC');
----
DIMENSION	region	EXPRESSION	region
DIMENSION	region	TABLE	dcc_orders
METRIC	rev	ACCESS_MODIFIER	PUBLIC
METRIC	rev	EXPRESSION	SUM(amount)
METRIC	rev	TABLE	dcc_orders

query I nosort
SELECT count(*) FROM show_semantic_materializations('dcc_c017');
----
0

query T nosort
SELECT comment FROM list_semantic_views() WHERE name = 'dcc_c017';
----
(empty)

