----
CREATE OR REPLACE SEMANTIC VIEW dcc_c014 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.revenue AS o.amount
)

# C-015: body_parser/mod.rs::parse_qualified_entries_multiple_with_trailing_comma — two entries plus a trailing comma give exactly two entries, in order
statement ok
CREATE SEMANTIC VIEW dcc_c015 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (o.a AS o.region, o.b AS o.email,);

query T nosort
SELECT * FROM dcc_ddl('dcc_c015');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c015 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.a AS o.region,
    o.b AS o.email
)

# C-016: body_parser/mod.rs::parse_qualified_entries_error_missing_dot, body_parser/mod.rs::parse_qualified_entries_still_rejects_unqualified — near miss of C-014: a DIMENSIONS entry without the `alias.` qualifier is rejected [syntax]
statement error
CREATE SEMANTIC VIEW dcc_c016 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (revenue AS o.amount);
