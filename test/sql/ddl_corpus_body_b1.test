CREATE SEMANTIC VIEW dcc_c069 AS TABLES (a AS dcc_accounts PRIMARY KEY (id)) DIMENSIONS (a.d1 AS a.date) METRICS (a.bal NON ADDITIVE BY (d1) AS SUM(a.amount));

query T nosort
SELECT * FROM dcc_ddl('dcc_c069');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c069 AS
TABLES (
    a AS dcc_accounts PRIMARY KEY (id)
)
DIMENSIONS (
    a.d1 AS a.date
)
METRICS (
    a.bal NON ADDITIVE BY (d1 NULLS LAST) AS SUM(a.amount)
)

query TTTT rowsort
SELECT object_kind, object_name, property, property_value FROM describe_semantic_view('dcc_c069') WHERE property IN ('EXPRESSION', 'NON_ADDITIVE_BY') AND object_kind = 'METRIC';
----
METRIC	bal	EXPRESSION	SUM(a.amount)
METRIC	bal	NON_ADDITIVE_BY	d1 NULLS LAST

