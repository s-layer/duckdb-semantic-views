# C-004: body_parser/mod.rs::parse_relationships_quoted_paren_in_from_alias — a `(` inside a QUOTED from-alias is inert; the alias is `"a(b"` and the FK list is (cust_id) [text]
statement ok
CREATE SEMANTIC VIEW dcc_c004 AS TABLES ("a(b" AS dcc_orders PRIMARY KEY (id), c AS dcc_customers PRIMARY KEY (id)) RELATIONSHIPS (rel AS "a(b"(cust_id) REFERENCES c) DIMENSIONS ("a(b".region AS "a(b".region);

query T nosort
SELECT * FROM dcc_ddl('dcc_c004');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c004 AS
TABLES (
    "a(b" AS dcc_orders PRIMARY KEY (id),
    c AS dcc_customers PRIMARY KEY (id)
)
RELATIONSHIPS (
    rel AS "a(b"(cust_id) REFERENCES c
)
DIMENSIONS (
    "a(b".region AS "a(b".region
)

query TTTT rowsort
SELECT object_kind, object_name, property, property_value FROM describe_semantic_view('dcc_c004') WHERE object_kind = 'RELATIONSHIP' AND property IN ('TABLE', 'FOREIGN_KEY', 'REF_TABLE');
----
RELATIONSHIP	rel	FOREIGN_KEY	["cust_id"]
RELATIONSHIP	rel	REF_TABLE	dcc_customers
RELATIONSHIP	rel	TABLE	dcc_orders

# C-005: body_parser/mod.rs::parse_relationships_multi_token_from_alias_rejected — near miss of C-002: a two-token from-alias `o c(...)` is rejected, not captured as a bogus alias [syntax]
statement error
CREATE SEMANTIC VIEW dcc_c005 AS TABLES (o AS dcc_orders PRIMARY KEY (id), c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)) RELATIONSHIPS (rel AS o c(cust_id) REFERENCES c(id)) DIMENSIONS (o.region AS o.region);
----

# C-006: body_parser/mod.rs::parse_relationships_multi_token_from_alias_rejected — near miss of C-002: a dotted from-alias `o.c(...)` is rejected [syntax]
statement error
CREATE SEMANTIC VIEW dcc_c006 AS TABLES (o AS dcc_orders PRIMARY KEY (id), c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)) RELATIONSHIPS (rel AS o.c(cust_id) REFERENCES c(id)) DIMENSIONS (o.region AS o.region);
----

# C-007: body_parser/mod.rs::parse_relationships_junk_before_references_rejected — near miss of C-002: junk between the FK list and REFERENCES is rejected, not skipped [syntax]
statement error
CREATE SEMANTIC VIEW dcc_c007 AS TABLES (o AS dcc_orders PRIMARY KEY (id), c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)) RELATIONSHIPS (rel AS o(cust_id) junk REFERENCES c(id)) DIMENSIONS (o.region AS o.region);
----

