----
NON ADDITIVE BY clause not allowed on derived metric 'profit'

# C-073: body_parser/mod.rs::parse_metrics_non_additive_by_with_using — USING (rel1) followed by NON ADDITIVE BY (d1 DESC) on one metric
statement ok
CREATE SEMANTIC VIEW dcc_c073 AS TABLES (a AS dcc_accounts PRIMARY KEY (id), d AS dcc_customers PRIMARY KEY (id)) RELATIONSHIPS (rel1 AS a(account_id) REFERENCES d) DIMENSIONS (a.d1 AS a.date) METRICS (a.bal USING (rel1) NON ADDITIVE BY (d1 DESC) AS SUM(a.amount));

query T nosort
SELECT * FROM dcc_ddl('dcc_c073');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c073 AS
TABLES (
    a AS dcc_accounts PRIMARY KEY (id),
    d AS dcc_customers PRIMARY KEY (id)
)
RELATIONSHIPS (
    rel1 AS a(account_id) REFERENCES d
)
DIMENSIONS (
    a.d1 AS a.date
)
METRICS (
    a.bal USING (rel1) NON ADDITIVE BY (d1 DESC NULLS FIRST) AS SUM(a.amount)
)

query TTTT rowsort
