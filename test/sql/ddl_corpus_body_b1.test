require semantic_views

# DDL accept/reject corpus, slice C, part b1 of 2 (ddl_corpus_body_b2.test is the
# other part). Ports, as SQL-level rows against the real extension, the cases
# encoded by these Rust unit tests, which go away with the hand-written scanners
# in Phase 3 of the PEG parser epic (.planning/PEG-PARSER-EPIC.md):
#
#   src/body_parser/mod.rs         mod tests, from `references_multi_column_list`
#                                  to the end of the file
#   src/body_parser/annotations.rs src/body_parser/clause_bounds.rs
#   src/body_parser/cursor.rs      src/body_parser/lexer.rs
#   src/body_parser/window.rs
#
# Case map (Rust test -> row id): _notes/phase3-corpus/map-C.md
#
# Conventions: `# C-NNN:` names each row and the Rust test(s) it ports.
# Accept rows pin the stored definition through GET_DDL (dcc_ddl) and, where
# GET_DDL does not show a parsed field, DESCRIBE / SHOW / YAML. Reject rows are
# near misses of an accepted statement earlier in this file; [syntax] rejects do
# not pin wording (it will change under the grammar): their `----` block is
# left EMPTY, which this runner accepts as "any error" (it refuses a
# `statement error` with no `----` at all). Semantic rejects pin a stable
# message substring. [text] marks today's text-preservation / identifier-
# quoting contract that a grammar might plausibly change.

# --- fixtures ---

statement ok
CREATE TABLE dcc_orders (id INTEGER, region VARCHAR, amount INTEGER, cost INTEGER, cust_id INTEGER, created_at DATE, qty INTEGER, price DOUBLE, discount DOUBLE, tax_rate DOUBLE, email VARCHAR, first_name VARCHAR, last_name VARCHAR, comment_count INTEGER, o_id INTEGER, o_seq INTEGER, o_cust_id INTEGER, store INTEGER, sale_date DATE, code INTEGER, c2 INTEGER, labels VARCHAR);

statement ok
CREATE TABLE dcc_customers (id INTEGER, c_id INTEGER, name VARCHAR, code INTEGER, c2 INTEGER);

statement ok
CREATE TABLE dcc_fact (id INTEGER, email VARCHAR, x INTEGER);

statement ok
CREATE TABLE dcc_flights (id INTEGER, dep_id INTEGER, arr_id INTEGER, x INTEGER);

statement ok
CREATE TABLE dcc_airports (id INTEGER, name VARCHAR);

statement ok
CREATE TABLE dcc_accounts (id INTEGER, date DATE, account_id INTEGER, amount INTEGER);

statement ok
CREATE TABLE dcc_line_items (id INTEGER, amount INTEGER, unit_cost INTEGER);

statement ok
CREATE TABLE dcc_priv (id INTEGER, value INTEGER);

statement ok
CREATE TABLE "dcc my orders" (id INTEGER, region VARCHAR);

statement ok
CREATE TABLE "dcc PRIMARY KEY (id)" (id INTEGER, "UNIQUE" INTEGER, "x)y" INTEGER, region VARCHAR);

statement ok
CREATE SCHEMA "dcc a""b";

statement ok
CREATE TABLE "dcc a""b"."c d" (id INTEGER, "x)y" INTEGER, region VARCHAR);

statement ok
CREATE TABLE "dcc 東京 table" (id INTEGER, region VARCHAR);

statement ok
CREATE MACRO dcc_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

# Structured view of the stored model (window_spec etc.), for fields GET_DDL
# only shows re-rendered.

statement ok
CREATE MACRO dcc_yaml(v) AS TABLE SELECT unnest(string_split(rtrim(read_yaml_from_semantic_view(v), chr(10)), chr(10))) AS line;

# --- RELATIONSHIPS: REFERENCES target column lists ---

# C-001: body_parser/mod.rs::references_multi_column_list — a multi-column FK list REFERENCES a multi-column target list; both lists kept in order
statement ok
CREATE SEMANTIC VIEW dcc_c001 AS TABLES (o AS dcc_orders PRIMARY KEY (id), c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)) RELATIONSHIPS (rel AS o(code, c2) REFERENCES c(code, c2)) DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcc_ddl('dcc_c001');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c001 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id),
    c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)
)
RELATIONSHIPS (
    rel AS o(code, c2) REFERENCES c(code, c2)
)
DIMENSIONS (
    o.region AS o.region
)

query TTTT rowsort
SELECT object_kind, object_name, property, property_value FROM describe_semantic_view('dcc_c001') WHERE object_kind = 'RELATIONSHIP';
----
RELATIONSHIP	rel	FOREIGN_KEY	["code","c2"]
RELATIONSHIP	rel	REF_KEY	["code","c2"]
RELATIONSHIP	rel	REF_TABLE	dcc_customers
RELATIONSHIP	rel	TABLE	dcc_orders

# C-002: body_parser/mod.rs::references_target_no_space_before_paren — `REFERENCES c(id)` (no space before the paren): target c, ref columns [id]
# GET_DDL omits a ref column list equal to the target PK; DESCRIBE REF_KEY shows it.
statement ok
CREATE SEMANTIC VIEW dcc_c002 AS TABLES (o AS dcc_orders PRIMARY KEY (id), c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)) RELATIONSHIPS (rel AS o(cust_id) REFERENCES c(id)) DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcc_ddl('dcc_c002');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c002 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id),
    c AS dcc_customers PRIMARY KEY (id) UNIQUE (code, c2)
)
RELATIONSHIPS (
    rel AS o(cust_id) REFERENCES c
)
DIMENSIONS (
    o.region AS o.region
)

query TTTT rowsort
SELECT object_kind, object_name, property, property_value FROM describe_semantic_view('dcc_c002') WHERE object_kind = 'RELATIONSHIP' AND property IN ('REF_TABLE', 'REF_KEY');
----
RELATIONSHIP	rel	REF_KEY	["id"]
RELATIONSHIP	rel	REF_TABLE	dcc_customers

