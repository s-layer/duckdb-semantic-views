# DDL accept/reject corpus — non-CREATE statements, part A (Phase 3 of the PEG epic).
#
# Ports the DROP / ALTER / DESCRIBE / SHOW / SHOW COLUMNS cases, statement
# prefixes and word boundaries, view-name handling and comments around names
# from the `#[test]`s in `src/parse/rewrite.rs` (`mod tests`). Part B
# (`ddl_corpus_statements_b.test`) holds the SHOW filter-clause, name-slot and
# scope cases; the CREATE-side cases from the same module live in
# `ddl_corpus_create_forms.test`.
#
# Every row carries an id `S-NNN`; the case map from Rust test to row id is
# `_notes/phase3-corpus/map-S.md`. Row tags:
#   [syntax]  a syntactic reject: no message is pinned (it will change under
#             the grammar), only that the statement fails. The runner insists
#             on a `----` line after `statement error`; an empty block after it
#             accepts any error message.
#   [text]    today's contract on something a grammar might plausibly change
#             (case folding, quoting, whitespace).
#
# DROP and ALTER are asserted through the catalog state after them (the runner
# reads a DDL statement's own result as a changed-row count). SHOW SEMANTIC
# VIEWS leads with a live `created_on` timestamp, matched by a <REGEX> value;
# its rows come back sorted by schema then name, so those queries are `nosort`.

require semantic_views

# --- fixtures ---

statement ok
CREATE TABLE dcs_orders (id INTEGER, region VARCHAR, cust VARCHAR, amount INTEGER);

statement ok
INSERT INTO dcs_orders VALUES (1, 'east', 'ann', 10), (2, 'west', 'bob', 20), (3, 'east', 'cat', 30);

statement ok
CREATE SCHEMA dcs_sch;

statement ok
CREATE TABLE dcs_sch.dcs_orders (id INTEGER, region VARCHAR, cust VARCHAR, amount INTEGER);

statement ok
CREATE MACRO dcs_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

# Catalog state: every semantic view, with its schema and comment.
statement ok
CREATE MACRO dcs_views() AS TABLE SELECT schema_name, name, comment FROM list_semantic_views();

# --- statements that are not semantic-view DDL pass through untouched ---

# S-001: rewrite.rs::sv_parse_function_rust_returns_2_for_select, test_detect_non_matching, test_ddl_kind_none, test_rewrite_not_semantic, test_validate_and_rewrite_not_ours, test_near_miss_select, test_non_matching — a plain SELECT is not intercepted
query I
SELECT 1;
----
1

