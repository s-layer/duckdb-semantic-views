# --- prefix keywords need a trailing word boundary ---

# The plural typo `DROP SEMANTIC VIEWS x` used to match the `DROP SEMANTIC VIEW`
# prefix and drop a view named `s`. Both `s` and `x` exist for these rows, so
# the catalog check after them shows nothing was dropped.

statement ok
CREATE SEMANTIC VIEW s AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

statement ok
CREATE SEMANTIC VIEW x AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

