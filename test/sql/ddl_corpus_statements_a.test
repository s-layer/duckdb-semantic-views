# --- qualified and quoted view names on DROP / DESCRIBE / SHOW COLUMNS / ALTER ---

# Two views named `v`: one in `main`, one in `dcs_sch`. A qualified name has to
# pick the right one, so the catalog checks below tell a kept qualifier from a
# discarded one.

statement ok
CREATE SEMANTIC VIEW memory.dcs_sch.v AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.cust AS o.cust) METRICS (o.n AS COUNT(*))

query TTT nosort
SELECT * FROM dcs_views();
----
dcs_sch	v	(empty)
main	v	(empty)

# S-120: rewrite.rs::phase64_quoted_ident_tests::describe_with_quoted_fqn — DESCRIBE with a quoted three-part name reads that schema's view
