DESCRIBE SEMANTIC VIEW "memory"."dcs_sch"."v"
----
TABLE	dcs_orders	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	dcs_orders	(empty)	BASE_TABLE_SCHEMA_NAME	dcs_sch
TABLE	dcs_orders	(empty)	BASE_TABLE_NAME	dcs_orders
TABLE	dcs_orders	(empty)	PRIMARY_KEY	["id"]
DIMENSION	cust	dcs_orders	TABLE	dcs_orders
DIMENSION	cust	dcs_orders	EXPRESSION	o.cust
DIMENSION	cust	dcs_orders	DATA_TYPE	VARCHAR
METRIC	n	dcs_orders	TABLE	dcs_orders
METRIC	n	dcs_orders	EXPRESSION	COUNT(*)
METRIC	n	dcs_orders	DATA_TYPE	BIGINT
METRIC	n	dcs_orders	ACCESS_MODIFIER	PUBLIC

