# Pre-aggregation `where_clause` — Snowflake's SEMANTIC_VIEW( … WHERE … ).
#
# The predicate filters the rows that feed the metrics, BEFORE they are
# aggregated. That is what makes it inexpressible as an outer WHERE: by then the
# aggregation has already run over every row, and the members the predicate
# names are not in the output.
#
# Named `where_clause` because DuckDB reserves `where` in named-parameter
# position -- `where := '…'` is a parse error before the binder sees it.

require semantic_views

statement ok
CREATE TABLE wc_customers (id INTEGER, region VARCHAR);

statement ok
CREATE TABLE wc_orders (id INTEGER, customer_id INTEGER, amount DECIMAL(10,2), ordered_at DATE);

statement ok
INSERT INTO wc_customers VALUES (1, 'EU'), (2, 'US');

statement ok
INSERT INTO wc_orders VALUES
  (10, 1, 100.00, DATE '2024-01-15'),
  (11, 1,  50.00, DATE '2023-06-01'),
  (12, 2,  70.00, DATE '2024-03-02');

statement ok
CREATE SEMANTIC VIEW wc_sv AS
  TABLES (
    o AS wc_orders PRIMARY KEY (id),
    c AS wc_customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    order_customer AS o(customer_id) REFERENCES c
  )
  FACTS (
    o.amt AS o.amount,
    o.odate AS o.ordered_at
  )
  DIMENSIONS (
    c.region AS c.region
  )
  METRICS (
    o.revenue AS sum(o.amount)
  );

# ============================================================
# Test 1: the baseline, no predicate. EU = 100 + 50.
# ============================================================

query TT rowsort
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region']);
----
EU	150.00
US	70.00

# ============================================================
# Test 2: the point of the feature. Filtering on `odate` -- a fact that is NOT
# in the output -- RECOMPUTES EU's revenue over the matching rows (100.00), it
# does not merely drop result rows. An outer WHERE could not express this: it
# has no `odate` column to filter on, and EU's 150.00 would already be summed.
# ============================================================

query TT rowsort
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region'], where_clause := 'odate >= DATE ''2024-01-01''');
----
EU	100.00
US	70.00

# ============================================================
# Test 3: the predicate is emitted between the joins and the GROUP BY, with the
# member name resolved to its declared expression.
# ============================================================

query T
SELECT plan FROM (
  SELECT unnest(string_split(explain_output, chr(10))) AS plan
  FROM (SELECT * FROM explain_semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region'], where_clause := 'odate >= DATE ''2024-01-01'''))
    AS t(explain_output)
) WHERE plan LIKE 'WHERE %';
----
WHERE (o.ordered_at) >= DATE '2024-01-01'

# ============================================================
# Test 4: a dimension predicate filters before aggregation too.
# ============================================================

query TT rowsort
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region'], where_clause := 'region = ''EU''');
----
EU	150.00

# ============================================================
# Test 5: Snowflake's rule -- the predicate may reference dimensions and facts,
# never a metric. It runs before aggregation, so an aggregate has no value yet.
# ============================================================

statement error
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], where_clause := 'revenue > 5');
----
where_clause cannot reference the metric 'revenue'

# ============================================================
# Test 6: a fact query takes a plain WHERE -- nothing is aggregated, so there is
# no "before" to be careful about.
# ============================================================

query TT rowsort
SELECT * FROM semantic_view('wc_sv', facts := ['amt'], dimensions := ['region'], where_clause := 'amt > 60');
----
EU	100.00
US	70.00

# ============================================================
# Test 7: an empty predicate is treated as absent rather than spliced in as an
# empty WHERE.
# ============================================================

query TT rowsort
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region'], where_clause := '');
----
EU	150.00
US	70.00

# ============================================================
# Test 8: a member name inside a string literal is data, not a reference -- the
# splice is quote-aware, so this compares region against the text 'region'.
# ============================================================

query TT rowsort
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region'], where_clause := 'region = ''region''');
----

# ============================================================
# Test 9: MULTI-GRAIN. `revenue` (orders) and `item_count` (line_items) are at
# different grains, so this routes to the per-grain strategy: one CTE per grain,
# combined FULL OUTER. The predicate must be injected into EACH grain CTE.
#
# Unfiltered: EU has 2 orders (150.00) with 3 line items; US 1 order (70.00)
# with 1 item. Filtering to 2024 drops EU's 2023 order and its single item, so
# BOTH metrics are recomputed -- 100.00 and 2. An outer WHERE could do neither.
# ============================================================

statement ok
CREATE TABLE wc_items (id INTEGER, order_id INTEGER, qty INTEGER);

statement ok
INSERT INTO wc_items VALUES (100, 10, 2), (101, 10, 1), (102, 11, 1), (103, 12, 1);

statement ok
CREATE SEMANTIC VIEW wc_mg AS
  TABLES (
    o AS wc_orders PRIMARY KEY (id),
    c AS wc_customers PRIMARY KEY (id),
    li AS wc_items PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    order_customer AS o(customer_id) REFERENCES c,
    item_order AS li(order_id) REFERENCES o
  )
  FACTS (
    o.odate AS o.ordered_at
  )
  DIMENSIONS (
    c.region AS c.region
  )
  METRICS (
    o.revenue AS sum(o.amount),
    li.item_count AS count(li.id)
  );

query TTT rowsort
SELECT * FROM semantic_view('wc_mg', metrics := ['revenue', 'item_count'], dimensions := ['region']);
----
EU	150.00	3
US	70.00	1

query TTT rowsort
SELECT * FROM semantic_view('wc_mg', metrics := ['revenue', 'item_count'], dimensions := ['region'], where_clause := 'odate >= DATE ''2024-01-01''');
----
EU	100.00	2
US	70.00	1

# The predicate appears once per grain CTE -- never on the outer query.
query T
SELECT count(*) FROM (
  SELECT unnest(string_split(explain_output, chr(10))) AS plan
  FROM (SELECT * FROM explain_semantic_view('wc_mg', metrics := ['revenue', 'item_count'], dimensions := ['region'], where_clause := 'odate >= DATE ''2024-01-01'''))
    AS t(explain_output)
) WHERE trim(plan) LIKE 'WHERE (o.ordered_at)%';
----
2

statement ok
DROP SEMANTIC VIEW wc_mg;

statement ok
DROP TABLE wc_items;

# ============================================================
# A subquery is its own scope: Snowflake's WHERE takes uncorrelated
# subqueries, and a name inside one is the subquery's column, not a member.
# `amt` is both a fact (o.amount) and a column of wc_targets. Substituting the
# member inside the subquery made it `SELECT (o.amount) FROM wc_targets`, which
# matches every order: EU came out 150.00 instead of 100.00.
# ============================================================

statement ok
CREATE TABLE wc_targets (amt DECIMAL(10,2));

statement ok
INSERT INTO wc_targets VALUES (100.00), (70.00);

query TT rowsort
SELECT * FROM semantic_view('wc_sv', metrics := ['revenue'], dimensions := ['region'], where_clause := 'amt IN (SELECT amt FROM wc_targets)');
----
EU	100.00
US	70.00

statement ok
DROP TABLE wc_targets;

# A name inside the subquery that its own tables lack is not a member either:
# DuckDB looks it up in the semantic view's tables, where it is the raw column.
# Here `region` is lower(c.region), but the subquery compares c.region as
# stored ('EU'), so nothing matches (TECH-DEBT #109). Pinned so a change shows
# up here.

statement ok
CREATE TABLE wc_codes (code VARCHAR);

statement ok
INSERT INTO wc_codes VALUES ('eu');

statement ok
CREATE SEMANTIC VIEW wc_lower AS
  TABLES (o AS wc_orders PRIMARY KEY (id), c AS wc_customers PRIMARY KEY (id))
  RELATIONSHIPS (order_customer AS o(customer_id) REFERENCES c)
  DIMENSIONS (c.region AS lower(c.region))
  METRICS (o.revenue AS sum(o.amount));

query TT rowsort
SELECT * FROM semantic_view('wc_lower', metrics := ['revenue'], dimensions := ['region'], where_clause := 'EXISTS (SELECT 1 FROM wc_codes k WHERE k.code = region)');
----

query TT rowsort
SELECT * FROM semantic_view('wc_lower', metrics := ['revenue'], dimensions := ['region'], where_clause := 'region IN (SELECT code FROM wc_codes)');
----
eu	150.00

statement ok
DROP SEMANTIC VIEW wc_lower;

statement ok
DROP TABLE wc_codes;

# ============================================================
# Cleanup
# ============================================================

statement ok
DROP SEMANTIC VIEW wc_sv;

statement ok
DROP TABLE wc_orders;

statement ok
DROP TABLE wc_customers;
