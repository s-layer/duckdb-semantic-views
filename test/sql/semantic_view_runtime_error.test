# An error in the expanded SQL is DuckDB's own error, pointing at the call.
#
# `semantic_view()` hands DuckDB its expanded SQL to plan as part of the
# caller's query (`sv_semantic_view_bind_replace`, cpp/src/shim.cpp), so a
# failure in it, at bind or at execution, is reported as any failure in the
# query is: DuckDB's own error, with no wrapper around it. The caret goes on the
# `semantic_view(...)` call, since the expansion is text the user never wrote:
# `sv_relocate` moves every position in it to the call's.
#
# The two shapes: a metric over a column that no longer exists fails at bind; a
# cast that fails only on actual row data binds cleanly and fails at execution.

require semantic_views

statement ok
CREATE TABLE sve_rows (id INTEGER, txt VARCHAR);

statement ok
INSERT INTO sve_rows VALUES (1, '10'), (2, 'not a number');

statement ok
CREATE SEMANTIC VIEW sve_view AS
  TABLES (e AS sve_rows PRIMARY KEY (id))
  DIMENSIONS (e.id AS e.id)
  METRICS (
    e.bad AS sum(CAST(e.txt AS INTEGER)),
    e.gone AS sum(e.no_such_column)
  );

# Fails at execution: DuckDB's conversion error, unwrapped.
statement error
SELECT * FROM semantic_view('sve_view', metrics := ['e.bad']);
----
Conversion Error: Could not convert string 'not a number'

# The caret spans the call (47 characters), not an offset into the expansion.
statement error
SELECT * FROM semantic_view('sve_view', metrics := ['e.bad']);
----
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

# A metric over the rows that DO convert still works, so the view itself is
# sound and the error above is the data's, not the definition's.
query I
SELECT bad FROM semantic_view('sve_view', metrics := ['e.bad'], where_clause := 'id = 1');
----
10

# Fails at bind: DuckDB's binder error, with the caret on the construct (37
# characters, the construct and the statement's `;`).
statement error
SELECT * FROM SEMANTIC_VIEW(sve_view METRICS gone);
----
Table "e" does not have a column named "no_such_column"

statement error
SELECT * FROM SEMANTIC_VIEW(sve_view METRICS gone);
----
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

# Fails to parse: where_clause is spliced into the expansion, so a predicate
# that does not parse makes the expansion not parse. The error names
# where_clause, and the caret goes on the call (here cut, with the line, where
# DuckDB cuts a long one), not on an offset into the expansion.
statement error
SELECT * FROM semantic_view('sve_view', metrics := ['bad'], where_clause := 'id =');
----
the query does not parse, so check where_clause: syntax error

statement error
SELECT * FROM semantic_view('sve_view', metrics := ['bad'], where_clause := 'id =');
----
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

statement ok
DROP SEMANTIC VIEW sve_view;

statement ok
DROP TABLE sve_rows;
