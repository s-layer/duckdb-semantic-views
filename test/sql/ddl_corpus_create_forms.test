TABLE	dcs_orders	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	dcs_orders	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	dcs_orders	(empty)	BASE_TABLE_NAME	dcs_orders
TABLE	dcs_orders	(empty)	PRIMARY_KEY	["id"]
TABLE	dcs_customers	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	dcs_customers	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	dcs_customers	(empty)	BASE_TABLE_NAME	dcs_customers
TABLE	dcs_customers	(empty)	PRIMARY_KEY	["cust_id"]
RELATIONSHIP	r	dcs_orders	TABLE	dcs_orders
RELATIONSHIP	r	dcs_orders	REF_TABLE	dcs_customers
RELATIONSHIP	r	dcs_orders	FOREIGN_KEY	["customer_id"]
RELATIONSHIP	r	dcs_orders	REF_KEY	["cust_id"]
DIMENSION	region	dcs_orders	TABLE	dcs_orders
DIMENSION	region	dcs_orders	EXPRESSION	region
DIMENSION	region	dcs_orders	DATA_TYPE	VARCHAR
METRIC	revenue	dcs_orders	TABLE	dcs_orders
METRIC	revenue	dcs_orders	EXPRESSION	SUM(amount)
