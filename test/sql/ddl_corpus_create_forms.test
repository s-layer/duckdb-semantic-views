# S-343: rewrite.rs::test_create_or_replace_from_yaml, test_yaml_rewrite_create_or_replace — CREATE OR REPLACE ... FROM YAML replaces
statement ok
CREATE OR REPLACE SEMANTIC VIEW yaml_test FROM YAML $$
tables:
  - alias: o
    table: dcs_orders
    pk_columns: [id]
dimensions:
