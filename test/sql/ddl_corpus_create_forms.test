# DDL accept/reject corpus — CREATE forms (Phase 3 of the PEG epic).
#
# Ports the CREATE-side cases from the `#[test]`s in `src/parse/rewrite.rs`
# (`mod tests`): CREATE / OR REPLACE / IF NOT EXISTS modes, the CREATE front
# door (misspelt prefixes, missing name or body), view-level COMMENT, view-name
# capture, `FROM YAML` inline with dollar quoting, `FROM YAML FILE`, and the
# relationship enrichment that runs at CREATE. The non-CREATE cases from the same
# module live in `ddl_corpus_statements_a.test` / `ddl_corpus_statements_b.test`.
#
# Every row carries an id `S-NNN`; the case map from Rust test to row id is
# `_notes/phase3-corpus/map-S.md`. Row tags:
#   [syntax]  a syntactic reject: no message is pinned (it will change under
#             the grammar), only that the statement fails. The runner insists
#             on a `----` line after `statement error`; an empty block after it
#             accepts any error message.
#   [text]    today's contract on something a grammar might plausibly change
#             (comments inside expressions, case folding, quoting).
#
# The `FROM YAML FILE` rows write their YAML fixtures to
# `__TEST_DIR__/ddl_corpus_s_*.yaml` with COPY.

require semantic_views

# --- fixtures ---

statement ok
CREATE TABLE dcs_orders (id INTEGER, region VARCHAR, amount INTEGER, customer_id INTEGER, email VARCHAR);

statement ok
INSERT INTO dcs_orders VALUES (1, 'east', 10, 1, 'ann@x'), (2, 'west', 20, 1, 'bob@x'), (3, 'east', 30, 2, 'cat@x');

statement ok
CREATE TABLE dcs_customers (cust_id INTEGER, name VARCHAR, email VARCHAR, a INTEGER, b INTEGER);

statement ok
INSERT INTO dcs_customers VALUES (1, 'ann', 'ann@x', 1, 1), (2, 'bob', 'bob@x', 2, 2), (3, 'cat', 'cat@x', 3, 3);

statement ok
CREATE SCHEMA dcs_sch;

statement ok
CREATE MACRO dcs_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

# Catalog state: every semantic view, with its schema and comment.
statement ok
CREATE MACRO dcs_views() AS TABLE SELECT schema_name, name, comment FROM list_semantic_views();

# --- CREATE / CREATE OR REPLACE / CREATE IF NOT EXISTS ---

# S-300: rewrite.rs::phase25_parse_tests::as_body_create_rewrites_to_from_json, test_detect_create, test_ddl_kind_create, phase43_view_comment_tests::test_view_without_comment — plain CREATE stores the AS-body; no COMMENT is stored when none is given
statement ok
CREATE SEMANTIC VIEW v AS TABLES (t AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (t.r AS t.region) METRICS (t.m AS SUM(1))

query T nosort
SELECT * FROM dcs_ddl('v');
----
CREATE OR REPLACE SEMANTIC VIEW v AS
TABLES (
    t AS dcs_orders PRIMARY KEY (id)
)
DIMENSIONS (
    t.r AS t.region
)
METRICS (
    t.m AS SUM(1)
)

# S-301: rewrite.rs::phase25_parse_tests::as_body_create_rewrites_to_from_json — plain CREATE is not OR REPLACE: a second CREATE of the same name fails and leaves the first
statement error
CREATE SEMANTIC VIEW v AS TABLES (t AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (t.r2 AS t.region) METRICS (t.m2 AS SUM(2))
----
semantic view 'v' already exists

query T nosort
SELECT * FROM dcs_ddl('v') WHERE line LIKE '%t.r%' OR line LIKE '%t.m%';
----
    t.r AS t.region
    t.m AS SUM(1)

