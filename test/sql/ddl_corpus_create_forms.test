# --- FROM YAML with a dollar-quoted body ---

# S-340: rewrite.rs::test_from_yaml_detection_via_rewrite_ddl, test_yaml_rewrite_basic_create, test_validate_and_rewrite_yaml_inline_still_works, test_extract_dollar_quoted_untagged, test_extract_dollar_quoted_multiline — CREATE ... FROM YAML $$ <multi-line YAML> $$
statement ok
CREATE SEMANTIC VIEW yaml_test FROM YAML $$
base_table: dcs_orders
tables:
  - alias: o
    table: dcs_orders
    pk_columns:
      - id
dimensions:
  - name: region
    expr: o.region
    source_table: o
metrics:
  - name: total_amount
    expr: SUM(o.amount)
    source_table: o
$$

query T nosort
SELECT * FROM dcs_ddl('yaml_test');
----
CREATE OR REPLACE SEMANTIC VIEW yaml_test AS
TABLES (
    o AS dcs_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.region AS o.region
)
METRICS (
    o.total_amount AS SUM(o.amount)
)

