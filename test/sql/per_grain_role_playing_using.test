# USING names which role a grain CTE joins
# (TECH-DEBT #36, role-playing sub-item, second half).
#
# `rpu_flights` reaches `rpu_airports` through TWO named relationships, dep and
# arr. A dimension on `rpu_airports` is therefore ambiguous on its own — which
# of the two does `a.city` mean? — and per-grain declined the whole query.
#
# A co-queried metric's `USING (dep)` answers exactly that, and the base-anchored
# path has always honoured it (emitting `a__dep.city` and joining
# `"airports" AS "a__dep" ON "f"."dep_code" = "a__dep"."code"`). The grain CTEs
# now reproduce that shape, choosing the NAMED edge rather than whichever the
# relationship list happens to declare first.
#
# The data is built so that dep and arr give DIFFERENT answers: a regression that
# silently bound the other role would change the numbers, not just the alias.

require semantic_views

statement ok
CREATE TABLE rpu_airports (code VARCHAR, city VARCHAR);

statement ok
CREATE TABLE rpu_flights (id INTEGER, dep_code VARCHAR, arr_code VARCHAR);

statement ok
CREATE TABLE rpu_legs (id INTEGER, flight_id INTEGER);

statement ok
INSERT INTO rpu_airports VALUES ('LHR', 'London'), ('JFK', 'New York'), ('CDG', 'Paris');

# f10 LHR->JFK, f11 LHR->CDG, f12 JFK->LHR.
#
# By DEPARTURE city:  London 2 flights, New York 1.
# By ARRIVAL city:    New York 1, Paris 1, London 1.
#
# So London = 2 is only reachable by binding `dep`; binding `arr` would give
# London = 1 and add a Paris row.
statement ok
INSERT INTO rpu_flights VALUES (10, 'LHR', 'JFK'), (11, 'LHR', 'CDG'), (12, 'JFK', 'LHR');

# Legs hang off flights, so `l` is a CHILD grain and `a` sits ABOVE both.
statement ok
INSERT INTO rpu_legs VALUES (1, 10), (2, 10), (3, 11), (4, 12);

statement ok
CREATE SEMANTIC VIEW rpu_sv AS
  TABLES (
    f AS rpu_flights PRIMARY KEY (id),
    a AS rpu_airports PRIMARY KEY (code),
    l AS rpu_legs PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    dep AS f(dep_code) REFERENCES a(code),
    arr AS f(arr_code) REFERENCES a(code),
    l_to_f AS l(flight_id) REFERENCES f(id)
  )
  DIMENSIONS (
    a.dep_city AS a.city
  )
  METRICS (
    f.flight_count USING (dep) AS count(*),
    f.arrival_count USING (arr) AS count(*),
    l.leg_count AS count(l.id)
  );

# ============================================================
# Test 1: every metric names its own path (Phase 6.3, Snowflake parity).
# `leg_count` cannot: a USING relationship has to start at the metric's own
# table, and `legs` has no relationship to `airports`. It used to borrow
# `flight_count`'s role, so its numbers changed with what it was queried
# beside; it is refused instead, as Snowflake refuses it.
# ============================================================

statement error
SELECT * FROM SEMANTIC_VIEW(rpu_sv DIMENSIONS dep_city METRICS flight_count, leg_count);
----
dimension 'dep_city' is ambiguous

# ============================================================
# Test 2: two groups, each joining the role its metric names. London departs
# 2 flights and receives 1; New York departs 1 and receives 1; Paris only
# receives 1. Binding one role for both would make the columns equal.
# ============================================================

query TII rowsort
SELECT * FROM SEMANTIC_VIEW(rpu_sv DIMENSIONS dep_city METRICS flight_count, arrival_count);
----
London	2	1
New York	1	1
Paris	NULL	1

# The scoped aliases reach the emitted SQL, each joined once, on its own edge.
query I
SELECT count(*) FROM (
  SELECT unnest(string_split(explain_output, chr(10))) AS plan
  FROM (SELECT * FROM explain_semantic_view('rpu_sv', metrics := ['flight_count', 'arrival_count'], dimensions := ['dep_city']))
    AS t(explain_output)
) WHERE plan LIKE '%AS "a__dep" ON%dep_code%';
----
1

query I
SELECT count(*) FROM (
  SELECT unnest(string_split(explain_output, chr(10))) AS plan
  FROM (SELECT * FROM explain_semantic_view('rpu_sv', metrics := ['flight_count', 'arrival_count'], dimensions := ['dep_city']))
    AS t(explain_output)
) WHERE plan LIKE '%AS "a__arr" ON%arr_code%';
----
1

# ============================================================
# Test 3: a REGRESSION GUARD, not a new capability. `flight_count` alone sits at
# the base grain, so per-grain never engages and the base-anchored path answers
# it exactly as it always did. It is here to pin that the widened routing does
# not hijack such a query and change its numbers — confirmed by reverting the
# eligibility relaxation and watching it still pass. Its independently-reporting
# twin is the unit test
# `single_grain_role_played_dimension_stays_on_the_base_anchored_path`.
# ============================================================

query TI rowsort
SELECT * FROM SEMANTIC_VIEW(rpu_sv DIMENSIONS dep_city METRICS flight_count);
----
London	2
New York	1

# ============================================================
# Test 4: the SINGLE-grain CTE must scope its dimension too.
#
# One grain group takes a different renderer from the multi-grain case, but it
# emits its joins through the same code — so it receives the scoped `a__dep`
# JOIN and must rewrite the dimension to match. Emitting the bare `a.city`
# against `FROM carriers ... LEFT JOIN airports AS "a__dep"` references an alias
# the FROM never binds, which DuckDB rejects at bind time. Only an end-to-end
# test catches that; a string assertion on the generated SQL cannot.
#
# `c` is a parent of the base table (so a metric on it needs per-grain
# treatment) and `a` is a parent of `c` (so the dimension is above the metric's
# grain and is permitted).
# ============================================================

statement ok
CREATE TABLE rpu_carriers (id INTEGER, fleet INTEGER, dep_code VARCHAR, arr_code VARCHAR);

statement ok
INSERT INTO rpu_carriers VALUES (1, 50, 'LHR', 'JFK'), (2, 30, 'JFK', 'LHR');

statement ok
ALTER TABLE rpu_flights ADD COLUMN carrier_id INTEGER;

statement ok
CREATE SEMANTIC VIEW rpu_sg AS
  TABLES (
    f AS rpu_flights PRIMARY KEY (id),
    c AS rpu_carriers PRIMARY KEY (id),
    a AS rpu_airports PRIMARY KEY (code)
  )
  RELATIONSHIPS (
    dep AS c(dep_code) REFERENCES a(code),
    arr AS c(arr_code) REFERENCES a(code),
    f_to_c AS f(carrier_id) REFERENCES c(id)
  )
  DIMENSIONS (
    a.hub_city AS a.city
  )
  METRICS (
    c.fleet_size USING (dep) AS sum(c.fleet)
  );

# Carrier 1 hubs at LHR (London) with 50; carrier 2 at JFK (New York) with 30.
# Binding `arr` instead would swap the two cities.
query TI rowsort
SELECT * FROM SEMANTIC_VIEW(rpu_sg DIMENSIONS hub_city METRICS fleet_size);
----
London	50
New York	30

statement ok
DROP SEMANTIC VIEW rpu_sg;

statement ok
DROP TABLE rpu_carriers;

# Cleanup
statement ok
DROP SEMANTIC VIEW rpu_sv;

statement ok
DROP TABLE rpu_legs;

statement ok
DROP TABLE rpu_flights;

statement ok
DROP TABLE rpu_airports;
