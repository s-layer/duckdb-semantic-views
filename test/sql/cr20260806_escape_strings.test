# Code review 2026-08-06, PARSE-7: no scanner in the crate understood DuckDB
# escape strings (`E'...'`), where `\'` is an escaped quote.
#
# Verified against DuckDB: `SELECT e'\''` returns a single quote character,
# and `SELECT E'\\'` returns one backslash. All four scanners
# (`util::QuoteState`, `util::blank_sql_comments`, `body_parser::lexer`,
# `expr_tokens::skip_single_quoted`) treated `\` as an ordinary byte, so the
# middle and closing quotes of `e'\''` were consumed as one `''` escape pair.
# The literal read as unterminated and everything after it stayed in "string"
# state -- loud as a rejected CREATE, silent as a mis-split entry list.
#
# The `E` must sit on a token boundary: `DATE'2020-01-01'` is a valid TYPED
# LITERAL whose `E` belongs to the type name and which follows the ORDINARY
# string rules. That case is a control here, not a repro.
#
# The runner halts a file at its first failing statement, so the per-case red
# proof lives at the unit layer (four scanner test groups in `util`,
# `body_parser::lexer`, `expr_tokens` and `body_parser`). This file covers the
# whole extension-load -> DDL -> query path.

require semantic_views

statement ok
CREATE TABLE quoted (id INTEGER PRIMARY KEY, s VARCHAR, amount INTEGER);

# Row 2 holds a literal apostrophe; row 3 holds a literal backslash.
statement ok
INSERT INTO quoted VALUES (1, 'plain', 10), (2, '''', 20), (3, '\', 30);

# The review's repro: a metric whose expression contains an escape string.
# Before the fix this CREATE failed with "Unterminated string literal in
# metric entry".
statement ok
CREATE SEMANTIC VIEW esc AS
  TABLES (q AS quoted PRIMARY KEY (id))
  DIMENSIONS (q.s AS q.s)
  METRICS (
    q.n_quote AS count_if(q.s = e'\''),
    q.n_backslash AS count_if(q.s = e'\\'),
    q.total AS SUM(q.amount)
  );

# One row holds an apostrophe, one holds a backslash, and the totals still add
# up -- so the entries after the escape strings were not swallowed.
query III
SELECT n_quote, n_backslash, total FROM SEMANTIC_VIEW(esc
    METRICS n_quote, n_backslash, total
);
----
1	1	60

# The silent half: a comma INSIDE an escape string must not split the entry
# list. Read as an unterminated literal, `e'a\',b'` swallowed the separator and
# collapsed two metrics into one garbage entry.
statement ok
CREATE SEMANTIC VIEW esc_comma AS
  TABLES (q AS quoted PRIMARY KEY (id))
  DIMENSIONS (q.s AS q.s)
  METRICS (
    q.lit AS count_if(q.s = e'a\',b'),
    q.total AS SUM(q.amount)
  );

# Both metrics survived as separate members, and the literal is the 4-character
# string `a',b` which no row matches.
query II
SELECT lit, total FROM SEMANTIC_VIEW(esc_comma METRICS lit, total);
----
0	60

# GET_DDL round-trips the escape string verbatim.
query T
SELECT GET_DDL('SEMANTIC_VIEW', 'esc') LIKE '%e''\''%'
----
true

# Control: a typed literal's `E` is part of the type name, so the ordinary
# string rules apply and the entry list still splits normally.
statement ok
CREATE TABLE dated (id INTEGER PRIMARY KEY, d DATE, amount INTEGER);

statement ok
INSERT INTO dated VALUES (1, DATE '2020-01-01', 5), (2, DATE '2021-06-30', 7);

statement ok
CREATE SEMANTIC VIEW typed AS
  TABLES (t AS dated PRIMARY KEY (id))
  DIMENSIONS (t.d AS t.d)
  METRICS (
    t.old AS count_if(t.d < DATE'2021-01-01'),
    t.total AS SUM(t.amount)
  );

query II
SELECT old, total FROM SEMANTIC_VIEW(typed METRICS old, total);
----
1	12

# Control: in an ORDINARY string a backslash is data, not an escape, so this
# literal ends at its own closing quote. (DuckDB: `SELECT '\'` is one
# backslash.)
statement ok
CREATE SEMANTIC VIEW plain_backslash AS
  TABLES (q AS quoted PRIMARY KEY (id))
  DIMENSIONS (q.s AS q.s)
  METRICS (
    q.n AS count_if(q.s = '\'),
    q.total AS SUM(q.amount)
  );

query II
SELECT n, total FROM SEMANTIC_VIEW(plain_backslash METRICS n, total);
----
1	60

statement ok
DROP SEMANTIC VIEW plain_backslash

statement ok
DROP SEMANTIC VIEW typed

statement ok
DROP SEMANTIC VIEW esc_comma

statement ok
DROP SEMANTIC VIEW esc
