# CREATE SEMANTIC VIEW through the grammar production.
#
# The extension adds CREATE SEMANTIC VIEW to DuckDB's own grammar as an
# alternative of `Statement`. The production rebuilds the statement's text from
# its tokens and plans the body from that text.

require semantic_views

statement ok
CREATE TABLE gc_t (id INTEGER, region VARCHAR, amount INTEGER);

statement ok
INSERT INTO gc_t VALUES (1, 'n', 10), (2, 's', 20), (3, 'n', 5);

# --- the forms -----------------------------------------------------------------

statement ok
CREATE SEMANTIC VIEW gc_a AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region) METRICS (t.total AS SUM(amount));

query TI rowsort
SELECT * FROM semantic_view('gc_a', dimensions := ['region'], metrics := ['total']);
----
n	15
s	20

statement error
CREATE SEMANTIC VIEW gc_a AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
already exists

statement ok
CREATE SEMANTIC VIEW IF NOT EXISTS gc_a AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

statement ok
CREATE OR REPLACE SEMANTIC VIEW gc_a COMMENT = 'replaced' AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

query T
SELECT comment FROM (SHOW SEMANTIC VIEWS) WHERE name = 'gc_a';
----
replaced

# A comment and line breaks inside the statement.
statement ok
CREATE SEMANTIC VIEW gc_b AS -- the body
TABLES (t AS gc_t PRIMARY KEY (id))
/* no metrics */ DIMENSIONS (t.region AS region);

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS) WHERE name = 'gc_b';
----
1

statement ok
CREATE SEMANTIC VIEW gc_y FROM YAML $$
base_table: gc_t
tables:
  - alias: t
    table: gc_t
    pk_columns:
      - id
dimensions:
  - name: region
    expr: t.region
    source_table: t
metrics: []
$$;

query T rowsort
SELECT region FROM semantic_view('gc_y', dimensions := ['region']);
----
n
s

# --- body errors ---------------------------------------------------------------

statement error
CREATE SEMANTIC VIEW gc_e AS TABLES gc_t;
----
Expected '(' after clause keyword 'TABLES'

statement error
CREATE SEMANTIC VIEW gc_e AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region) DIMENSIONS (t.id AS id);
----
Duplicate clause keyword 'DIMENSIONS'

# --- reserved words as names ---------------------------------------------------

# The name is a DuckDB `ColId`, as in DROP, ALTER, DESCRIBE and SHOW, and as in
# DuckDB's own DDL: a reserved word must be quoted, and so must a type or
# function-name keyword such as `left`.
statement error
CREATE SEMANTIC VIEW select AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
syntax error at or near "select"

statement error
CREATE SEMANTIC VIEW IF NOT EXISTS order AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
syntax error at or near "order"

statement error
CREATE SEMANTIC VIEW left AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);
----
syntax error at or near "left"

# A keyword DuckDB takes as a name needs no quotes.
statement ok
CREATE SEMANTIC VIEW if AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

statement ok
DROP SEMANTIC VIEW if;

statement ok
CREATE SEMANTIC VIEW "select" AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

statement ok
CREATE SEMANTIC VIEW "left" AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

# GET_DDL quotes both, so its output runs.
query T
SELECT get_ddl('SEMANTIC_VIEW', 'select') LIKE 'CREATE OR REPLACE SEMANTIC VIEW "select" AS%';
----
true

query T
SELECT get_ddl('SEMANTIC_VIEW', 'left') LIKE 'CREATE OR REPLACE SEMANTIC VIEW "left" AS%';
----
true

statement ok
DROP SEMANTIC VIEW "select";

statement ok
DROP SEMANTIC VIEW "left";

# The keywords `crate::ident::is_refused_as_name` lists come from these: all
# of them but `columns`, `generated`, `map`, `struct`, `try_cast` and `tuple`.
# An engine bump that changes them fails here: update KEYWORDS_REFUSED_AS_NAMES
# in src/ident.rs to match.
query T
SELECT string_agg(lower(keyword_name), ' ' ORDER BY lower(keyword_name)) FROM duckdb_keywords() WHERE keyword_category IN ('reserved', 'type_function');
----
all analyse analyze and anti any array as asc asof asymmetric at authorization binary both by case cast check collate collation column columns concurrently constraint create cross default deferrable desc describe distinct do else end except false fetch for foreign freeze from full generated glob group having ilike in initially inner intersect into is isnull join lambda lateral leading left like limit map natural not notnull null offset on only or order outer overlaps pivot pivot_longer pivot_wider placing positional primary qualify references returning right select semi show similar some struct summarize symmetric table tablesample then to trailing true try_cast tuple union unique unpack unpivot using variadic verbose when where window with

# --- DuckDB's own statements are not shadowed -----------------------------------

# The productions are prepended choices; a statement they do not match falls to
# DuckDB's own alternative, even on a table named `semantic`.
statement ok
CREATE TABLE semantic (view INTEGER);

query TT
SELECT column_name, column_type FROM (DESCRIBE semantic);
----
view	INTEGER

query TT
SELECT column_name, column_type FROM (SHOW semantic);
----
view	INTEGER

statement ok
CREATE OR REPLACE VIEW semantic_v AS SELECT 1 AS one;

statement ok
ALTER TABLE semantic RENAME TO semantic2;

statement ok
DROP VIEW semantic_v;

statement ok
DROP TABLE semantic2;

# --- inside a multi-statement string (TECH-DEBT #85) ---------------------------

# DuckDB's grammar splits a string holding several statements and runs each one.
statement ok
SELECT 1; CREATE SEMANTIC VIEW gc_m AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.region AS region); SELECT 2;

query T rowsort
SELECT region FROM semantic_view('gc_m', dimensions := ['region']);
----
n
s

# The body is planned from text rebuilt from the tokens, so a tab inside an
# expression becomes a space.
statement ok
SELECT 1; CREATE SEMANTIC VIEW gc_w AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.r AS upper(	t.region));

query T
SELECT contains(GET_DDL('SEMANTIC_VIEW', 'gc_w'), chr(9));
----
false

query T
SELECT contains(GET_DDL('SEMANTIC_VIEW', 'gc_w'), 'upper( t.region)');
----
true

# And an error shows the caret, on the statement's own line.
statement error
SELECT 1;
CREATE SEMANTIC VIEW gc_e AS TABLES gc_t;
----
LINE 2:

query I
SELECT count(*) FROM (SHOW SEMANTIC VIEWS) WHERE name LIKE 'gc_%';
----
5

# A metric entry with no name is refused whether or not a USING clause comes
# first (TECH-DEBT #59).
statement error
CREATE SEMANTIC VIEW gc_n AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.r AS t.region) METRICS (USING () AS COMMENT = '');
----
Missing metric name before 'AS'

statement error
CREATE SEMANTIC VIEW gc_n AS TABLES (t AS gc_t PRIMARY KEY (id)) DIMENSIONS (t.r AS t.region) METRICS (AS sum(t.amount));
----
Missing metric name before 'AS'

# A `$` inside an identifier continues it, as in DuckDB, so `price$usd$` is a
# column name, not the start of a dollar-quoted string.
statement ok
CREATE TABLE gc_d (id INTEGER, price$usd$ INTEGER);

statement ok
INSERT INTO gc_d VALUES (1, 10), (2, 32);

statement ok
CREATE SEMANTIC VIEW gc_dv AS TABLES (d AS gc_d PRIMARY KEY (id)) DIMENSIONS (d.p AS d.price$usd$) METRICS (d.total AS sum(d.price$usd$));

query I
SELECT total FROM semantic_view('gc_dv', metrics := ['total']);
----
42

query T
SELECT contains(GET_DDL('SEMANTIC_VIEW', 'gc_dv'), 'sum(d.price$usd$)');
----
true

# A fact whose name is part of that column name is not inlined into it.
statement ok
CREATE SEMANTIC VIEW gc_dp AS TABLES (d AS gc_d PRIMARY KEY (id)) FACTS (d.price AS d.id * 100) METRICS (d.total AS sum(d.price$usd$));

query I
SELECT total FROM semantic_view('gc_dp', metrics := ['total']);
----
42

statement ok
CREATE SEMANTIC VIEW gc_du AS TABLES (d AS gc_d PRIMARY KEY (id)) FACTS (d.usd AS d.id * 100) METRICS (d.total AS sum(d.price$usd$));

query I
SELECT total FROM semantic_view('gc_du', metrics := ['total']);
----
42

# An unquoted bracket is not part of a name: it is refused, not stored.
statement error
CREATE SEMANTIC VIEW gc_br AS TABLES (d AS gc_d PRIMARY KEY (id)) DIMENSIONS (d.(p) AS d.id) METRICS (d.total AS sum(d.id));
----
'(p)' holds an unquoted '('; quote the name

statement error
CREATE SEMANTIC VIEW gc_br AS TABLES (d AS gc_d PRIMARY KEY (id)) DIMENSIONS (d.p AS d.id) METRICS (d.(total) AS sum(d.id));
----
'(total)' holds an unquoted '('; quote the name

# Quoted, the same name is accepted.
statement ok
CREATE SEMANTIC VIEW gc_br AS TABLES (d AS gc_d PRIMARY KEY (id)) DIMENSIONS (d."(p)" AS d.id) METRICS (d.total AS sum(d.id));

statement ok
DROP SEMANTIC VIEW gc_br;
