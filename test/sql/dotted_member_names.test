# A quoted member name holding a dot (`"sales.w"`) is one identifier, distinct
# from the qualified reference `sales.w` (member `w` of table `sales`). Name
# matching used to fold both to the same key `sales.w`, so the expansion picked
# whichever member was registered last: a wrong number with no error. Each
# case below returned the other member's value before the fix.

require semantic_views

statement ok
CREATE TABLE dmn_s (id INTEGER PRIMARY KEY, region VARCHAR, qty INTEGER, price INTEGER);

statement ok
INSERT INTO dmn_s VALUES (1, 'a', 1, 10), (2, 'a', 2, 20);

# ========================================
# Metrics: the quoted name and the qualified name are two metrics.
# ========================================

statement ok
CREATE SEMANTIC VIEW dmn_metrics AS
TABLES (sales AS dmn_s PRIMARY KEY (id))
DIMENSIONS (sales.region AS sales.region)
METRICS (
    sales."sales.w" AS SUM(price),
    sales.w AS SUM(qty) * 2,
    derived_quoted AS "sales.w" + 0,
    derived_qualified AS sales.w + 0
)

# Was 6 (metric `w`).
query TI
SELECT * FROM semantic_view('dmn_metrics', dimensions := ['region'], metrics := ['"sales.w"'])
----
a	30

query TI
SELECT * FROM semantic_view('dmn_metrics', dimensions := ['region'], metrics := ['sales.w'])
----
a	6

# A derived metric over the quoted name. Was 6.
query TI
SELECT * FROM semantic_view('dmn_metrics', dimensions := ['region'], metrics := ['derived_quoted'])
----
a	30

query TI
SELECT * FROM semantic_view('dmn_metrics', dimensions := ['region'], metrics := ['derived_qualified'])
----
a	6

# ========================================
# Facts: a metric and a fact over the quoted fact name.
# ========================================

statement ok
CREATE SEMANTIC VIEW dmn_facts AS
TABLES (sales AS dmn_s PRIMARY KEY (id))
FACTS (
    sales."sales.f" AS sales.price,
    sales.f AS sales.qty,
    sales.g AS "sales.f" + 0
)
DIMENSIONS (sales.region AS sales.region)
METRICS (
    sales.m_quoted AS SUM("sales.f"),
    sales.m_qualified AS SUM(sales.f),
    sales.m_fact_on_fact AS SUM(g)
)

# Was 3 (fact `f`).
query TII
SELECT * FROM semantic_view('dmn_facts', dimensions := ['region'], metrics := ['m_quoted', 'm_qualified'])
----
a	30	3

# A fact over the quoted fact name, aggregated. Was 3.
query TI
SELECT * FROM semantic_view('dmn_facts', dimensions := ['region'], metrics := ['m_fact_on_fact'])
----
a	30

# The same fact queried as a fact. Was 1 and 2.
query I rowsort
SELECT * FROM semantic_view('dmn_facts', facts := ['g'])
----
10
20

# An LOD metric beside a plain metric with a quoted dotted name. Beside a plain
# metric on its home, an INCLUDE value is computed over that metric's rows
# (fixture 14d C1, as in phase8_lod_child_grain.test). The grain check has to
# find the plain metric "o.rev" by its own key: when it missed it, the value
# fell back to the INCLUDE metric alone (late 1100, NULL 100).

statement ok
CREATE TABLE dmn_customers (customer_id INTEGER, region VARCHAR);

statement ok
CREATE TABLE dmn_orders (order_id INTEGER, customer_id INTEGER, amount DECIMAL(10,2));

statement ok
CREATE TABLE dmn_returns (return_id INTEGER, order_id INTEGER, reason VARCHAR);

statement ok
INSERT INTO dmn_customers VALUES (1, 'North'), (2, 'North'), (3, 'South'), (4, 'South');

statement ok
INSERT INTO dmn_orders VALUES (101, 1, 400), (102, 1, 200), (103, 1, 300), (104, 1, 100),
  (105, 2, 200), (106, 2, 100), (107, 3, 300), (108, 3, 200), (109, 3, 100), (110, 4, 200);

statement ok
INSERT INTO dmn_returns VALUES (1, 101, 'damaged'), (2, 101, 'late'), (3, 103, 'late'), (4, 107, 'damaged'),
  (5, 102, 'late'), (6, 102, 'late'), (7, 104, NULL);

statement ok
CREATE SEMANTIC VIEW dmn_lod
  TABLES (customers AS dmn_customers PRIMARY KEY (customer_id), orders AS dmn_orders PRIMARY KEY (order_id),
    order_returns AS dmn_returns PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, order_returns.reason AS reason)
  METRICS (
    orders."o.rev" AS SUM(amount),
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id))
  );

query TRR
SELECT * FROM SEMANTIC_VIEW(dmn_lod DIMENSIONS order_returns.reason METRICS "o.rev", avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	700.00	350.0
late	900.00	900.0
NULL	900.00	225.0
