# TECH-DEBT #69 (MM-1) and #70 (MM-2): two role-playing shapes that were
# accepted at CREATE and emitted SQL that could not run. Both were found by
# tests/metamorphic_proptest.rs.
#
# #69: a `USING` metric over a FACT on the role-played table. The fact inlined
#      as its raw expression (`a.elevation`) while the table was joined only
#      under its scoped alias (`"p0a_airports" AS "a__dep_airport"`):
#      `Binder Error: Referenced table "a" not found`.
# #70: a QUOTED relationship name on a role-played edge. The scoped alias was
#      concatenated from the stored text, quotes and all, and the JOIN and the
#      member reference quoted it differently: `Parser Error: syntax error`.
#
# Every number below differs between the two roles, so a fix that bound the
# wrong instance would fail here rather than pass by accident.

require semantic_views

statement ok
CREATE TABLE p0a_airports (airport_code VARCHAR, city VARCHAR, elevation INTEGER);

statement ok
INSERT INTO p0a_airports VALUES ('SFO', 'San Francisco', 13), ('DEN', 'Denver', 5434);

statement ok
CREATE TABLE p0a_flights (flight_id INTEGER, departure_code VARCHAR, arrival_code VARCHAR);

# Two flights SFO -> DEN, one DEN -> SFO.
statement ok
INSERT INTO p0a_flights VALUES (1, 'SFO', 'DEN'), (2, 'SFO', 'DEN'), (3, 'DEN', 'SFO');

# ------------------------------------------------------------------
# #69: USING metrics over a fact on the role-played table
# ------------------------------------------------------------------

statement ok
CREATE SEMANTIC VIEW p0a_elev AS
  TABLES (
    f AS p0a_flights PRIMARY KEY (flight_id),
    a AS p0a_airports PRIMARY KEY (airport_code)
  )
  RELATIONSHIPS (
    dep_airport AS f(departure_code) REFERENCES a,
    arr_airport AS f(arrival_code) REFERENCES a
  )
  FACTS (
    a.elev AS a.elevation
  )
  DIMENSIONS (
    a.city AS a.city
  )
  METRICS (
    f.dep_elev USING (dep_airport) AS SUM(a.elev),
    f.arr_elev USING (arr_airport) AS SUM(a.elev),
    elev_climb AS arr_elev - dep_elev
  );

# Departures: 13 + 13 + 5434.
query I
SELECT * FROM SEMANTIC_VIEW(p0a_elev METRICS dep_elev);
----
5460

# Arrivals: 5434 + 5434 + 13 — the other instance of the same table.
query I
SELECT * FROM SEMANTIC_VIEW(p0a_elev METRICS arr_elev);
----
10881

# A derived metric composing both roles keeps them distinct.
query I
SELECT * FROM SEMANTIC_VIEW(p0a_elev METRICS elev_climb);
----
5421

# Grouped by the role-played dimension: the dimension and the inlined fact
# share the scoped alias, so each departure city sums its own elevation.
query TI rowsort
SELECT * FROM SEMANTIC_VIEW(p0a_elev DIMENSIONS city METRICS dep_elev);
----
Denver	5434
San Francisco	26

# ------------------------------------------------------------------
# #70: quoted relationship names on the role-playing pair
# ------------------------------------------------------------------

statement ok
CREATE SEMANTIC VIEW p0a_quoted AS
  TABLES (
    f AS p0a_flights PRIMARY KEY (flight_id),
    a AS p0a_airports PRIMARY KEY (airport_code)
  )
  RELATIONSHIPS (
    "Dep Airport" AS f(departure_code) REFERENCES a,
    "arr""port" AS f(arrival_code) REFERENCES a
  )
  DIMENSIONS (
    a.city AS a.city
  )
  METRICS (
    f.departures USING ("Dep Airport") AS COUNT(*),
    f.arrivals USING ("arr""port") AS COUNT(*)
  );

# A space in the relationship name.
query TI rowsort
SELECT * FROM SEMANTIC_VIEW(p0a_quoted DIMENSIONS city METRICS departures);
----
Denver	1
San Francisco	2

# An embedded doubled quote in the relationship name.
query TI rowsort
SELECT * FROM SEMANTIC_VIEW(p0a_quoted DIMENSIONS city METRICS arrivals);
----
Denver	2
San Francisco	1

# ------------------------------------------------------------------
# The fence #69 walks past: a member reaching the role-played fact with no
# single role to name. Before, `any_elev` returned 5460 — the departure role,
# only because `dep_airport` is declared first.
# ------------------------------------------------------------------

statement ok
CREATE SEMANTIC VIEW p0a_unscoped AS
  TABLES (
    f AS p0a_flights PRIMARY KEY (flight_id),
    a AS p0a_airports PRIMARY KEY (airport_code)
  )
  RELATIONSHIPS (
    dep_airport AS f(departure_code) REFERENCES a,
    arr_airport AS f(arrival_code) REFERENCES a
  )
  FACTS (
    a.elev AS a.elevation
  )
  METRICS (
    f.any_elev AS SUM(a.elev)
  );

statement error
SELECT * FROM SEMANTIC_VIEW(p0a_unscoped METRICS any_elev);
----
'any_elev' is ambiguous -- it references fact

# ------------------------------------------------------------------
# Relationship names follow DuckDB identifier rules: quoting never changes which
# relationship a name denotes. Every site matched names by ASCII-lowercased
# spelling, quotes included, so a relationship declared `"Dep_Airport"` was an
# "unknown relationship" to `USING (dep_airport)` at CREATE, and two roles named
# `dep` and `"dep"` were accepted as two names.
# ------------------------------------------------------------------

# Declared quoted, named bare in USING (and the converse on the other role).
statement ok
CREATE SEMANTIC VIEW p0a_mixed_quoting AS
  TABLES (
    f AS p0a_flights PRIMARY KEY (flight_id),
    a AS p0a_airports PRIMARY KEY (airport_code)
  )
  RELATIONSHIPS (
    "Dep_Airport" AS f(departure_code) REFERENCES a,
    arr_airport AS f(arrival_code) REFERENCES a
  )
  FACTS (
    a.elev AS a.elevation
  )
  DIMENSIONS (
    a.city AS a.city
  )
  METRICS (
    f.departures USING (dep_airport) AS COUNT(*),
    f.arrivals USING ("ARR_AIRPORT") AS COUNT(*),
    f.dep_elev USING (DEP_AIRPORT) AS SUM(a.elev)
  );

# Each spelling binds its own role: the numbers differ between the two roles.
query TI rowsort
SELECT * FROM SEMANTIC_VIEW(p0a_mixed_quoting DIMENSIONS city METRICS departures);
----
Denver	1
San Francisco	2

query TI rowsort
SELECT * FROM SEMANTIC_VIEW(p0a_mixed_quoting DIMENSIONS city METRICS arrivals);
----
Denver	2
San Francisco	1

# The role-played fact moves onto the departure role's alias: 13 + 13 + 5434.
query I
SELECT * FROM SEMANTIC_VIEW(p0a_mixed_quoting METRICS dep_elev);
----
5460

# `dep` and `"dep"` are ONE name, so two relationships named that way are
# rejected as a duplicate relationship name, exactly like `dep` / `DEP`
# (TECH-DEBT #79; before that check this was reported as a diamond).
statement error
CREATE SEMANTIC VIEW p0a_quoting_duplicate AS
  TABLES (
    f AS p0a_flights PRIMARY KEY (flight_id),
    a AS p0a_airports PRIMARY KEY (airport_code)
  )
  RELATIONSHIPS (
    dep AS f(departure_code) REFERENCES a,
    "dep" AS f(arrival_code) REFERENCES a
  )
  DIMENSIONS (
    a.city AS a.city
  )
  METRICS (
    f.departures USING (dep) AS COUNT(*)
  );
----
duplicate relationship name 'dep'
