# Phase 65.1 Plan 11 — WR-07 / WR-08 / D-14 / D-15 hard-error coverage.
#
# Before Plan 11, two silent fallbacks lived behind `semantic_view()`'s
# bind-time LIMIT 0 type-inference probe: a failed probe declared its columns
# with a placeholder type (DECIMAL(18,3), LIST(VARCHAR), or VARCHAR for
# DUCKDB_TYPE_INVALID), masking broken definitions. Plan 11 made a failed
# probe an error.
#
# The probe is gone now: `semantic_view()` hands DuckDB its expansion to plan
# as part of the caller's query (TECH-DEBT #42), so the column types are
# DuckDB's own and a broken definition fails as any broken query does, with
# DuckDB's error. This file keeps pinning that it fails, loudly.

require semantic_views

statement ok
LOAD semantic_views;

# ---- B1: happy path regression guard ---------------------------------------
# A valid semantic view + query must still succeed: the hard-error paths
# must not regress the common case.

statement ok
CREATE TABLE p651_orders (order_id INTEGER, total DECIMAL(10,2));

statement ok
INSERT INTO p651_orders VALUES (1, 10.50), (2, 20.00), (3, 5.25);

statement ok
CREATE SEMANTIC VIEW v_good_probe
  AS
    TABLES (o AS p651_orders PRIMARY KEY (order_id))
    DIMENSIONS (o.order_id AS o.order_id)
    METRICS (o.total AS SUM(o.total));

query I
SELECT COUNT(*) FROM SEMANTIC_VIEW(v_good_probe METRICS total)
----
1

# ---- B2: a broken metric is a hard error -----------------------------------
# A METRIC expression referencing a column the base table no longer has. CREATE
# binds every member, so the column is dropped after CREATE. At query time
# DuckDB binds the expansion as part of the query and raises its own Binder
# Error, verbatim — never a VARCHAR placeholder column (WR-08 / D-15). Before
# `semantic_view()` handed DuckDB its expansion to plan (TECH-DEBT #42) the
# error came from a LIMIT 0 probe, wrapped as "type inference failed for
# query".

statement ok
CREATE TABLE p651_drift (order_id INTEGER, dropped INTEGER);

statement ok
CREATE SEMANTIC VIEW v_bad_probe
  AS
    TABLES (o AS p651_drift PRIMARY KEY (order_id))
    DIMENSIONS (o.order_id AS o.order_id)
    METRICS (o.bogus AS SUM(o.dropped));

statement ok
ALTER TABLE p651_drift DROP COLUMN dropped;

statement error
SELECT * FROM SEMANTIC_VIEW(v_bad_probe METRICS bogus)
----
Table "o" does not have a column named "dropped"

# Cleanup: drop both semantic views and the base table so subsequent tests
# in the runner cascade see a clean catalog.

statement ok
DROP SEMANTIC VIEW v_good_probe;

statement ok
DROP SEMANTIC VIEW v_bad_probe;

statement ok
DROP TABLE p651_orders;

statement ok
DROP TABLE p651_drift;
