# DDL accept/reject corpus — non-CREATE statements, part B (Phase 3 of the PEG epic).
#
# Ports the SHOW SEMANTIC VIEWS / DIMENSIONS / METRICS / FACTS / MATERIALIZATIONS
# filter clauses (LIKE, IN, FOR METRIC, STARTS WITH, LIMIT), the quoted-name
# slots and the IN SCHEMA / IN DATABASE / IN ACCOUNT scope cases from the
# `#[test]`s in `src/parse/rewrite.rs` (`mod tests`). Part A is
# `ddl_corpus_statements_a.test`.
#
# Every row carries an id `S-NNN`; the case map from Rust test to row id is
# `_notes/phase3-corpus/map-S.md`. Row tags:
#   [syntax]  a syntactic reject: no message is pinned (it will change under
#             the grammar), only that the statement fails. The runner insists
#             on a `----` line after `statement error`; an empty block after it
#             accepts any error message.
#   [text]    today's contract on something a grammar might plausibly change
#             (case folding, quoting, whitespace).
#
# SHOW SEMANTIC VIEWS leads with a live `created_on` timestamp, matched by a
# <REGEX> value; its rows come back sorted by schema then name, so those
# queries are `nosort`.

require semantic_views

# --- fixtures ---

statement ok
CREATE TABLE dcs_orders (id INTEGER, region VARCHAR, cust VARCHAR, amount INTEGER);

statement ok
INSERT INTO dcs_orders VALUES (1, 'east', 'ann', 10), (2, 'west', 'bob', 20), (3, 'east', 'cat', 30);

statement ok
CREATE SCHEMA dcs_sch;

statement ok
CREATE TABLE dcs_sch.dcs_orders (id INTEGER, region VARCHAR, cust VARCHAR, amount INTEGER);

statement ok
CREATE MACRO dcs_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

# Catalog state: every semantic view, with its schema and comment.
statement ok
CREATE MACRO dcs_views() AS TABLE SELECT schema_name, name, comment FROM list_semantic_views();

# --- SHOW filter clauses: LIKE / IN / FOR METRIC / STARTS WITH / LIMIT ---

# `v` and `w` carry the members the SHOW SEMANTIC DIMENSIONS/METRICS/FACTS rows
# filter; the other views exist for the SHOW SEMANTIC VIEWS name filters.

statement ok
CREATE SEMANTIC VIEW v AS TABLES (o AS dcs_orders PRIMARY KEY (id)) FACTS (o.raw_amount AS o.amount) DIMENSIONS (o.region AS o.region, o.customer AS o.cust, o.cust_tier AS CASE WHEN o.amount > 15 THEN 'big' ELSE 'small' END, o.cust_initial AS left(o.cust, 1)) METRICS (o.revenue AS SUM(o.amount), o.total_orders AS COUNT(*), o.total_amount AS SUM(o.amount), o.avg_amount AS AVG(o.amount));

statement ok
CREATE SEMANTIC VIEW w AS TABLES (o AS dcs_orders PRIMARY KEY (id)) FACTS (o.unit AS 1) DIMENSIONS (o.rev_bucket AS o.amount // 10, o.area AS o.region) METRICS (o.total_units AS SUM(1));

statement ok
CREATE SEMANTIC VIEW product_sv AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

statement ok
CREATE SEMANTIC VIEW sales_a AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

statement ok
CREATE SEMANTIC VIEW sales_b AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

statement ok
CREATE SEMANTIC VIEW dcs_sch.sch_sv AS TABLES (o AS dcs_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

# S-200: rewrite.rs::phase34_1_1_show_filter_tests::test_rewrite_show_dims_like_cross_view, test_build_filter_suffix_like_only — LIKE with no IN filters dimensions across every view
query TTTTTTTT rowsort
SHOW SEMANTIC DIMENSIONS LIKE '%rev%'
----
memory	main	w	dcs_orders	rev_bucket	INTEGER	[]	(empty)

# S-201: rewrite.rs::phase34_1_1_show_filter_tests::test_rewrite_show_dims_like_in_starts_with_limit — LIKE, IN <view>, STARTS WITH and LIMIT compose (LIMIT cuts 3 matches to 2)
query TTTTTTTT nosort
SHOW SEMANTIC DIMENSIONS LIKE '%c%' IN v STARTS WITH 'cust' LIMIT 2
----
memory	main	v	dcs_orders	cust_initial	VARCHAR	[]	(empty)
memory	main	v	dcs_orders	cust_tier	VARCHAR	[]	(empty)

# S-202: rewrite.rs::phase34_1_1_show_filter_tests::test_rewrite_show_metrics_starts_with_limit, test_build_filter_suffix_starts_with_only — STARTS WITH then LIMIT 1 across views
query TTTTTTTT nosort
SHOW SEMANTIC METRICS STARTS WITH 'total' LIMIT 1
----
memory	main	product_sv	dcs_orders	total	BIGINT	[]	(empty)

query TTTTTTTT rowsort
SHOW SEMANTIC METRICS STARTS WITH 'total'
----
memory	dcs_sch	sch_sv	dcs_orders	total	BIGINT	[]	(empty)
memory	main	product_sv	dcs_orders	total	BIGINT	[]	(empty)
memory	main	sales_a	dcs_orders	total	BIGINT	[]	(empty)
memory	main	sales_b	dcs_orders	total	BIGINT	[]	(empty)
memory	main	v	dcs_orders	total_amount	BIGINT	[]	(empty)
memory	main	v	dcs_orders	total_orders	BIGINT	[]	(empty)
memory	main	w	dcs_orders	total_units	BIGINT	[]	(empty)

# S-203: rewrite.rs::phase34_1_1_show_filter_tests::test_rewrite_show_facts_limit, test_build_filter_suffix_limit_only — LIMIT alone; LIMIT 1 below the two facts shows it takes effect
query TTTTTTTT rowsort
SHOW SEMANTIC FACTS LIMIT 10
----
memory	main	v	dcs_orders	raw_amount	INTEGER	[]	(empty)
memory	main	w	dcs_orders	unit	INTEGER	[]	(empty)

query TTTTTTTT nosort
SHOW SEMANTIC FACTS LIMIT 1
----
memory	main	v	dcs_orders	raw_amount	INTEGER	[]	(empty)

# S-204: rewrite.rs::phase34_1_1_show_filter_tests::test_rewrite_show_dims_for_metric_with_all_clauses — LIKE, IN, FOR METRIC, STARTS WITH, LIMIT all together
# LIKE drops cust_initial, which would sort first, and LIMIT 1 drops customer.
query TTTT nosort
SHOW SEMANTIC DIMENSIONS LIKE '%r%' IN v FOR METRIC revenue STARTS WITH 'c' LIMIT 1
----
dcs_orders	cust_tier	VARCHAR	false

