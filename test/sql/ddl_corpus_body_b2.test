# --- MATERIALIZATIONS clause ---

# A materialization's TABLE is not resolved at CREATE, so the aggregate tables
# need not exist.

# C-102: body_parser/mod.rs::parse_materializations_clause_single_entry, body_parser/mod.rs::parse_keyword_body_with_materializations — one materialization: name daily_rev, TABLE daily_revenue_agg, DIMENSIONS (region), METRICS (revenue, order_count)
statement ok
CREATE SEMANTIC VIEW dcc_c102 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region, o.date_dim AS o.created_at) METRICS (o.revenue AS SUM(o.amount), o.order_count AS COUNT(*)) MATERIALIZATIONS (
  daily_rev AS (
    TABLE daily_revenue_agg,
    DIMENSIONS (region),
    METRICS (revenue, order_count)
  )
);

query T nosort
SELECT * FROM dcc_ddl('dcc_c102');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c102 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.region AS o.region,
    o.date_dim AS o.created_at
)
METRICS (
    o.revenue AS SUM(o.amount),
    o.order_count AS COUNT(*)
)
MATERIALIZATIONS (
    daily_rev AS (
        TABLE daily_revenue_agg,
