# Explicit PARTITION BY (as opposed to PARTITION BY EXCLUDING).

# C-098: body_parser/mod.rs::parse_metrics_window_partition_by_explicit, body_parser/mod.rs::parse_keyword_body_window_partition_by_integration — PARTITION BY store ORDER BY date: partition [store], no excluding dims, ORDER BY date
statement ok
CREATE SEMANTIC VIEW dcc_c098 AS TABLES (o AS dcc_orders PRIMARY KEY (id)) DIMENSIONS (o.store AS o.store, o.date AS o.sale_date, o.region AS o.region) METRICS (o.total_qty AS SUM(o.qty), o.avg_qty AS AVG(total_qty) OVER (PARTITION BY store ORDER BY date));

query T nosort
SELECT * FROM dcc_ddl('dcc_c098');
----
CREATE OR REPLACE SEMANTIC VIEW dcc_c098 AS
TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.store AS o.store,
    o.date AS o.sale_date,
    o.region AS o.region
)
METRICS (
    o.total_qty AS SUM(o.qty),
    o.avg_qty AS AVG(total_qty) OVER (PARTITION BY store ORDER BY date NULLS LAST)
)

query T nosort
SELECT line FROM dcc_yaml('dcc_c098') WHERE line LIKE '    %' OR line LIKE '  window_spec:%' OR line LIKE '- name: %';
----
- name: store
- name: date
- name: region
- name: total_qty
- name: avg_qty
  window_spec:
    window_function: AVG
    inner_metric: total_qty
    partition_dims:
    - store
    order_by:
    - expr: date

