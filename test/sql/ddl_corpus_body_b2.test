TABLES (
    o AS dcc_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.d AS o.region,
    o.t AS o.created_at
)
METRICS (
    o.w AS SUM(o.qty),
    o.a AS main.avg(w) OVER (PARTITION BY d),
    o.b AS "my func"(w) OVER (PARTITION BY d),
    o.c AS AVG(w) OVER (PARTITION BY d),
    o.e AS lead(w, 1) OVER (PARTITION BY d ORDER BY t NULLS LAST)
)

