# TECH-DEBT #83: bare (unqualified) column references in member expressions.
#
# Snowflake scopes a member expression to its own logical table: a bare
# column is that table's column. CREATE records each table's columns, and the
# expansion qualifies a bare column with the member's own table when that
# table has it, so:
#   * a same-name collision (`o_id` is on both `o` and `li`) reads the
#     member's own table's column whatever the query joins -- on the
#     home-anchored metric path, in a multi-grain plan, on the anchored
#     dimensions-only path and in a FACTS query. Before #83 each was DuckDB's
#     `Ambiguous reference to column name`;
#   * a bare column of another table (`amount` exists only on `o`, used in a
#     metric on `li`) is refused at CREATE, naming the rule, as Snowflake
#     refuses it.
# A view stored before 0.19.0 has no column lists and keeps splicing its
# expressions as written; re-creating it records them. Fixture 9's cases are in
# phase7_bare_columns.test; the unit twins are in
# src/expand/tests_bare_column_scoping.rs and src/expand/bare_columns.rs.

require semantic_views

statement ok
CREATE TABLE bcs_c (c_id INT, region VARCHAR);

statement ok
CREATE TABLE bcs_o (o_id INT, c_id INT, amount INT);

statement ok
CREATE TABLE bcs_li (li_id INT, o_id INT, qty INT);

statement ok
INSERT INTO bcs_c VALUES (1, 'EU'), (2, 'US');

statement ok
INSERT INTO bcs_o VALUES (10, 1, 100), (11, 1, 50), (12, 2, 70), (13, NULL, 5);

statement ok
INSERT INTO bcs_li VALUES (100, 10, 1), (101, 10, 2), (102, 11, 3), (103, NULL, 40);

# A fact on `li` with a bare `o_id`, which `o` has too.
statement ok
CREATE SEMANTIC VIEW bcs_v AS
  TABLES (
    c  AS bcs_c  PRIMARY KEY (c_id),
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  FACTS (li.li_order AS o_id)
  DIMENSIONS (c.region AS region);

query I rowsort
SELECT * FROM SEMANTIC_VIEW(bcs_v FACTS li_order);
----
10
10
11
NULL

# A filter on `c` joins `o` too; the fact still reads `li.o_id`.
query I rowsort
SELECT * FROM SEMANTIC_VIEW(bcs_v FACTS li_order WHERE region = 'EU');
----
10
10
11

# The stored definition records each table's columns.
query T
SELECT json_keys(definition::JSON -> 'table_columns') FROM semantic_layer._definitions
WHERE name = 'bcs_v';
----
[c, li, o]

statement ok
DROP SEMANTIC VIEW bcs_v;

# A metric on `li` reading `o`'s `amount`, bare: refused, naming the rule.
statement error
CREATE SEMANTIC VIEW bcs_v AS
  TABLES (
    c  AS bcs_c  PRIMARY KEY (c_id),
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  DIMENSIONS (c.region AS region)
  METRICS (li.li_amount AS SUM(amount));
----
metric 'li_amount' references 'amount', a column of table 'o', but a metric expression may only reference columns of its own table ('li')

statement ok
CREATE SEMANTIC VIEW bcs_v AS
  TABLES (
    c  AS bcs_c  PRIMARY KEY (c_id),
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  DIMENSIONS (
    c.region   AS region,
    o.order_id AS o_id,
    li.item_qty AS qty
  )
  METRICS (
    o.sum_o_oid  AS SUM(o_id),
    li.sum_li_oid AS SUM(o_id),
    li.total_qty AS SUM(qty)
  );

# Metric, home-anchored (FROM li LEFT JOIN o LEFT JOIN c): li.o_id.
query TI
SELECT * FROM SEMANTIC_VIEW(bcs_v DIMENSIONS region METRICS sum_li_oid) ORDER BY ALL NULLS LAST;
----
EU	31
NULL	NULL

# Dimension on `o` inside `li`'s home-anchored query: o.o_id.
query II
SELECT * FROM SEMANTIC_VIEW(bcs_v DIMENSIONS order_id METRICS total_qty) ORDER BY ALL NULLS LAST;
----
10	3
11	3
NULL	40

# Multi-grain plan: each grain reads its own table's o_id.
query III
SELECT * FROM SEMANTIC_VIEW(bcs_v DIMENSIONS order_id METRICS sum_o_oid, total_qty)
ORDER BY ALL NULLS LAST;
----
10	10	3
11	11	3
12	12	NULL
13	13	NULL
NULL	NULL	40

# Dimensions-only (anchored at li: FROM li LEFT JOIN o).
query II
SELECT * FROM SEMANTIC_VIEW(bcs_v DIMENSIONS order_id, item_qty) ORDER BY ALL NULLS LAST;
----
10	1
10	2
11	3
NULL	40

# The home table alone: li.o_id, 10 + 10 + 11 = 31.
query I
SELECT * FROM SEMANTIC_VIEW(bcs_v METRICS sum_li_oid);
----
31

# No collision on the joined tables: binds to o.o_id. The orphan order 13 is
# the NULL-region row (home-anchored, #71).
query TI
SELECT * FROM SEMANTIC_VIEW(bcs_v DIMENSIONS region METRICS sum_o_oid)
ORDER BY region NULLS LAST;
----
EU	21
US	12
NULL	13

# GET_DDL shows the expressions as written, and the YAML export leaves the
# column lists out (CREATE records them again).
query II
SELECT GET_DDL('SEMANTIC_VIEW', 'bcs_v') LIKE '%li.sum_li_oid AS SUM(o_id)%',
       read_yaml_from_semantic_view('bcs_v') LIKE '%table_columns%';
----
true	false

# A view stored before 0.19.0 has no column lists: its bare columns are
# spliced as written, so the collision is DuckDB's ambiguity, as it was then.
statement ok
INSERT INTO semantic_layer._definitions (schema_name, name, definition)
SELECT schema_name, 'bcs_stored', json_merge_patch(definition, '{"table_columns": null}')::VARCHAR
FROM semantic_layer._definitions WHERE name = 'bcs_v';

statement error
SELECT * FROM SEMANTIC_VIEW(bcs_stored DIMENSIONS region METRICS sum_li_oid);
----
Ambiguous reference to column name "o_id"

# Re-creating it (here CREATE OR ALTER) records them.
statement ok
CREATE OR ALTER SEMANTIC VIEW bcs_stored AS
  TABLES (
    c  AS bcs_c  PRIMARY KEY (c_id),
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  DIMENSIONS (c.region AS region)
  METRICS (li.sum_li_oid AS SUM(o_id));

query TI
SELECT * FROM SEMANTIC_VIEW(bcs_stored DIMENSIONS region METRICS sum_li_oid) ORDER BY ALL NULLS LAST;
----
EU	31
NULL	NULL

# Re-creating a stored view unchanged keeps its materializations: the old
# definition's bare columns and the statement's qualified ones are compared
# under the statement's column lists.
statement ok
CREATE TABLE bcs_agg AS SELECT 'EU' AS region, 150 AS revenue;

statement ok
CREATE SEMANTIC VIEW bcs_mat AS
  TABLES (o AS bcs_o PRIMARY KEY (o_id), c AS bcs_c PRIMARY KEY (c_id))
  RELATIONSHIPS (o_to_c AS o(c_id) REFERENCES c)
  DIMENSIONS (c.region AS region)
  METRICS (o.revenue AS SUM(amount))
  MATERIALIZATIONS (by_region AS (TABLE bcs_agg, DIMENSIONS (region), METRICS (revenue)));

statement ok
INSERT INTO semantic_layer._definitions (schema_name, name, definition)
SELECT schema_name, 'bcs_mat_stored', json_merge_patch(definition, '{"table_columns": null}')::VARCHAR
FROM semantic_layer._definitions WHERE name = 'bcs_mat';

statement ok
CREATE OR ALTER SEMANTIC VIEW bcs_mat_stored AS
  TABLES (o AS bcs_o PRIMARY KEY (o_id), c AS bcs_c PRIMARY KEY (c_id))
  RELATIONSHIPS (o_to_c AS o(c_id) REFERENCES c)
  DIMENSIONS (c.region AS region)
  METRICS (o.revenue AS SUM(amount));

query I
SELECT count(*) FROM (SHOW SEMANTIC MATERIALIZATIONS IN bcs_mat_stored);
----
1

statement ok
DROP SEMANTIC VIEW bcs_mat_stored;

statement ok
DROP SEMANTIC VIEW bcs_mat;

statement ok
DROP TABLE bcs_agg;

# FROM YAML records them too.
statement ok
CREATE SEMANTIC VIEW bcs_yaml FROM YAML $$
tables:
- alias: c
  table: bcs_c
  pk_columns: [c_id]
- alias: o
  table: bcs_o
  pk_columns: [o_id]
- alias: li
  table: bcs_li
  pk_columns: [li_id]
dimensions:
- name: region
  expr: region
  source_table: c
metrics:
- name: sum_li_oid
  expr: SUM(o_id)
  source_table: li
joins:
- table: c
  from_alias: o
  fk_columns: [c_id]
  ref_columns: [c_id]
  name: o_to_c
- table: o
  from_alias: li
  fk_columns: [o_id]
  ref_columns: [o_id]
  name: li_to_o
$$;

query TI
SELECT * FROM SEMANTIC_VIEW(bcs_yaml DIMENSIONS region METRICS sum_li_oid) ORDER BY ALL NULLS LAST;
----
EU	31
NULL	NULL

# verify_semantic_view_yaml applies the CREATE's refusal.
statement error
SELECT * FROM verify_semantic_view_yaml('bcs_bad', $$
tables:
- alias: o
  table: bcs_o
  pk_columns: [o_id]
- alias: li
  table: bcs_li
  pk_columns: [li_id]
dimensions: []
metrics:
- name: li_amount
  expr: SUM(amount)
  source_table: li
joins:
- table: o
  from_alias: li
  fk_columns: [o_id]
  ref_columns: [o_id]
  name: li_to_o
$$);
----
metric 'li_amount' references 'amount', a column of table 'o'

# A table defined by a query records the query's columns.
statement ok
CREATE SEMANTIC VIEW bcs_inline AS
  TABLES (
    c  AS (SELECT * FROM bcs_c) PRIMARY KEY (c_id),
    o  AS (SELECT * FROM bcs_o) PRIMARY KEY (o_id),
    li AS (SELECT * FROM bcs_li) PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  DIMENSIONS (c.region AS region)
  METRICS (li.sum_li_oid AS SUM(o_id));

query TI
SELECT * FROM SEMANTIC_VIEW(bcs_inline DIMENSIONS region METRICS sum_li_oid) ORDER BY ALL NULLS LAST;
----
EU	31
NULL	NULL

# A member's own name in its own expression is its column, not the member:
# a metric named after its column (`li.o_id AS SUM(o_id)`) and an identity
# fact (`li.o_id AS o_id`) read li.o_id, which `o` has too.
statement ok
CREATE SEMANTIC VIEW bcs_self_metric AS
  TABLES (
    c  AS bcs_c  PRIMARY KEY (c_id),
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  DIMENSIONS (c.region AS region)
  METRICS (li.o_id AS SUM(o_id));

query TI
SELECT * FROM SEMANTIC_VIEW(bcs_self_metric DIMENSIONS region METRICS o_id) ORDER BY ALL NULLS LAST;
----
EU	31
NULL	NULL

statement ok
CREATE SEMANTIC VIEW bcs_identity_fact AS
  TABLES (
    c  AS bcs_c  PRIMARY KEY (c_id),
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (
    o_to_c  AS o(c_id)  REFERENCES c,
    li_to_o AS li(o_id) REFERENCES o
  )
  FACTS (li.o_id AS o_id)
  DIMENSIONS (c.region AS region)
  METRICS (li.sum_li_oid AS SUM(o_id));

query TI
SELECT * FROM SEMANTIC_VIEW(bcs_identity_fact DIMENSIONS region METRICS sum_li_oid) ORDER BY ALL NULLS LAST;
----
EU	31
NULL	NULL

# The same members over a column only `o` has are refused, as any bare column
# of another table is.
statement error
CREATE SEMANTIC VIEW bcs_bad AS
  TABLES (
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (li_to_o AS li(o_id) REFERENCES o)
  METRICS (li.amount AS SUM(amount));
----
metric 'amount' references 'amount', a column of table 'o'

statement error
CREATE SEMANTIC VIEW bcs_bad AS
  TABLES (
    o  AS bcs_o  PRIMARY KEY (o_id),
    li AS bcs_li PRIMARY KEY (li_id)
  )
  RELATIONSHIPS (li_to_o AS li(o_id) REFERENCES o)
  FACTS (li.amount AS amount)
  METRICS (li.total AS SUM(amount));
----
fact 'amount' references 'amount', a column of table 'o'

statement ok
DROP SEMANTIC VIEW bcs_identity_fact;

