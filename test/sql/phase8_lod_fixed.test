# Phase 8.5a: level-of-detail (LOD) expressions with FIXED DIMENSIONS, as in
# Snowflake.
#
# `COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id)` is
# computed once per customer over every order, whatever the query groups by or
# filters on, and a metric over it reads each customer's value once per group
# the customer's orders fall in. The data and the expected answers are
# Snowflake's documented example (North: Alice 4 orders 1000, Bob 2 orders 300;
# South: Carol 3 orders 600, Dan 1 order 200) and the Phase 8 fixtures 11 and
# 11b, run on Snowflake 2026-11-13. Each case is labelled with its fixture id.

require semantic_views

statement ok
CREATE TABLE customers (customer_id INTEGER, name VARCHAR, region VARCHAR, segment VARCHAR);

statement ok
CREATE TABLE orders (order_id INTEGER, customer_id INTEGER, category VARCHAR, amount DECIMAL(10,2));

statement ok
INSERT INTO customers VALUES (1, 'Alice', 'North', 'Premium'), (2, 'Bob', 'North', 'Standard'),
  (3, 'Carol', 'South', 'Premium'), (4, 'Dan', 'South', 'Standard');

statement ok
INSERT INTO orders VALUES (101, 1, 'Electronics', 400), (102, 1, 'Electronics', 200),
  (103, 1, 'Clothing', 300), (104, 1, 'Clothing', 100), (105, 2, 'Electronics', 200),
  (106, 2, 'Clothing', 100), (107, 3, 'Electronics', 300), (108, 3, 'Electronics', 200),
  (109, 3, 'Clothing', 100), (110, 4, 'Electronics', 200);

# L0: the documented view's FIXED members (its INCLUDE and EXCLUDE members are
# Phase 8.5b). `orders` declares no key, as in the docs.
statement ok
CREATE SEMANTIC VIEW sales_sv
  TABLES (
    customers AS customers PRIMARY KEY (customer_id),
    orders AS orders
  )
  RELATIONSHIPS (
    orders(customer_id) REFERENCES customers
  )
  FACTS (
    orders.order_amount AS amount,
    orders_per_customer AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),
    revenue_per_customer AS SUM(orders.order_amount) FIXED DIMENSIONS (customers.customer_id),
    grand_total_revenue AS SUM(orders.order_amount) FIXED DIMENSIONS (),
    region_total_fixed AS SUM(orders.order_amount) FIXED DIMENSIONS (customers.region),
    category_total_fixed AS SUM(orders.order_amount) FIXED DIMENSIONS (orders.category)
  )
  DIMENSIONS (
    customers.customer_id AS customer_id,
    customers.region AS region,
    customers.segment AS segment,
    orders.order_id AS order_id,
    orders.category AS category,
    orders_by_region AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.region)
  )
  METRICS (
    orders.total_revenue AS SUM(amount),
    orders.order_count AS COUNT(orders.order_id),
    avg_orders_per_customer AS AVG(orders_per_customer),
    avg_revenue_per_customer AS AVG(revenue_per_customer),
    sum_orders_per_customer AS SUM(orders_per_customer),
    pct_of_total AS SUM(orders.order_amount) / AVG(grand_total_revenue),
    avg_orders_per_customer_inline AS AVG(COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id)),
    region_rev_via_fixed AS AVG(region_total_fixed),
    avg_category_total AS AVG(category_total_fixed),
    avg_opc_plus_one AS AVG(orders_per_customer + 1),
    avg_busy_opc AS AVG(CASE WHEN orders_per_customer > 2 THEN orders_per_customer END)
  );

# L1: each region averages its customers' order counts (Alice 4, Bob 2; Carol 3, Dan 1).
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_per_customer) ORDER BY 1;
----
North	3.0
South	2.0

# L2: with no dimension, the average of all four customers.
query R
SELECT * FROM SEMANTIC_VIEW(sales_sv METRICS avg_orders_per_customer);
----
2.5

# L3: FIXED DIMENSIONS () is the grand total, a denominator at any grain.
query TRR
SELECT region, total_revenue, round(pct_of_total, 3) FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS orders.total_revenue, pct_of_total) ORDER BY 1;
----
North	1300.00	0.619
South	800.00	0.381

# L4: an LOD dimension, each customer showing its region's order count.
query ITIR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.customer_id, customers.region, orders_by_region METRICS orders.total_revenue) ORDER BY 1;
----
1	North	6	1000.00
2	North	6	300.00
3	South	4	600.00
4	South	4	200.00

# L5: the inline form gives the named fact's answer.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_per_customer_inline) ORDER BY 1;
----
North	3.0
South	2.0

# L11: a FIXED value is computed before the filter: Alice's row keeps North's 1300.
query TIR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, customers.customer_id METRICS region_rev_via_fixed WHERE customers.customer_id = 1);
----
North	1	1300.0

# L12: a filter on an order dimension keeps each customer's full count.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_per_customer WHERE orders.category = 'Electronics') ORDER BY 1;
----
North	3.0
South	2.0

# L12b: the filter only decides which customers remain: Dan has no Clothing order.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_per_customer WHERE orders.category = 'Clothing') ORDER BY 1;
----
North	3.0
South	3.0

# L13: grouped by an order dimension, each customer counts once per category it has
# orders in (Clothing: Alice 4, Bob 2, Carol 3).
query TRI
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS orders.category METRICS avg_orders_per_customer, sum_orders_per_customer) ORDER BY 1;
----
Clothing	3.0	9
Electronics	2.5	10

# L14b: read in FACTS beside an order fact, one row per order with its customer's count.
query RI
SELECT * FROM SEMANTIC_VIEW(sales_sv FACTS orders.order_amount, orders_per_customer) ORDER BY 1, 2;
----
100.00	2
100.00	3
100.00	4
200.00	1
200.00	2
200.00	3
200.00	4
300.00	3
300.00	4
400.00	4

# L15: grouped by the LOD dimension.
query II
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS orders_by_region METRICS orders.order_count) ORDER BY 1;
----
4	4
6	6

# L16: filtered on the LOD dimension.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS orders.total_revenue WHERE orders_by_region > 5) ORDER BY 1;
----
North	1300.00

# L17: beside an ordinary metric at a finer grain.
query TTIR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, orders.category METRICS orders.order_count, avg_orders_per_customer) ORDER BY 1, 2;
----
North	Clothing	3	3.0
North	Electronics	3	3.0
South	Clothing	1	3.0
South	Electronics	3	2.0

# L18: FIXED on an order dimension, averaged by region: each region reaches both
# categories, each with its total over all regions (600 and 1500).
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_category_total) ORDER BY 1;
----
North	1050.0
South	1050.0

# L19: the standard-SQL form.
query TR
SELECT customers.region, AGG(avg_orders_per_customer) AS avg_orders FROM sales_sv GROUP BY customers.region ORDER BY 1;
----
North	3.0
South	2.0

# L24c: an LOD fact with a constant in its aggregate.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_opc_plus_one) ORDER BY 1;
----
North	4.0
South	3.0

# L25: an LOD fact has no table prefix.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS AVG(orders.orders_per_customer));
----
'orders.orders_per_customer' is not a dimension, fact or metric

# L27: an LOD expression cannot be written in a query.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS AVG(COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id)));
----
syntax error at or near "FIXED"

# L28b: an ad-hoc dimension beside a FIXED metric.
query IR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.customer_id + 100 METRICS avg_orders_per_customer) ORDER BY 1;
----
101	4.0
102	2.0
103	3.0
104	1.0

# L29: an ad-hoc aggregate of an LOD fact.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS AVG(orders_per_customer)) ORDER BY 1;
----
North	3.0
South	2.0

# L29b: an ad-hoc aggregate cannot read an LOD fact beside another member.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS AVG(orders_per_customer + orders.order_amount));
----
That call can aggregate only the LOD expression

# L29c: nor an LOD dimension as a row-level value.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS orders_by_region + 1 METRICS orders.order_count);
----
is an LOD dimension; an expression item cannot read one

# L29d: an LOD dimension on its own in a dimensions-only query.
query I
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS orders_by_region) ORDER BY 1;
----
4
6

# L5c: one aggregate call reads the same LOD expression twice: North averages
# Alice's 4 (Bob's 2 is no more than 2), South Carol's 3.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_busy_opc) ORDER BY 1;
----
North	4.0
South	3.0

# L20e: SHOW SEMANTIC DIMENSIONS ... FOR METRIC lists every dimension an LOD
# metric can be grouped by, as for any metric.
query T
SELECT name FROM (SHOW SEMANTIC DIMENSIONS IN sales_sv FOR METRIC avg_orders_per_customer) ORDER BY 1;
----
category
customer_id
order_id
orders_by_region
region
segment

query T
SELECT name FROM (SHOW SEMANTIC DIMENSIONS IN sales_sv FOR METRIC pct_of_total) ORDER BY 1;
----
category
customer_id
order_id
orders_by_region
region
segment

# L20: SHOW lists LOD facts and dimensions with no table.
query TT
SELECT table_name, name FROM (SHOW SEMANTIC FACTS IN sales_sv) WHERE name IN ('orders_per_customer', 'order_amount') ORDER BY 2;
----
orders	order_amount
(empty)	orders_per_customer

query TT
SELECT table_name, name FROM (SHOW SEMANTIC DIMENSIONS IN sales_sv) WHERE name = 'orders_by_region';
----
(empty)	orders_by_region

# L20c: DESCRIBE gives an LOD member no table, its aggregate as its expression,
# and its dimensions as a FIXED_DIMENSIONS property.
query TTTT
SELECT object_kind, parent_entity, property, property_value FROM (DESCRIBE SEMANTIC VIEW sales_sv)
WHERE object_name IN ('orders_per_customer', 'grand_total_revenue', 'orders_by_region') AND property IN ('TABLE', 'EXPRESSION', 'FIXED_DIMENSIONS')
ORDER BY object_name, property;
----
FACT	(empty)	EXPRESSION	SUM(orders.order_amount)
FACT	(empty)	FIXED_DIMENSIONS	[]
DIMENSION	(empty)	EXPRESSION	COUNT(orders.order_id)
DIMENSION	(empty)	FIXED_DIMENSIONS	[["customers","region"]]
FACT	(empty)	EXPRESSION	COUNT(orders.order_id)
FACT	(empty)	FIXED_DIMENSIONS	[["customers","customer_id"]]

# L20d: GET_DDL keeps each LOD expression as written (the render-and-reparse
# round trip is `render_ddl`'s unit test).
query T
SELECT GET_DDL('SEMANTIC_VIEW', 'sales_sv') LIKE '%orders_per_customer AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),%';
----
true

# L30: several fixed dimensions, identifiers in another case and quoted, and a
# private LOD fact.
statement ok
CREATE SEMANTIC VIEW sales_multi
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (
    orders.order_amount AS amount,
    PRIVATE rev_by_region_cat AS SUM(orders.order_amount) fixed dimensions ("CUSTOMERS".Region, orders."category")
  )
  DIMENSIONS (customers.region AS region, orders.category AS category, customers.customer_id AS customer_id)
  METRICS (max_cell AS MAX(rev_by_region_cat), orders.total AS SUM(orders.order_amount));

# North Clothing 500 and Electronics 800, South Clothing 100 and Electronics 700.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_multi DIMENSIONS customers.region METRICS max_cell) ORDER BY 1;
----
North	800.00
South	700.00

# Each customer reaches the cells of its own orders: Dan only South Electronics.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_multi DIMENSIONS customers.customer_id METRICS max_cell) ORDER BY 1;
----
1	800.00
2	800.00
3	700.00
4	700.00

query TR
SELECT * FROM SEMANTIC_VIEW(sales_multi DIMENSIONS orders.category METRICS max_cell) ORDER BY 1;
----
Clothing	500.00
Electronics	800.00

statement error
SELECT * FROM SEMANTIC_VIEW(sales_multi FACTS rev_by_region_cat);
----
private

# L30b: nor in an ad-hoc aggregate.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_multi METRICS MAX(rev_by_region_cat));
----
private

# L31: two inline LOD expressions in one metric, and an inline one under
# FILTER. North: Alice's 4 orders less North's 6;
# South: Carol's 3 less South's 4.
statement ok
CREATE SEMANTIC VIEW sales_two_m
  TABLES (c AS customers PRIMARY KEY (customer_id), o AS orders)
  RELATIONSHIPS (o(customer_id) REFERENCES c)
  DIMENSIONS (c.customer_id AS customer_id, c.region AS region, o.order_id AS order_id)
  METRICS (
    spread AS MAX(COUNT(o.order_id) FIXED DIMENSIONS (c.customer_id)) - MIN(COUNT(o.order_id) FIXED DIMENSIONS (c.region))
  );

query TI
SELECT * FROM SEMANTIC_VIEW(sales_two_m DIMENSIONS c.region METRICS spread) ORDER BY 1;
----
North	-2
South	-1

statement ok
CREATE SEMANTIC VIEW sales_two_f
  TABLES (c AS customers PRIMARY KEY (customer_id), o AS orders)
  RELATIONSHIPS (o(customer_id) REFERENCES c)
  DIMENSIONS (c.customer_id AS customer_id, c.region AS region, o.order_id AS order_id)
  METRICS (busy AS AVG(COUNT(o.order_id) FIXED DIMENSIONS (c.customer_id)) FILTER (WHERE true));

query TR
SELECT * FROM SEMANTIC_VIEW(sales_two_f DIMENSIONS c.region METRICS busy) ORDER BY 1;
----
North	3.0
South	2.0

# The same view with aliases other than the table names, and LOD members.
statement ok
CREATE SEMANTIC VIEW sales_two
  TABLES (c AS customers PRIMARY KEY (customer_id), o AS orders)
  RELATIONSHIPS (o(customer_id) REFERENCES c)
  FACTS (o.order_amount AS amount, opc AS COUNT(o.order_id) FIXED DIMENSIONS (c.customer_id))
  DIMENSIONS (c.customer_id AS customer_id, c.region AS region, o.order_id AS order_id,
    obr AS COUNT(o.order_id) FIXED DIMENSIONS (c.region))
  METRICS (avg_opc AS AVG(opc));

# L31b: DESCRIBE names the fixed dimensions' table as its TABLE rows do.
query TTT
SELECT object_name, property, property_value FROM (DESCRIBE SEMANTIC VIEW sales_two)
WHERE object_name IN ('obr', 'region') AND property IN ('TABLE', 'FIXED_DIMENSIONS') ORDER BY 1, 2;
----
obr	FIXED_DIMENSIONS	[["customers","region"]]
region	TABLE	customers

# L31c: an ad-hoc LOD metric reads only the view's members.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_two METRICS MAX(opc) + SUM(o.undeclared));
----
is not a dimension, fact or metric

# L31d: the YAML export writes an LOD member with no source_table, and CREATE
# FROM YAML reads it back.
query T
SELECT READ_YAML_FROM_SEMANTIC_VIEW('sales_two') LIKE '%name: obr%expr: COUNT(o.order_id) FIXED DIMENSIONS (c.region)%source_table: null%';
----
true

statement ok
CREATE SEMANTIC VIEW sales_yaml FROM YAML $$
tables:
- alias: c
  table: customers
  pk_columns: [customer_id]
- alias: o
  table: orders
joins:
- table: c
  from_alias: o
  fk_columns: [customer_id]
facts:
- name: opc
  expr: COUNT(o.order_id) FIXED DIMENSIONS (c.customer_id)
dimensions:
- name: customer_id
  expr: customer_id
  source_table: c
- name: region
  expr: region
  source_table: c
- name: order_id
  expr: order_id
  source_table: o
- name: obr
  expr: COUNT(o.order_id) FIXED DIMENSIONS (c.region)
metrics:
- name: avg_opc
  expr: AVG(opc)
$$;

query TIR
SELECT * FROM SEMANTIC_VIEW(sales_yaml DIMENSIONS c.region, obr METRICS avg_opc) ORDER BY 1;
----
North	6	3.0
South	4	2.0

# Edge data (fixture 11b): Eve (North) has no orders; order 111 has no customer,
# and order 112 a customer no customers row has.
statement ok
INSERT INTO customers VALUES (5, 'Eve', 'North', 'Premium');

statement ok
INSERT INTO orders VALUES (111, NULL, 'Clothing', 50), (112, 99, 'Clothing', 70);

statement ok
CREATE SEMANTIC VIEW sales_edge
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (
    orders.order_amount AS amount,
    orders_per_customer AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),
    grand_total_revenue AS SUM(orders.order_amount) FIXED DIMENSIONS ()
  )
  DIMENSIONS (
    customers.customer_id AS customer_id, customers.region AS region,
    orders.order_id AS order_id, orders.category AS category
  )
  METRICS (
    orders.total_revenue AS SUM(amount),
    customers.customer_count AS COUNT(customers.customer_id),
    avg_orders_per_customer AS AVG(orders_per_customer),
    pct_of_total AS SUM(orders.order_amount) / AVG(grand_total_revenue)
  );

# E1: Eve, with no orders, is left out; the two orders with no customer row are
# one NULL customer with 2 orders, in the NULL region.
query TRIR
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.region METRICS avg_orders_per_customer, customers.customer_count, orders.total_revenue) ORDER BY 1 NULLS LAST;
----
North	3.0	3	1300.00
South	2.0	2	800.00
NULL	2.0	NULL	120.00

# E2
query R
SELECT * FROM SEMANTIC_VIEW(sales_edge METRICS avg_orders_per_customer);
----
2.4

# E3
query IR
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.customer_id METRICS avg_orders_per_customer) ORDER BY 1 NULLS LAST;
----
1	4.0
2	2.0
3	3.0
4	1.0
NULL	2.0

# E4: the grand total counts every order (2220). Snowflake gives the NULL region
# NULL here, and 2 in E1 for the same rows; we give its share, 120 / 2220
# (TECH-DEBT #114, an accepted divergence).
query TRR
SELECT region, total_revenue, round(pct_of_total, 4) FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.region METRICS orders.total_revenue, pct_of_total) ORDER BY 1 NULLS LAST;
----
North	1300.00	0.5856
South	800.00	0.3604
NULL	120.00	0.0541

# E7: an LOD fact alone in FACTS, one row per fixed-grain value.
query I
SELECT * FROM SEMANTIC_VIEW(sales_edge FACTS orders_per_customer) ORDER BY 1;
----
1
2
2
3
4

# E8: beside an order fact, one row per order. The orders with no customer row
# carry the NULL customer's count, 2, where Snowflake gives NULL (as E4,
# TECH-DEBT #114).
query IRII
SELECT order_id, order_amount, orders_per_customer, grand_total_revenue FROM SEMANTIC_VIEW(sales_edge FACTS orders.order_id, orders.order_amount, orders_per_customer, grand_total_revenue) WHERE order_id >= 110 ORDER BY 1;
----
110	200.00	1	2220
111	50.00	2	2220
112	70.00	2	2220

# Refusals at CREATE, as Snowflake refuses them.

# L21: a metric with a table prefix cannot read an LOD expression (010946).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (orders.avg_orders AS AVG(opc));
----
metric 'avg_orders' has a table prefix and reads LOD expression 'opc'

# L21b: nor hold one inline.
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (orders.avg_orders AS AVG(COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id)));
----
metric 'avg_orders' has a table prefix and holds an inline LOD expression

# L21c: an LOD fact is declared without a table prefix.
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (orders.opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (avg_orders AS AVG(opc));
----
fact 'opc' is an LOD expression with a table prefix

# L22b: an LOD expression cannot read another (010952).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (
    opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),
    opc2 AS SUM(opc) FIXED DIMENSIONS (customers.region)
  )
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region, orders.order_id AS order_id)
  METRICS (avg_opc2 AS AVG(opc2));
----
LOD fact 'opc2' reads another LOD expression

# L22c: an LOD expression aggregates facts and dimensions, not a column (010943).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (rpc AS SUM(orders.amount) FIXED DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id)
  METRICS (avg_rpc AS AVG(rpc));
----
LOD fact 'rpc' reads 'orders.amount', which is no fact or dimension of the view

# L23: FIXED DIMENSIONS names dimensions, not expressions (000002).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id + 1))
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (avg_opc AS AVG(opc));
----
Only a dimension or fact the view defines can be listed there, not an expression

# L24b: one LOD expression per aggregate call (010951).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (
    orders.order_amount AS amount,
    opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),
    rpc AS SUM(orders.order_amount) FIXED DIMENSIONS (customers.customer_id)
  )
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (avg_ratio AS AVG(rpc / opc));
----
reads two LOD expressions in one aggregate call

# L24d: FIXED DIMENSIONS cannot list an LOD dimension (010945).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (opc AS COUNT(orders.order_id) FIXED DIMENSIONS (obr))
  DIMENSIONS (customers.region AS region, orders.order_id AS order_id, obr AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.region))
  METRICS (avg_opc AS AVG(opc));
----
lists LOD expression 'obr' in FIXED DIMENSIONS

# L24f: an LOD expression is read inside an aggregate.
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (raw_opc AS opc * 2);
----
metric 'raw_opc' reads LOD expression 'opc' outside an aggregate call

# L24g: an LOD expression's fixed dimensions are on its table or a table it references.
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (cpc AS COUNT(customers.customer_id) FIXED DIMENSIONS (orders.category))
  DIMENSIONS (customers.customer_id AS customer_id, orders.category AS category)
  METRICS (avg_cpc AS AVG(cpc));
----
which are not related along foreign keys

# L24j: an LOD clause inside a larger expression is no LOD fact.
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (orders.order_amount AS amount, x AS SUM(orders.order_amount) + (COUNT(orders.order_id) FIXED DIMENSIONS ()))
  DIMENSIONS (customers.region AS region)
  METRICS (m AS AVG(x));
----
fact 'x' holds an LOD expression inside a larger expression

# L24k: a stray comma in FIXED DIMENSIONS is refused, as in any DDL list; one
# trailing comma is tolerated, as in any DDL list (L24l).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (x AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.region,,orders.order_id))
  DIMENSIONS (customers.region AS region, orders.order_id AS order_id)
  METRICS (m AS AVG(x));
----
has an empty entry in FIXED DIMENSIONS

# L24l: one trailing comma in FIXED DIMENSIONS is tolerated.
statement ok
CREATE SEMANTIC VIEW sales_trailing
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (x AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.region,))
  DIMENSIONS (customers.region AS region, orders.order_id AS order_id)
  METRICS (m AS AVG(x));

statement ok
DROP SEMANTIC VIEW sales_trailing;

# L24h: INCLUDE and EXCLUDE DIMENSIONS are not supported yet (TECH-DEBT #113,
# Phase 8.5b).
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (nic AS COUNT(orders.order_id) INCLUDE DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id)
  METRICS (avg_nic AS AVG(nic));
----
uses INCLUDE DIMENSIONS, which this version does not support yet

# L24i: LOD expressions are not supported in materializations.
statement error
CREATE SEMANTIC VIEW sales_bad
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders)
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  DIMENSIONS (customers.region AS region, orders.order_id AS order_id, obr AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.region))
  METRICS (orders.order_count AS COUNT(orders.order_id))
  MATERIALIZATIONS (m AS (TABLE agg_t DIMENSIONS (obr) METRICS (order_count)));
----
LOD expressions are not supported in materializations

# M16: an LOD expression across a direct many-to-many relationship (fixture 11b).
statement ok
CREATE TABLE m_orders (order_id INTEGER, customer_id INTEGER, promo_code VARCHAR, amount DECIMAL(10,2));

statement ok
CREATE TABLE m_promotions (promo_code VARCHAR, channel VARCHAR, region VARCHAR);

statement ok
CREATE TABLE m_customers (customer_id INTEGER, segment VARCHAR);

statement ok
INSERT INTO m_orders VALUES (1, 1, 'P', 100), (2, 2, 'P', 200), (3, 1, 'Q', 50), (4, 2, 'NONE', 999), (5, 99, 'Q', 75);

statement ok
INSERT INTO m_promotions VALUES ('P', 'Web', 'East'), ('P', 'Web', 'East'), ('P', 'Email', 'East'), ('Q', 'Web', 'West');

statement ok
INSERT INTO m_customers VALUES (1, 'Enterprise'), (2, 'SMB');

statement ok
CREATE SEMANTIC VIEW m2m_lod
  TABLES (orders AS m_orders PRIMARY KEY (order_id), promotions AS m_promotions, customers AS m_customers PRIMARY KEY (customer_id))
  RELATIONSHIPS (
    orders_to_promotions AS orders(promo_code) REFERENCES promotions(promo_code),
    orders_to_customers AS orders(customer_id) REFERENCES customers
  )
  FACTS (orders.amount AS amount, opc AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id))
  DIMENSIONS (orders.order_id AS order_id, promotions.channel AS channel, customers.customer_id AS customer_id, customers.segment AS segment)
  METRICS (orders.total_amount AS SUM(orders.amount), avg_opc AS AVG(opc));

# M16q: refused (010959).
statement error
SELECT * FROM SEMANTIC_VIEW(m2m_lod DIMENSIONS promotions.channel METRICS avg_opc);
----
reaches across many-to-many relationship 'orders_to_promotions'

# M16b: not across it. Customer 99 has no customers row, so its order is a NULL
# customer of 1.
query TR
SELECT * FROM SEMANTIC_VIEW(m2m_lod DIMENSIONS customers.segment METRICS avg_opc) ORDER BY 1 NULLS LAST;
----
Enterprise	2.0
SMB	2.0
NULL	1.0

# M16c: across it through the filter.
statement error
SELECT * FROM SEMANTIC_VIEW(m2m_lod DIMENSIONS customers.segment METRICS avg_opc WHERE promotions.channel = 'Web');
----
reaches across many-to-many relationship 'orders_to_promotions'

# M16d: beside an ordinary metric that crosses it.
statement error
SELECT * FROM SEMANTIC_VIEW(m2m_lod DIMENSIONS promotions.channel METRICS orders.total_amount, avg_opc);
----
reaches across many-to-many relationship 'orders_to_promotions'
