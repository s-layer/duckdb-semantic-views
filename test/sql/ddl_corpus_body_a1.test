# --- depth-0 entry splitting (split_at_depth0_commas) ---

# B-001: body_parser/mod.rs::split_simple_three_entries — three comma-separated entries become three members
statement ok
CREATE SEMANTIC VIEW dcb_split3 AS
TABLES (o AS dcb_orders PRIMARY KEY (id))
DIMENSIONS (o.a AS o.a, o.b AS o.b, o.c AS o.c);

query T nosort
SELECT * FROM dcb_ddl('dcb_split3');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_split3 AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.a AS o.a,
    o.b AS o.b,
    o.c AS o.c
)

# B-002: body_parser/mod.rs::split_nested_parens_not_split — a comma inside a function call's parens does not split the entry
statement ok
CREATE SEMANTIC VIEW dcb_split_paren AS
TABLES (o AS dcb_orders PRIMARY KEY (id))
METRICS (o.s AS SUM(coalesce(o.a, o.b)), o.n AS COUNT(*));

query T nosort
SELECT * FROM dcb_ddl('dcb_split_paren');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_split_paren AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
METRICS (
    o.s AS SUM(coalesce(o.a, o.b)),
    o.n AS COUNT(*)
)

