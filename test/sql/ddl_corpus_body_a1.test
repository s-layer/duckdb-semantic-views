TABLES (
    o AS dcb_orders
)
DIMENSIONS (
    o.a AS $$p,q.r AS s$$
)

# B-016: body_parser/mod.rs::dollar_quoted_metric_keyword_is_inert — USING inside a derived metric's $$...$$ is not a USING clause
statement ok
CREATE SEMANTIC VIEW dcb_dq_metric AS
TABLES (o AS dcb_orders)
METRICS (m AS $$a USING b$$);

query T nosort
SELECT * FROM dcb_ddl('dcb_dq_metric');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_dq_metric AS
TABLES (
    o AS dcb_orders
)
METRICS (
    m AS $$a USING b$$
)

# no USING relationship was recorded: the metric is a plain derived metric
query TTTT rowsort
SELECT object_kind, object_name, property, property_value FROM describe_semantic_view('dcb_dq_metric') WHERE object_kind <> 'TABLE' AND property <> 'DATA_TYPE';
----
DERIVED_METRIC	m	ACCESS_MODIFIER	PUBLIC
DERIVED_METRIC	m	EXPRESSION	$$a USING b$$

