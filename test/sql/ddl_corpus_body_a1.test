# --- pre-AS metric clauses written after AS (TECH-DEBT #38) ---

# B-019: body_parser/mod.rs::non_additive_by_after_as_is_rejected — control: NON ADDITIVE BY (...) in its place, before AS
statement ok
CREATE SEMANTIC VIEW dcb_nab_ok AS
TABLES (o AS dcb_orders PRIMARY KEY (id))
DIMENSIONS (o.d AS o.d)
METRICS (o.m NON ADDITIVE BY (d) AS sum(o.v));

query T nosort
SELECT * FROM dcb_ddl('dcb_nab_ok');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_nab_ok AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.d AS o.d
)
METRICS (
    o.m NON ADDITIVE BY (d NULLS LAST) AS sum(o.v)
)

# B-020: body_parser/mod.rs::non_additive_by_after_as_is_rejected — NON ADDITIVE BY (...) after AS is rejected, not swallowed into the expression (near miss of B-019) [text]
statement error
CREATE SEMANTIC VIEW dcb_nab_after AS
TABLES (o AS dcb_orders PRIMARY KEY (id))
DIMENSIONS (o.d AS o.d)
METRICS (o.m AS sum(o.v) NON ADDITIVE BY (d));
----
'NON ADDITIVE BY (...)' must come BEFORE 'AS' in a metric entry

