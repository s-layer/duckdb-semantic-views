# B-026: body_parser/mod.rs::a_genuinely_nested_using_is_not_a_misplaced_clause — a USING inside a subquery JOIN in the expression is SQL, not a misplaced clause
statement ok
CREATE SEMANTIC VIEW dcb_nested_using AS
TABLES (o AS dcb_orders PRIMARY KEY (id))
DIMENSIONS (o.d AS o.d)
METRICS (o.m AS sum(CASE WHEN o.id IN (SELECT a.id FROM dcb_x a JOIN dcb_y b USING (id)) THEN o.v ELSE 0 END));

query T nosort
SELECT * FROM dcb_ddl('dcb_nested_using');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_nested_using AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.d AS o.d
)
METRICS (
    o.m AS sum(CASE WHEN o.id IN (SELECT a.id FROM dcb_x a JOIN dcb_y b USING (id)) THEN o.v ELSE 0 END)
)

