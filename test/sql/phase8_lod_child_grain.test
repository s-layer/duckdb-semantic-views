# Q1h, Q1i: SHOW ... FOR METRIC lists the child table's dimension.
query TT
SELECT table_name, name FROM (SHOW SEMANTIC DIMENSIONS IN sales_child_14 FOR METRIC avg_customer_rev) ORDER BY 1, 2;
----
customers	customer_id
customers	region
order_returns_14	reason
orders	order_id

query TT
