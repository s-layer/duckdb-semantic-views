# F1, F2: FIXED by the returns' reason, alone or beside a plain metric. The
# customers are grouped by their returns' reasons, and the NULL group is the
# customers with a NULL-reason return (1) or none at all (2, 4): customer 3's
# orders with no return don't put it there.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS avg_orders_fixed) ORDER BY 1 NULLS LAST;
----
damaged	3.5
late	4.0
NULL	2.3333333333333335

query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS orders.total_revenue, avg_orders_fixed) ORDER BY 1 NULLS LAST;
----
damaged	700.00	3.5
late	900.00	4.0
