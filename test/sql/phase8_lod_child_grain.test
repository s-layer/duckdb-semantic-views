damaged	2	350.0
late	4	1100.0
NULL	1	100.0

# Only a plain metric on the expression's own home table changes its rows
# (fixture 14e, E-labels). E3: beside plain metrics on the orders and on the
# returns, in either order, the orders' rows.
query TRIR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS orders.total_revenue, order_returns.return_count, avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	700.00	2	350.0
late	900.00	4	900.0
NULL	900.00	1	225.0

query TIRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS order_returns.return_count, orders.total_revenue, avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	2	700.00	350.0
late	4	900.00	900.0
