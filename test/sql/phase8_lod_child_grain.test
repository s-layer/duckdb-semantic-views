# C7: beside another INCLUDE metric and no plain one, both as alone.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS avg_customer_rev, max_order_rev) ORDER BY 1 NULLS LAST;
----
damaged	350.0	400.00
late	1100.0	400.00
NULL	100.0	100.00

# A return of an order that is not there (an orphan) is one of the rows too,
# joined up to a NULL order: EXCLUDE with no dimensions, filtered to it alone,
# counts no order rather than finding no row. (The rule of 14c's plans,
# applied to a shape the fixtures had no data for.)
statement ok
CREATE TABLE order_returns_orph (return_id INTEGER, order_id INTEGER, reason VARCHAR);

statement ok
INSERT INTO order_returns_orph VALUES (1, 101, 'damaged'), (2, 999, 'lost');

statement ok
CREATE SEMANTIC VIEW sales_child_orph
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    order_returns AS order_returns_orph PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  DIMENSIONS (customers.customer_id AS customer_id, orders.order_id AS order_id,
    order_returns.reason AS reason)
  METRICS (orders_excl_customer AS SUM(COUNT(orders.order_id) EXCLUDE DIMENSIONS (customers.customer_id)));

query I
SELECT * FROM SEMANTIC_VIEW(sales_child_orph METRICS orders_excl_customer WHERE order_returns.reason = 'lost');
----
0

query I
SELECT * FROM SEMANTIC_VIEW(sales_child_orph METRICS orders_excl_customer WHERE order_returns.reason = 'damaged');
----
1

# Fixture 14 (one return per order and reason), each query run on its own.
statement ok
CREATE SEMANTIC VIEW sales_child_14
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    order_returns AS order_returns_14 PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  FACTS (
    orders.order_amount AS amount,
    num_orders_incl_customer AS COUNT(orders.order_id) INCLUDE DIMENSIONS (customers.customer_id),
    region_total_excl_customer AS SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.customer_id)
  )
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region,
    orders.order_id AS order_id, order_returns.reason AS reason)
  METRICS (
    avg_orders_incl_customer AS AVG(num_orders_incl_customer),
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)),
    region_rev_via_exclude AS AVG(region_total_excl_customer)
  );

