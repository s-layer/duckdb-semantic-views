regions

# Fixture 14f (H-labels): beside a plain metric, the values are matched to
# every child row with their key, joined up, and the query's WHERE applies
# after. A value no child row has the key of gets NULL dimensions, which the
# WHERE then keeps or drops; one whose child rows the WHERE all drops is lost.
# Return 8 is an orphan (no order 999); orders_f adds a category.
statement ok
CREATE TABLE orders_f AS SELECT o.*, CASE WHEN order_id IN (101, 102, 105, 107, 108, 110) THEN 'Electronics' ELSE 'Clothing' END AS category FROM orders o;

statement ok
CREATE TABLE order_returns_f AS SELECT * FROM order_returns;

statement ok
INSERT INTO order_returns_f VALUES (8, 999, 'lost');

statement ok
CREATE SEMANTIC VIEW sales_child_f
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders_f PRIMARY KEY (order_id),
    order_returns AS order_returns_f PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  FACTS (
    orders.order_amount AS amount,
    region_total_excl_customer AS SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.customer_id)
  )
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region,
    orders.category AS category, orders.order_id AS order_id, order_returns.reason AS reason)
  METRICS (
    orders.total_revenue AS SUM(amount),
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)),
    region_rev_via_exclude AS AVG(region_total_excl_customer),
    avg_orders_fixed AS AVG(COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id))
  );

# H1: customer 2's 300 has no return, so its NULL-dimension row fails
# region = 'North' and is dropped: NULL is customer 1's 100 alone.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS order_returns.reason METRICS orders.total_revenue, avg_customer_rev WHERE customers.region = 'North') ORDER BY 1 NULLS LAST;
----
damaged	400.00	400.0
late	900.00	900.0
NULL	400.00	100.0

# H2: the same by region too: no NULL/NULL row.
query TTRR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS customers.region, order_returns.reason METRICS orders.total_revenue, avg_customer_rev WHERE customers.region = 'North') ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
North	damaged	400.00	400.0
North	late	900.00	900.0
North	NULL	400.00	100.0

# H3: no Electronics order's return has a NULL reason, so the NULL group has
# no LOD value.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS order_returns.reason METRICS orders.total_revenue, avg_customer_rev WHERE orders.category = 'Electronics') ORDER BY 1 NULLS LAST;
----
damaged	700.00	350.0
late	600.00	600.0
NULL	600.00	NULL

# H4: EXCLUDE, the same filter.
query TTRR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS customers.region, order_returns.reason METRICS orders.total_revenue, region_rev_via_exclude WHERE orders.category = 'Electronics') ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
North	damaged	400.00	400.0
North	late	600.00	600.0
North	NULL	200.00	NULL
South	damaged	300.00	300.0
South	NULL	400.00	NULL

# H5: reason IS NULL holds on the NULL-dimension rows, so customers 2 and 4
# (no returns) land in the NULL group; customer 3's 300 is claimed by its
# 'damaged' return, which the filter drops, so it is lost: avg(300, 200).
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS customers.region METRICS orders.total_revenue, avg_customer_rev WHERE order_returns.reason IS NULL) ORDER BY 1 NULLS LAST;
----
North	400.00	100.0
South	500.00	NULL
NULL	NULL	250.0

# H6a: alone, the orphan return makes a 'lost' group with no value.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS order_returns.reason METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	350.0
late	1100.0
lost	NULL
NULL	100.0

# H6b: beside a plain metric the values come from the orders: no 'lost' row.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS order_returns.reason METRICS orders.total_revenue, avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	700.00	350.0
late	900.00	900.0
NULL	900.00	225.0

# Fixture 14g (J-labels): FIXED read through the child table follows the same
# rule. Each customer's order count (c1 4, c2 2, c3 3, c4 1) is matched to the
# returns with its customer; one with no return (c2, c4) gets NULL dimensions,
# and the WHERE applies after. It used to be read through the orders as well,
# which put c3 (orders 108, 109 have no return) in South's NULL group.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child_f DIMENSIONS order_returns.reason METRICS avg_orders_fixed) ORDER BY 1 NULLS LAST;
----
damaged	3.5
late	4.0
NULL	2.3333333333333335

