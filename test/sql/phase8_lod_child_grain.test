regions

# Unnamed relationships: Snowflake names each SYS_RELATIONSHIP_<uuid> at
# random on every CREATE, so its path changes between CREATEs (14d V7, V9,
# V11). Ours are named from each entry, so the view always takes the same
# one of the two paths: here orders -> customers (SYS_RELATIONSHIP_30ce...)
# sorts before orders -> stores (SYS_RELATIONSHIP_9b44...).
statement ok
CREATE SEMANTIC VIEW sd_unnamed
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    stores AS stores PRIMARY KEY (store_id), regions AS regions PRIMARY KEY (region))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, orders(store_id) REFERENCES stores,
    customers(region) REFERENCES regions, stores(region) REFERENCES regions)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, stores.store_id AS store_id, regions.manager AS manager)
  METRICS (avg_store_rev_excl AS AVG(SUM(orders.order_amount) EXCLUDE DIMENSIONS (stores.store_id)));

query TR
SELECT * FROM SEMANTIC_VIEW(sd_unnamed DIMENSIONS regions.manager METRICS avg_store_rev_excl) ORDER BY 1 NULLS LAST;
----
Nina	1300.0
Sam	800.0

# Fixture 14e G-labels: the paths compare by their relationship names from
# the orders, the first that differs deciding, whatever their length.
statement ok
CREATE TABLE stores_d (store_id INTEGER, district_id INTEGER);

statement ok
CREATE TABLE districts (district_id INTEGER, region VARCHAR);

statement ok
INSERT INTO stores_d VALUES (1, 1), (2, 2);

