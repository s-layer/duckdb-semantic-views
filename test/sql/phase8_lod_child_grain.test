customers	region
order_returns_14	reason
orders	order_id

# A diamond: orders reach regions through customers and through stores
# (fixture 14d, D-labels). Snowflake refuses a plain metric by the far table
# (010246), and answers an INCLUDE or EXCLUDE one along the path whose first
# relationship out of the orders has the smaller name, whatever the order
# they are declared in. A table the query needs on the other path is joined
# to regions too, so an order whose customer and store are in different
# regions has no manager. By the customers: Nina 1300, Sam 800; by the
# stores: Nina 1000, Sam 1100.
statement ok
CREATE TABLE stores (store_id INTEGER, region VARCHAR);

statement ok
CREATE TABLE regions (region VARCHAR, manager VARCHAR);

statement ok
INSERT INTO stores VALUES (1, 'North'), (2, 'South');

statement ok
INSERT INTO regions VALUES ('North', 'Nina'), ('South', 'Sam');

statement ok
CREATE SEMANTIC VIEW sd_cust_first
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    stores AS stores PRIMARY KEY (store_id), regions AS regions PRIMARY KEY (region))
  RELATIONSHIPS (a_ord_cust AS orders(customer_id) REFERENCES customers, b_ord_store AS orders(store_id) REFERENCES stores,
    a_cust_reg AS customers(region) REFERENCES regions, b_store_reg AS stores(region) REFERENCES regions)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, stores.store_id AS store_id, regions.manager AS manager)
  METRICS (
    orders.total_revenue AS SUM(amount),
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)),
    avg_store_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (stores.store_id)),
    avg_store_rev_excl AS AVG(SUM(orders.order_amount) EXCLUDE DIMENSIONS (stores.store_id)),
    avg_cust_rev_excl AS AVG(SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.customer_id))
  );

# D1: EXCLUDE store by manager, through the customers.
query TR
SELECT * FROM SEMANTIC_VIEW(sd_cust_first DIMENSIONS regions.manager METRICS avg_store_rev_excl) ORDER BY 1 NULLS LAST;
----
Nina	1300.0
Sam	800.0

# D2: INCLUDE customer, through the customers.
query TR
SELECT * FROM SEMANTIC_VIEW(sd_cust_first DIMENSIONS regions.manager METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
Nina	650.0
Sam	400.0

# D3: INCLUDE store: the stores are on the other path, so regions is joined
# through both. Nina: store 1's orders by North customers (800); Sam: store
# 2's by South customers (600); the rest have no manager: store 2's 500 and
# store 1's 200 (350).
query TR
SELECT * FROM SEMANTIC_VIEW(sd_cust_first DIMENSIONS regions.manager METRICS avg_store_rev) ORDER BY 1 NULLS LAST;
----
Nina	800.0
Sam	600.0
NULL	350.0

# A plain metric by the far table stays refused (010246).
statement error
SELECT * FROM SEMANTIC_VIEW(sd_cust_first DIMENSIONS regions.manager METRICS orders.total_revenue);
----
regions

# SHOW ... FOR METRIC lists the far table's dimension for an LOD metric.
query T
SELECT name FROM (SHOW SEMANTIC DIMENSIONS IN sd_cust_first FOR METRIC avg_store_rev_excl) ORDER BY 1;
----
customer_id
manager
store_id

statement ok
CREATE SEMANTIC VIEW sd_store_first
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    stores AS stores PRIMARY KEY (store_id), regions AS regions PRIMARY KEY (region))
  RELATIONSHIPS (b_ord_cust AS orders(customer_id) REFERENCES customers, a_ord_store AS orders(store_id) REFERENCES stores,
    b_cust_reg AS customers(region) REFERENCES regions, a_store_reg AS stores(region) REFERENCES regions)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, stores.store_id AS store_id, regions.manager AS manager)
  METRICS (
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)),
    avg_store_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (stores.store_id)),
    avg_store_rev_excl AS AVG(SUM(orders.order_amount) EXCLUDE DIMENSIONS (stores.store_id))
  );

