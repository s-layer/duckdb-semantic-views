# INCLUDE and EXCLUDE DIMENSIONS grouped or filtered by a table below the
# expression's home table (TECH-DEBT #115), as Snowflake answers them.
#
# Snowflake fixtures 14, 14b and 14c (2026-11-17/18, EXPLAIN plans in 14c):
# such an expression is computed over the rows of the table its grain is
# listed from (the table a dimensions-only query of the query's dimensions and
# filter lists from), each row joined up to the home table, so an order with
# two returns in one group counts twice. The groups are that table's rows:
# orders with no return make no group, a return with a NULL reason makes a
# NULL group. Each case below is Snowflake's answer to the query run on its
# own (14c P-labels, 14 Q-labels), or beside a plain metric (14d C-labels),
# which changes the rows the value is computed over, with the filter applied
# after the values are matched to the child rows (14f H-labels). Across a
# diamond the expression follows the path Snowflake's relationship names pick
# (14d D-labels, 14e G-labels); a plain metric there stays refused (010246).

require semantic_views

statement ok
CREATE TABLE customers (customer_id INTEGER, name VARCHAR, region VARCHAR);

statement ok
CREATE TABLE orders (order_id INTEGER, customer_id INTEGER, store_id INTEGER, amount DECIMAL(10,2));

statement ok
CREATE TABLE order_returns (return_id INTEGER, order_id INTEGER, reason VARCHAR);

statement ok
CREATE TABLE order_returns_nn (return_id INTEGER, order_id INTEGER, reason VARCHAR);

statement ok
CREATE TABLE order_returns_14 (return_id INTEGER, order_id INTEGER, reason VARCHAR);

statement ok
INSERT INTO customers VALUES (1, 'Alice', 'North'), (2, 'Bob', 'North'), (3, 'Carol', 'South'), (4, 'Dan', 'South');

statement ok
INSERT INTO orders VALUES (101, 1, 1, 400), (102, 1, 1, 200), (103, 1, 2, 300), (104, 1, 2, 100),
  (105, 2, 1, 200), (106, 2, 2, 100), (107, 3, 2, 300), (108, 3, 1, 200), (109, 3, 2, 100), (110, 4, 2, 200);

# 102 is returned twice for 'late'; 104's return has a NULL reason.
statement ok
INSERT INTO order_returns VALUES (1, 101, 'damaged'), (2, 101, 'late'), (3, 103, 'late'), (4, 107, 'damaged'),
  (5, 102, 'late'), (6, 102, 'late'), (7, 104, NULL);

statement ok
INSERT INTO order_returns_nn SELECT * FROM order_returns WHERE reason IS NOT NULL;

# Fixture 14's returns: one each.
statement ok
INSERT INTO order_returns_14 VALUES (1, 101, 'damaged'), (2, 101, 'late'), (3, 103, 'late'), (4, 107, 'damaged');

statement ok
CREATE SEMANTIC VIEW sales_child
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    order_returns AS order_returns PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  FACTS (
    orders.order_amount AS amount,
    region_total_excl_customer AS SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.customer_id)
  )
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region,
    orders.order_id AS order_id, order_returns.reason AS reason)
  METRICS (
    orders.total_revenue AS SUM(amount),
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)),
    region_rev_via_exclude AS AVG(region_total_excl_customer),
    max_order_rev AS MAX(SUM(orders.order_amount) INCLUDE DIMENSIONS (orders.order_id)),
    order_returns.return_count AS COUNT(order_returns.return_id),
    customers.customer_count AS COUNT(customers.customer_id),
    avg_orders_fixed AS AVG(COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id))
  );

# P1: INCLUDE customer by reason. late is customer 1's four late return rows
# (101, 103, and 102 twice): 1100. The NULL group is 104's return alone.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	350.0
late	1100.0
NULL	100.0

# P3: EXCLUDE customer by reason (its grain: reason).
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS region_rev_via_exclude) ORDER BY 1 NULLS LAST;
----
damaged	700.0
late	1100.0
NULL	100.0

# P4: EXCLUDE customer by region and reason.
query TTR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.region, order_returns.reason METRICS region_rev_via_exclude) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
North	damaged	400.0
North	late	1100.0
North	NULL	100.0
South	damaged	300.0

# P5 (14b R5): INCLUDE order by reason; the NULL group is order 104 alone.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS max_order_rev) ORDER BY 1 NULLS LAST;
----
damaged	400.00
late	400.00
NULL	100.00

# P6: INCLUDE customer beside the customer itself.
query ITR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.customer_id, order_returns.reason METRICS avg_customer_rev) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
1	damaged	400.0
1	late	1100.0
1	NULL	100.0
3	damaged	300.0

# P7: INCLUDE customer by region and reason.
query TTR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.region, order_returns.reason METRICS avg_customer_rev) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
North	damaged	400.0
North	late	1100.0
North	NULL	100.0
South	damaged	300.0

# The metric's home grain is unchanged by the child table's existence: by
# region alone it is read from the orders, as before (fixture 14 Q1c).
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.region METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
North	650.0
South	400.0

# P2: over returns with no NULL reason there is no NULL group: orders with no
# return make no group.
statement ok
CREATE SEMANTIC VIEW sales_child_nn
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    order_returns AS order_returns_nn PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region, order_returns.reason AS reason)
  METRICS (
    orders.total_revenue AS SUM(amount),
    avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id))
  );

query TR
SELECT * FROM SEMANTIC_VIEW(sales_child_nn DIMENSIONS order_returns.reason METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	350.0
late	1100.0

# Beside a plain metric (fixture 14d, C-labels), the value is computed over
# that metric's rows instead: orders LEFT JOIN returns, each order once per
# group, so late is 900 (102 once), and the orders with no return fall in the
# NULL group. The value rows are matched to the groups the returns list, and
# a value whose group no return lists has NULL dimensions.

# C1: the NULL group is 104's 100 and the customers' orders with no return:
# customer 2's 300, 3's 300 and 4's 200 (225).
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS orders.total_revenue, avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	700.00	350.0
late	900.00	900.0
NULL	900.00	225.0

# C2: EXCLUDE beside a plain metric.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS orders.total_revenue, region_rev_via_exclude) ORDER BY 1 NULLS LAST;
----
damaged	700.00	700.0
late	900.00	900.0
NULL	900.00	900.0

# C3: no return lists South with a NULL reason, so South's 500 has NULL
# dimensions: South/NULL gets no value, and a NULL/NULL row has it.
query TTRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.region, order_returns.reason METRICS orders.total_revenue, region_rev_via_exclude) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
North	damaged	400.00	400.0
North	late	900.00	900.0
North	NULL	400.00	400.0
South	damaged	300.00	300.0
South	NULL	500.00	NULL
NULL	NULL	NULL	500.0

# C4: with no NULL-reason return the returns list no NULL group, but the
# value's NULL group meets the plain metric's.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_child_nn DIMENSIONS order_returns.reason METRICS orders.total_revenue, avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	700.00	350.0
late	900.00	900.0
NULL	900.00	225.0

# C8: customers 2, 3 and 4 have no NULL-reason return: their values (300,
# 300, 200) share the NULL/NULL row.
query ITRR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.customer_id, order_returns.reason METRICS orders.total_revenue, avg_customer_rev) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
1	damaged	400.00	400.0
1	late	900.00	900.0
1	NULL	100.00	100.0
2	NULL	300.00	NULL
3	damaged	300.00	300.0
3	NULL	300.00	NULL
4	NULL	200.00	NULL
NULL	NULL	NULL	266.6666666666667

# C5: beside a plain metric on the returns themselves, the rows are the
# returns, as alone.
query TIR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS order_returns.return_count, avg_customer_rev) ORDER BY 1 NULLS LAST;
