# --- A view dropped or renamed in an open transaction ----------------------

statement ok
CREATE SEMANTIC VIEW rt_kept AS
  TABLES (o AS rt_orders PRIMARY KEY (id))
  DIMENSIONS (o.region AS o.region)
  METRICS (o.total AS sum(o.amount));

statement ok
BEGIN;

statement ok
DROP SEMANTIC VIEW rt_kept;

statement error
SELECT * FROM SEMANTIC_VIEW(rt_kept METRICS total);
----
not found

# The other session still sees the committed view.

query I con2
SELECT * FROM SEMANTIC_VIEW(rt_kept METRICS total);
----
35

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
ALTER SEMANTIC VIEW rt_kept RENAME TO rt_renamed;

query I
SELECT * FROM SEMANTIC_VIEW(rt_renamed METRICS total);
----
35

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
ALTER SEMANTIC VIEW rt_kept RENAME TO rt_renamed;

statement error
SELECT * FROM SEMANTIC_VIEW(rt_kept METRICS total);
----
not found

statement ok
ROLLBACK;

# --- A view altered or replaced in an open transaction ---------------------
# Both update the stored row in place.

statement ok
BEGIN;

statement ok
ALTER SEMANTIC VIEW rt_kept SET COMMENT = 'in flight';

query T
SELECT comment FROM list_semantic_views() WHERE name = 'rt_kept';
----
in flight

statement ok
ROLLBACK;

query T
SELECT coalesce(comment, '') = '' FROM list_semantic_views() WHERE name = 'rt_kept';
----
true

statement ok
BEGIN;

statement ok
CREATE OR REPLACE SEMANTIC VIEW rt_kept AS
  TABLES (o AS rt_orders PRIMARY KEY (id))
  DIMENSIONS (o.region AS o.region)
  METRICS (o.total AS max(o.amount));

query I
SELECT * FROM SEMANTIC_VIEW(rt_kept METRICS total);
----
20

statement ok
ROLLBACK;

query I
SELECT * FROM SEMANTIC_VIEW(rt_kept METRICS total);
----
35

# --- A source table changed in an open transaction -------------------------

statement ok
BEGIN;

statement ok
ALTER TABLE rt_orders ALTER amount TYPE DOUBLE;

query TT
SELECT name, data_type FROM (SHOW SEMANTIC METRICS IN rt_kept);
----
total	DOUBLE

query I
SELECT typeof(total) FROM SEMANTIC_VIEW(rt_kept METRICS total);
----
DOUBLE

statement ok
ROLLBACK;

query TT
SELECT name, data_type FROM (SHOW SEMANTIC METRICS IN rt_kept);
----
total	HUGEINT
