# B-176: body_parser/mod.rs::parse_relationships_quoted_paren_in_fk_column — a quoted `)` in an FK column and in a REFERENCES column does not truncate either list [text]
statement ok
CREATE SEMANTIC VIEW dcb_rel_qparen AS TABLES (o AS dcb_orders PRIMARY KEY (id), c AS dcb_customers PRIMARY KEY (id) UNIQUE ("a)b")) RELATIONSHIPS (rel AS o("x)y") REFERENCES c("a)b")) DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcb_ddl('dcb_rel_qparen');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_rel_qparen AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id),
    c AS dcb_customers PRIMARY KEY (id) UNIQUE ("a)b")
)
RELATIONSHIPS (
    rel AS o("x)y") REFERENCES c("a)b")
)
DIMENSIONS (
    o.region AS o.region
)

# both quoted columns survive whole
query TT rowsort
SELECT property, property_value FROM describe_semantic_view('dcb_rel_qparen') WHERE object_kind = 'RELATIONSHIP' AND property IN ('FOREIGN_KEY', 'REF_KEY');
----
FOREIGN_KEY	["\"x)y\""]
REF_KEY	["\"a)b\""]

