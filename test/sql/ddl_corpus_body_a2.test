# B-178: body_parser/mod.rs::parse_relationship_without_cardinality_defaults — no cardinality keyword: the relationship is stored as many-to-one
statement ok
CREATE SEMANTIC VIEW dcb_rel_default AS TABLES (o AS dcb_orders PRIMARY KEY (id), c AS dcb_customers PRIMARY KEY (id)) RELATIONSHIPS (rel AS o(fk) REFERENCES c) DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcb_ddl('dcb_rel_default');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_rel_default AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id),
    c AS dcb_customers PRIMARY KEY (id)
)
RELATIONSHIPS (
    rel AS o(fk) REFERENCES c
)
DIMENSIONS (
    o.region AS o.region
)

# the stored join carries no cardinality key: the many-to-one default (cardinality is inferred from PK/UNIQUE later)
query T nosort
SELECT rtrim(replace(regexp_extract(read_yaml_from_semantic_view('dcb_rel_default'), '(?s)joins:' || chr(10) || '(.*)facts:', 1), chr(10), ' '));
----
- table: c   from_alias: o   fk_columns:   - fk   ref_columns:   - id   name: rel

# B-179: body_parser/mod.rs::old_cardinality_keywords_rejected — a trailing `MANY TO ONE` cardinality keyword is rejected (near miss of B-178) [text]
statement error
CREATE SEMANTIC VIEW dcb_rel_card_many_to_one AS TABLES (o AS dcb_orders PRIMARY KEY (id), c AS dcb_customers PRIMARY KEY (id)) RELATIONSHIPS (rel AS o(fk) REFERENCES c MANY TO ONE) DIMENSIONS (o.region AS o.region);
----
'MANY TO ONE'. Cardinality is now inferred from PK/UNIQUE constraints; explicit keywords are no longer supported

# B-180: body_parser/mod.rs::old_cardinality_keywords_rejected — a trailing `ONE TO ONE` cardinality keyword is rejected (near miss of B-178) [text]
statement error
