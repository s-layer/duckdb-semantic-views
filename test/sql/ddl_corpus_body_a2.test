# --- metric entries: USING (...) ---

# B-138: body_parser/mod.rs::test_metric_using_then_non_additive_by_still_parses — USING (...) then NON ADDITIVE BY (...) before AS, in that order
statement ok
CREATE SEMANTIC VIEW dcb_using_nab AS
TABLES (o AS dcb_orders PRIMARY KEY (id), c AS dcb_customers PRIMARY KEY (id))
RELATIONSHIPS (r AS o(cid) REFERENCES c(id))
DIMENSIONS (o.d AS o.d)
METRICS (o.m USING (r) NON ADDITIVE BY (d) AS SUM(o.v));

query T nosort
SELECT * FROM dcb_ddl('dcb_using_nab');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_using_nab AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id),
    c AS dcb_customers PRIMARY KEY (id)
)
RELATIONSHIPS (
    r AS o(cid) REFERENCES c
)
DIMENSIONS (
