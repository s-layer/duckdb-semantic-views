# B-173: body_parser/mod.rs::parse_relationships_empty_body — RELATIONSHIPS () parses to no relationships
statement ok
CREATE SEMANTIC VIEW dcb_rel_empty AS TABLES (o AS dcb_orders PRIMARY KEY (id)) RELATIONSHIPS () DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcb_ddl('dcb_rel_empty');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_rel_empty AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.region AS o.region
)

# B-174: body_parser/mod.rs::parse_relationships_single_entry — name AS from(fk) REFERENCES to
statement ok
CREATE SEMANTIC VIEW dcb_rel_single AS TABLES (o AS dcb_orders PRIMARY KEY (id), c AS dcb_customers PRIMARY KEY (id)) RELATIONSHIPS (order_to_customer AS o(customer_id) REFERENCES c) DIMENSIONS (o.region AS o.region);

query T nosort
SELECT * FROM dcb_ddl('dcb_rel_single');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_rel_single AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id),
    c AS dcb_customers PRIMARY KEY (id)
)
RELATIONSHIPS (
    order_to_customer AS o(customer_id) REFERENCES c
)
DIMENSIONS (
    o.region AS o.region
)

# name, from table, FK columns and referenced table as parsed
query TTTT rowsort
SELECT object_name, parent_entity, property, property_value FROM describe_semantic_view('dcb_rel_single') WHERE object_kind = 'RELATIONSHIP';
----
order_to_customer	dcb_orders	FOREIGN_KEY	["customer_id"]
order_to_customer	dcb_orders	REF_KEY	["id"]
order_to_customer	dcb_orders	REF_TABLE	dcb_customers
order_to_customer	dcb_orders	TABLE	dcb_orders

