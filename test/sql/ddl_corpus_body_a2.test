# DDL accept/reject corpus, slice B (part a, file 2 of 2): the SQL-level port of the first 150
# `#[test]` functions in the `mod tests` block of `src/body_parser/mod.rs`
# (clause splitting, dollar-quoting, clause bounds, TABLES entries, trailing
# annotations, qualified entries, metric USING / NON ADDITIVE BY / OVER clauses,
# RELATIONSHIPS and MATERIALIZATIONS entries).
#
# Phase 3 of the PEG-parser epic replaces those hand-written scanners with DuckDB
# grammar productions and deletes their unit tests; every case they encode lives
# on here as a row run against the real extension. The case map (one line per Rust
# test, with its row ids or an N/A reason) is `_notes/phase3-corpus/map-B.md`.
# Row ids run across ddl_corpus_body_a1.test and ddl_corpus_body_a2.test.
#
# Row conventions (see `_notes/phase3-corpus/`):
#   `# B-nnn: <source>::<test_fn> — <what it pins>`
#   accept rows pin the stored definition through GET_DDL (one line per row);
#   rejects are near misses of an accepted statement earlier in this file;
#   `[syntax]` = `statement error` with an empty `----` block: only that it fails
#                (wording will change under the grammar, so none is pinned);
#   `[text]`   = today's text contract (quoting, stored whitespace, case) that a
#                grammar could plausibly change.

require semantic_views

# Fixtures, identical to part 1 (each .test file runs in a fresh database).

statement ok
CREATE MACRO dcb_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

statement ok
CREATE TABLE dcb_orders (
    id INTEGER, cid INTEGER, customer_id INTEGER, region VARCHAR, amount DOUBLE,
    v DOUBLE, d DATE, a INTEGER, b INTEGER, c INTEGER, note VARCHAR, country VARCHAR,
    "comment" VARCHAR, labels VARCHAR, commentary_col VARCHAR, "commenté" VARCHAR,
    x INTEGER, y INTEGER, qty INTEGER, t INTEGER, report_date DATE, balance DOUBLE,
    email VARCHAR, o_orderkey INTEGER, o_custkey INTEGER, order_date DATE,
    "order date" DATE, "my dim" VARCHAR, "a,b" INTEGER, "x)y" INTEGER,
    fk INTEGER, fk1 INTEGER, fk2 INTEGER, city VARCHAR
);

statement ok
CREATE TABLE dcb_customers (
    id INTEGER, k1 INTEGER, k2 INTEGER, "a)b" INTEGER, col1 INTEGER, col2 INTEGER, name VARCHAR
);

statement ok
CREATE TABLE dcb_lineitem (l_orderkey INTEGER, l_linenumber INTEGER, qty INTEGER);

statement ok
CREATE TABLE dcb_line_items (id INTEGER, qty INTEGER);

statement ok
CREATE TABLE dcb_x (id INTEGER);

statement ok
CREATE TABLE dcb_y (id INTEGER);

statement ok
CREATE TABLE "dcb my orders" (id INTEGER, c INTEGER);

statement ok
CREATE TABLE "dcb weird PRIMARY KEY name" (id INTEGER);

statement ok
CREATE TABLE "dcb fact stage" (id INTEGER, email VARCHAR);

statement ok
CREATE TABLE "dcb a""b" (id INTEGER);

statement ok
CREATE TABLE "dcb tbl)x" (id INTEGER, c INTEGER);

statement ok
CREATE TABLE "dcb CAFÉ" (id INTEGER);

statement ok
CREATE TABLE "dcb ΩΩ Ω" (id INTEGER);

statement ok
CREATE TABLE "dcb my tbl" (id INTEGER);

statement ok
CREATE TABLE "dcb pre)agg" (region VARCHAR, total DOUBLE);

statement ok
CREATE TABLE dcb_my_primary (id INTEGER);

statement ok
CREATE TABLE dcb_東京 (a INTEGER);

statement ok
CREATE TABLE dcb_preagg (d DATE, region VARCHAR, total DOUBLE);

statement ok
CREATE SCHEMA dcb_staging;

statement ok
CREATE TABLE dcb_staging."dcb my orders" (id INTEGER);

statement ok
CREATE SCHEMA dcb_sch;

statement ok
CREATE TABLE dcb_sch.dcb_t (id INTEGER);

statement ok
ATTACH ':memory:' AS "dcb my db";

statement ok
CREATE SCHEMA "dcb my db"."dcb schema";

statement ok
CREATE TABLE "dcb my db"."dcb schema"."dcb my table" (id INTEGER);

statement ok
CREATE SCHEMA "dcb my db".dcb_sch;

statement ok
CREATE TABLE "dcb my db".dcb_sch.dcb_t (id INTEGER);

# --- member annotations: COMMENT / WITH SYNONYMS ---

# B-104: body_parser/mod.rs::test_comment_annotation_non_ascii_payload_survives — a non-ASCII COMMENT payload is stored as written (no mojibake)
statement ok
CREATE SEMANTIC VIEW dcb_ann_cafe AS TABLES (o AS dcb_orders PRIMARY KEY (id)) METRICS (o.m AS SUM(o.amount) COMMENT = 'café et plus');

query T nosort
SELECT * FROM dcb_ddl('dcb_ann_cafe');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_ann_cafe AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
METRICS (
    o.m AS SUM(o.amount) COMMENT = 'café et plus'
)

# B-105: body_parser/mod.rs::test_synonyms_annotation_non_ascii_payload_survives — non-ASCII WITH SYNONYMS payloads are stored as written
statement ok
CREATE SEMANTIC VIEW dcb_ann_syn_utf8 AS TABLES (o AS dcb_orders PRIMARY KEY (id)) DIMENSIONS (o.city AS o.city WITH SYNONYMS = ('ciudad', 'stadt', '都市'));

query T nosort
SELECT * FROM dcb_ddl('dcb_ann_syn_utf8');
----
CREATE OR REPLACE SEMANTIC VIEW dcb_ann_syn_utf8 AS
TABLES (
    o AS dcb_orders PRIMARY KEY (id)
)
DIMENSIONS (
    o.city AS o.city WITH SYNONYMS = ('ciudad', 'stadt', '都市')
)

