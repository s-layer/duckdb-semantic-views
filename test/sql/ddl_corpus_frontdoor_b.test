TABLES (
    f AS dcf_flights PRIMARY KEY (id),
    a AS dcf_airports PRIMARY KEY (id)
)
RELATIONSHIPS (
    dep_rel AS f(airport_id) REFERENCES a
)
DIMENSIONS (
