# --- Hostile bodies through the CREATE OR REPLACE front door (create_front_door_proptest) ---
# One row per generator axis of tests/common/mod.rs::arb_canonical_def. The
# Rust property compares tables / dimensions / facts / metrics after
# plan_create; here GET_DDL pins all of them (and the joins and
# materializations the property skips). Base tables exist so the real front
# door's catalog checks pass.

statement ok
CREATE TABLE "dcf Hostile.Tbl" ("Key Col" INTEGER PRIMARY KEY, "AS" INTEGER, "comment" INTEGER, c VARCHAR, n INTEGER);

statement ok
CREATE TABLE "dcf PRIMARY KEY (id)" (id INTEGER PRIMARY KEY, fk_0_0 INTEGER, d2 VARCHAR);

statement ok
CREATE TABLE dcf_h2a (k1 INTEGER, k2 INTEGER, rc_0_0 INTEGER, rc_0_1 INTEGER, c VARCHAR, n INTEGER, PRIMARY KEY (k1, k2));

statement ok
CREATE TABLE dcf_h2b (fk_0_0 INTEGER, fk_0_1 INTEGER, n INTEGER);

statement ok
CREATE TABLE dcf_h2c (fk_1_0 INTEGER, fk_1_1 INTEGER);

# F-058: create_front_door_proptest.rs::create_front_door_accepts_hostile_bodies (quoted-identifier and payload axes) — quoted table / column / member / relationship names with spaces, dots, commas, uppercase, keywords (`AS`, `comment`, `PRIMARY KEY (id)`) and a doubled quote; COMMENT / SYNONYMS payloads with `--`, `/* */`, a backslash, a doubled quote and non-ASCII; string-literal and e'' escape-string expressions holding `--`, `/* */`, `,` and `\'`; PRIVATE, LABELS = (FILTER), USING, NON ADDITIVE BY ... DESC NULLS FIRST, MATERIALIZATIONS. Everything survives verbatim [text]
statement ok
CREATE OR REPLACE SEMANTIC VIEW rt_view AS
TABLES (
    t0 AS "dcf Hostile.Tbl" PRIMARY KEY ("Key Col") UNIQUE ("AS", "comment") COMMENT = 'has -- and /* inside */' WITH SYNONYMS = ('back\slash and '' quote', '東京☕'),
    t1 AS "dcf PRIMARY KEY (id)" PRIMARY KEY (id)
)
RELATIONSHIPS (
    "we""ird rel" AS t1(fk_0_0) REFERENCES t0
)
FACTS (
    PRIVATE t0."fact.X" AS (t0.n + 1) * 2 LABELS = (FILTER) COMMENT = 'it''s -- fine',
    t1.f2 AS e'it\'s, -- a /* b */' WITH SYNONYMS = ('wéird')
)
DIMENSIONS (
    t0."Dim, One" AS t0.c || ' -- not a comment' COMMENT = '/* nope */',
    t1.d2 AS 'x' || t1.d2 LABELS = (FILTER) WITH SYNONYMS = ('the PRIMARY KEY (id) lives here')
)
METRICS (
    t1.m1 USING ("we""ird rel") NON ADDITIVE BY ("Dim, One" DESC NULLS FIRST) AS SUM(t1.fk_0_0) COMMENT = 'μ',
    PRIVATE t1.m2 AS MAX('a,b')
)
MATERIALIZATIONS (
    mat_0 AS (TABLE mat_tbl_0, DIMENSIONS ("Dim, One"), METRICS (m1))
);

query T nosort
SELECT * FROM dcf_ddl('rt_view');
----
CREATE OR REPLACE SEMANTIC VIEW rt_view AS
TABLES (
    t0 AS "dcf Hostile.Tbl" PRIMARY KEY ("Key Col") UNIQUE ("AS", "comment") COMMENT = 'has -- and /* inside */' WITH SYNONYMS = ('back\slash and '' quote', '東京☕'),
    t1 AS "dcf PRIMARY KEY (id)" PRIMARY KEY (id)
)
RELATIONSHIPS (
    "we""ird rel" AS t1(fk_0_0) REFERENCES t0
)
FACTS (
    PRIVATE t0."fact.X" LABELS = (FILTER) AS (t0.n + 1) * 2 COMMENT = 'it''s -- fine',
    t1.f2 AS e'it\'s, -- a /* b */' WITH SYNONYMS = ('wéird')
)
DIMENSIONS (
    t0."Dim, One" AS t0.c || ' -- not a comment' COMMENT = '/* nope */',
    t1.d2 LABELS = (FILTER) AS 'x' || t1.d2 WITH SYNONYMS = ('the PRIMARY KEY (id) lives here')
)
METRICS (
    t1.m1 USING ("we""ird rel") NON ADDITIVE BY ("Dim, One" DESC NULLS FIRST) AS SUM(t1.fk_0_0) COMMENT = 'μ',
    PRIVATE t1.m2 AS MAX('a,b')
)
MATERIALIZATIONS (
    mat_0 AS (
        TABLE mat_tbl_0,
        DIMENSIONS ("Dim, One"),
        METRICS (m1)
    )
)

# F-059: create_front_door_proptest.rs::create_front_door_accepts_hostile_bodies (bare-identifier / arithmetic axes; OR REPLACE mode) — re-issuing CREATE OR REPLACE under the same name replaces F-058's body: composite PK, an explicit REF column list and an omitted one, three tables, escape-string backslashes, `||`, `-`, `*`, nested parens, AVG / COUNT / MIN, NON ADDITIVE BY ... ASC NULLS LAST (ASC is the default and is not re-rendered) [text]
statement ok
CREATE OR REPLACE SEMANTIC VIEW rt_view AS
TABLES (
    t0 AS dcf_h2a PRIMARY KEY (k1, k2) UNIQUE (rc_0_0, rc_0_1),
    t1 AS dcf_h2b,
    t2 AS dcf_h2c
)
RELATIONSHIPS (
    r_0 AS t1(fk_0_0, fk_0_1) REFERENCES t0(rc_0_0, rc_0_1),
    _r1 AS t2(fk_1_0, fk_1_1) REFERENCES t0
)
FACTS (
    t1.f_0 AS 1 - 2 * (t1.n),
    t0.f_1 AS e'a\\b\'c' LABELS = (FILTER)
)
DIMENSIONS (
    t0.d_0 AS 'it''s ' || t0.c,
    t2.d_1 AS 0
)
METRICS (
    t1.m_0 USING (r_0) NON ADDITIVE BY (d_0 ASC NULLS LAST) AS AVG((t1.n)),
    t0.m_1 AS COUNT(t0.n * 3) - MIN(t0.n)
);

query T nosort
SELECT * FROM dcf_ddl('rt_view');
----
CREATE OR REPLACE SEMANTIC VIEW rt_view AS
TABLES (
    t0 AS dcf_h2a PRIMARY KEY (k1, k2) UNIQUE (rc_0_0, rc_0_1),
    t1 AS dcf_h2b,
    t2 AS dcf_h2c
)
RELATIONSHIPS (
    r_0 AS t1(fk_0_0, fk_0_1) REFERENCES t0(rc_0_0, rc_0_1),
    _r1 AS t2(fk_1_0, fk_1_1) REFERENCES t0
)
FACTS (
    t1.f_0 AS 1 - 2 * (t1.n),
    t0.f_1 LABELS = (FILTER) AS e'a\\b\'c'
)
DIMENSIONS (
    t0.d_0 AS 'it''s ' || t0.c,
    t2.d_1 AS 0
)
METRICS (
    t1.m_0 USING (r_0) NON ADDITIVE BY (d_0 NULLS LAST) AS AVG((t1.n)),
    t0.m_1 AS COUNT(t0.n * 3) - MIN(t0.n)
)

query TTT
SELECT name, database_name, schema_name FROM list_semantic_views() WHERE name = 'rt_view';
----
rt_view	memory	main

