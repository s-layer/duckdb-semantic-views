# --- Relationships and USING (TEST-12) ---

# F-056: parse_proptest.rs::relationship_no_cardinality_defaults — a relationship with no cardinality keyword parses; the omitted REF key is inferred from the target's PRIMARY KEY
statement ok
CREATE SEMANTIC VIEW dcf_r1 AS TABLES (a1 AS dcf_orders PRIMARY KEY (id), a2 AS dcf_customers PRIMARY KEY (id)) RELATIONSHIPS (rel_x AS a1(customer_id) REFERENCES a2) DIMENSIONS (a1.r AS region) METRICS (a1.m AS SUM(amount));

query T nosort
SELECT * FROM dcf_ddl('dcf_r1');
----
CREATE OR REPLACE SEMANTIC VIEW dcf_r1 AS
TABLES (
    a1 AS dcf_orders PRIMARY KEY (id),
    a2 AS dcf_customers PRIMARY KEY (id)
)
RELATIONSHIPS (
    rel_x AS a1(customer_id) REFERENCES a2
)
DIMENSIONS (
    a1.r AS region
)
METRICS (
    a1.m AS SUM(amount)
)

query TTTTT nosort
SELECT * FROM describe_semantic_view('dcf_r1') WHERE object_kind = 'RELATIONSHIP';
----
RELATIONSHIP	rel_x	dcf_orders	TABLE	dcf_orders
RELATIONSHIP	rel_x	dcf_orders	REF_TABLE	dcf_customers
RELATIONSHIP	rel_x	dcf_orders	FOREIGN_KEY	["customer_id"]
RELATIONSHIP	rel_x	dcf_orders	REF_KEY	["id"]

# F-057: parse_proptest.rs::metric_using_clause_roundtrip — USING in lower / mixed / upper case attaches the named relationship to the metric; GET_DDL renders it upper case
statement ok
CREATE SEMANTIC VIEW dcf_u1 AS TABLES (f AS dcf_flights PRIMARY KEY (id), a AS dcf_airports PRIMARY KEY (id)) RELATIONSHIPS (dep_rel AS f(airport_id) REFERENCES a) DIMENSIONS (a.name AS airport_name) METRICS (f.flight_cnt using (dep_rel) AS COUNT(*));

statement ok
CREATE SEMANTIC VIEW dcf_u2 AS TABLES (f AS dcf_flights PRIMARY KEY (id), a AS dcf_airports PRIMARY KEY (id)) RELATIONSHIPS (dep_rel AS f(airport_id) REFERENCES a) DIMENSIONS (a.name AS airport_name) METRICS (f.flight_cnt UsInG (dep_rel) AS COUNT(*));

statement ok
CREATE SEMANTIC VIEW dcf_u3 AS TABLES (f AS dcf_flights PRIMARY KEY (id), a AS dcf_airports PRIMARY KEY (id)) RELATIONSHIPS (dep_rel AS f(airport_id) REFERENCES a) DIMENSIONS (a.name AS airport_name) METRICS (f.flight_cnt USING (dep_rel) AS COUNT(*));

query T nosort
SELECT * FROM dcf_ddl('dcf_u1');
