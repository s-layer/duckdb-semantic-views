require semantic_views

# Phase 3 grammar corpus -- slice F (statement front door), part B of 3.
#
# Continues ddl_corpus_frontdoor_a.test (same sources, same conventions; read
# its header). This part holds:
#   - tests/parse_proptest.rs body-clause properties (TEST-09/10/11/12):
#     FACTS, derived / mixed metrics, quoted member names, relationships
#     without cardinality, USING;
#   - tests/create_front_door_proptest.rs: hostile bodies through the full
#     CREATE OR REPLACE front door, one row per generator axis;
#   - the former src/parse/ffi.rs: statement framing (multi-statement strings,
#     and DDL on a second connection).
# Part C (ddl_corpus_frontdoor_c.test) ports src/parse/search_path.rs and
# src/parse/show_clauses.rs. Case map: _notes/phase3-corpus/map-F.md.
#
# Row markers: `[syntax]` = a syntactic reject (`statement error` with an empty
# `----` block, which accepts any message; its wording will change under the
# grammar). `[text]` = today's contract for something a grammar might
# plausibly change. `PRE-EXISTING` = today's behaviour pinned although it
# looks wrong.

statement ok
CREATE TABLE dcf_orders (id INTEGER PRIMARY KEY, region VARCHAR, amount INTEGER, status VARCHAR, customer_id INTEGER);

statement ok
INSERT INTO dcf_orders VALUES (1, 'north', 10, 'open', 1), (2, 'south', 20, 'closed', 2);

statement ok
CREATE TABLE dcf_customers (id INTEGER PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO dcf_customers VALUES (1, 'ann'), (2, 'bob');

statement ok
CREATE TABLE dcf_flights (id INTEGER PRIMARY KEY, airport_id INTEGER);

statement ok
INSERT INTO dcf_flights VALUES (1, 1), (2, 1), (3, 2);

statement ok
CREATE TABLE dcf_airports (id INTEGER PRIMARY KEY, name VARCHAR, airport_name VARCHAR);

statement ok
INSERT INTO dcf_airports VALUES (1, 'AMS', 'Schiphol'), (2, 'LHR', 'Heathrow');

statement ok
CREATE MACRO dcf_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

# --- FACTS clause (TEST-09) ---

# F-048: parse_proptest.rs::empty_facts_clause_valid — an empty FACTS () is accepted and stores no facts (GET_DDL omits the clause)
statement ok
CREATE SEMANTIC VIEW dcf_fe AS TABLES (t AS dcf_orders PRIMARY KEY (id)) FACTS () DIMENSIONS (t.region AS region) METRICS (t.rev AS SUM(amount));

query T nosort
SELECT * FROM dcf_ddl('dcf_fe');
----
CREATE OR REPLACE SEMANTIC VIEW dcf_fe AS
TABLES (
    t AS dcf_orders PRIMARY KEY (id)
)
DIMENSIONS (
    t.region AS region
)
METRICS (
    t.rev AS SUM(amount)
)

# F-049: parse_proptest.rs::facts_clause_no_panic — one FACTS entry per expression shape of the generator (alias-qualified column, `a + b`, `alias.SUM(x)`, `a * (1 - b)`), stored verbatim (zero entries: F-048) [text]
# The `alias.SUM(x)` shape calls the aggregate `sum`, which a fact refuses
# (TECH-DEBT #95), so it is checked on its own; the other shapes are stored.
statement error
CREATE SEMANTIC VIEW dcf_f1 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) FACTS (t.f_col AS t.amount, t.f_sum AS t.SUM(amount)) DIMENSIONS (t.region AS region) METRICS (t.rev AS SUM(amount));
----
fact 'f_sum' must not contain the aggregate function 'sum'

statement ok
CREATE SEMANTIC VIEW dcf_f1 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) FACTS (t.f_col AS t.amount, t.f_add AS t.amount + id, t.f_mul AS t.amount * (1 - id)) DIMENSIONS (t.region AS region) METRICS (t.rev AS SUM(amount));

query T nosort
SELECT * FROM dcf_ddl('dcf_f1');
----
CREATE OR REPLACE SEMANTIC VIEW dcf_f1 AS
TABLES (
    t AS dcf_orders PRIMARY KEY (id)
)
FACTS (
    t.f_col AS t.amount,
    t.f_add AS t.amount + id,
    t.f_mul AS t.amount * (1 - id)
)
DIMENSIONS (
    t.region AS region
)
METRICS (
    t.rev AS SUM(amount)
)

# F-050: parse_proptest.rs::facts_clause_no_panic — the generator's alias is arbitrary: a FACTS entry on an alias TABLES never declared is refused (near miss of F-049)
statement error
CREATE SEMANTIC VIEW dcf_f2 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) FACTS (x.f_col AS x.amount) DIMENSIONS (t.region AS region) METRICS (t.rev AS SUM(amount));
----
unknown source table 'x'

