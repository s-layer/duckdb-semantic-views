# --- Quoted member names reach the expansion (TEST-11) ---

# F-055: parse_proptest.rs::quote_ident_never_panics — a member name holding an embedded double quote is stored with its quoting and is queryable (the expansion quotes it as an output identifier); requested by its stored or its bare spelling [text]
statement ok
CREATE SEMANTIC VIEW dcf_q1 AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o."dim""q" AS o.region) METRICS (o.total AS SUM(o.amount));

