# --- Statement framing: one DDL statement per call (ffi.rs, TECH-DEBT #85) ---

# F-061: ffi.rs::ddl_after_another_statement_says_one_statement_per_call — a DDL after another statement in one query string runs, with the statement before it (DuckDB's grammar splits the string and runs the CREATE production).
statement ok
CREATE TABLE dcf_ms (id INTEGER); CREATE SEMANTIC VIEW dcf_ms_v AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'dcf_ms';
----
1

query I
SELECT count(*) FROM list_semantic_views() WHERE name = 'dcf_ms_v';
----
1

statement ok
DROP SEMANTIC VIEW dcf_ms_v;

statement ok
DROP TABLE dcf_ms;

# F-062: ffi.rs::ddl_before_another_statement_says_one_statement_per_call — the same with the DDL first and another statement after it
statement ok
CREATE SEMANTIC VIEW dcf_ms_v AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region); SELECT 1;

query I
SELECT count(*) FROM list_semantic_views() WHERE name = 'dcf_ms_v';
----
1

statement ok
DROP SEMANTIC VIEW dcf_ms_v;

# Control for F-061 / F-062: the DDL alone (single trailing ';') is accepted.
statement ok
CREATE SEMANTIC VIEW dcf_ms_v AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region);

