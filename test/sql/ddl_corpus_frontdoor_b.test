# F-052: parse_proptest.rs::derived_metric_parsing_no_panic — the generator can draw the same name for base and derived: that collision is refused (near miss of F-051)
statement error
CREATE SEMANTIC VIEW dcf_d2 AS TABLES (t AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (t.region AS region) METRICS (t.base AS SUM(t.amount), base AS base + 1);
----
duplicate name 'base'

