# Phase 41: DESCRIBE SEMANTIC VIEW -- Snowflake-aligned property-per-row format
# Tests: DESC-01 through DESC-07

require semantic_views

# ============================================================
# Setup: create physical tables
# ============================================================

statement ok
CREATE TABLE p41_customers (id INTEGER, name VARCHAR(50), email VARCHAR(100), country VARCHAR(30));

statement ok
CREATE TABLE p41_orders (id INTEGER, customer_id INTEGER, region VARCHAR(20), amount DECIMAL(10,2), order_date DATE);

statement ok
CREATE TABLE p41_line_items (id INTEGER, order_id INTEGER, product VARCHAR, quantity INTEGER, price DECIMAL(10,2));

# ============================================================
# Test 1: Simple view -- TABLE + DIMENSION + METRIC
# (DESC-01, DESC-02, DESC-04, DESC-06)
# ============================================================

statement ok
CREATE SEMANTIC VIEW p41_simple AS
  TABLES (o AS p41_orders PRIMARY KEY (id))
  DIMENSIONS (o.region AS o.region)
  METRICS (o.total AS SUM(o.amount))

# 5-column output: object_kind, object_name, parent_entity, property, property_value
query TTTTT
DESCRIBE SEMANTIC VIEW p41_simple;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p41_orders
TABLE	o	(empty)	PRIMARY_KEY	["id"]
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
METRIC	total	o	TABLE	o
METRIC	total	o	EXPRESSION	SUM(o.amount)
METRIC	total	o	DATA_TYPE	DECIMAL(38,2)
METRIC	total	o	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 2: Multi-table view with relationships (DESC-03)
# ============================================================

statement ok
CREATE SEMANTIC VIEW p41_multi AS
  TABLES (
    o AS p41_orders PRIMARY KEY (id),
    c AS p41_customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    order_to_customer AS o(customer_id) REFERENCES c
  )
  DIMENSIONS (
    o.region AS o.region,
    c.customer_name AS c.name
  )
  METRICS (
    o.total_revenue AS SUM(o.amount)
  )

# TABLE rows for o (4) + TABLE rows for c (4) + RELATIONSHIP (4) + DIMENSION (3+3) + METRIC (3) = 21 rows
query TTTTT
DESCRIBE SEMANTIC VIEW p41_multi;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p41_orders
TABLE	o	(empty)	PRIMARY_KEY	["id"]
TABLE	c	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	c	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	c	(empty)	BASE_TABLE_NAME	p41_customers
TABLE	c	(empty)	PRIMARY_KEY	["id"]
RELATIONSHIP	order_to_customer	o	TABLE	o
RELATIONSHIP	order_to_customer	o	REF_TABLE	c
RELATIONSHIP	order_to_customer	o	FOREIGN_KEY	["customer_id"]
RELATIONSHIP	order_to_customer	o	REF_KEY	["id"]
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
DIMENSION	customer_name	c	TABLE	c
DIMENSION	customer_name	c	EXPRESSION	c.name
DIMENSION	customer_name	c	DATA_TYPE	VARCHAR
METRIC	total_revenue	o	TABLE	o
METRIC	total_revenue	o	EXPRESSION	SUM(o.amount)
METRIC	total_revenue	o	DATA_TYPE	DECIMAL(38,2)
METRIC	total_revenue	o	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 3: Facts (DESC-05)
# ============================================================

statement ok
CREATE SEMANTIC VIEW p41_facts AS
  TABLES (
    o AS p41_orders PRIMARY KEY (id),
    li AS p41_line_items PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    li_to_order AS li(order_id) REFERENCES o
  )
  FACTS (
    li.net_price AS li.price * li.quantity
  )
  DIMENSIONS (
    o.region AS o.region
  )
  METRICS (
    o.total_net AS SUM(li.net_price)
  )

# total_net's DATA_TYPE is empty by design: it is a parent metric over a child
# fact, which the fan-trap fence refuses to answer, so there is no type to probe
# (pinned with its fan-trap error in member_data_type.test).
query TTTTT
DESCRIBE SEMANTIC VIEW p41_facts;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p41_orders
TABLE	o	(empty)	PRIMARY_KEY	["id"]
TABLE	li	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	li	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	li	(empty)	BASE_TABLE_NAME	p41_line_items
TABLE	li	(empty)	PRIMARY_KEY	["id"]
RELATIONSHIP	li_to_order	li	TABLE	li
RELATIONSHIP	li_to_order	li	REF_TABLE	o
RELATIONSHIP	li_to_order	li	FOREIGN_KEY	["order_id"]
RELATIONSHIP	li_to_order	li	REF_KEY	["id"]
FACT	net_price	li	TABLE	li
FACT	net_price	li	EXPRESSION	li.price * li.quantity
FACT	net_price	li	DATA_TYPE	DECIMAL(18,2)
FACT	net_price	li	ACCESS_MODIFIER	PUBLIC
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
METRIC	total_net	o	TABLE	o
METRIC	total_net	o	EXPRESSION	SUM(li.net_price)
METRIC	total_net	o	DATA_TYPE	(empty)
METRIC	total_net	o	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 4: Derived metrics (DESC-07)
# ============================================================

statement ok
CREATE SEMANTIC VIEW p41_derived AS
  TABLES (o AS p41_orders PRIMARY KEY (id))
  DIMENSIONS (o.region AS o.region)
  METRICS (
    o.revenue AS SUM(o.amount),
    profit AS revenue * 0.3
  )

# revenue is METRIC (has TABLE row, parent_entity=o)
# profit is DERIVED_METRIC (no TABLE row, parent_entity empty)
query TTTTT
DESCRIBE SEMANTIC VIEW p41_derived;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p41_orders
TABLE	o	(empty)	PRIMARY_KEY	["id"]
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
METRIC	revenue	o	TABLE	o
METRIC	revenue	o	EXPRESSION	SUM(o.amount)
METRIC	revenue	o	DATA_TYPE	DECIMAL(38,2)
METRIC	revenue	o	ACCESS_MODIFIER	PUBLIC
DERIVED_METRIC	profit	(empty)	EXPRESSION	revenue * 0.3
DERIVED_METRIC	profit	(empty)	DATA_TYPE	DECIMAL(38,3)
DERIVED_METRIC	profit	(empty)	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 5: Table without PRIMARY KEY (Pitfall 3)
# ============================================================

statement ok
CREATE SEMANTIC VIEW p41_nopk AS
  TABLES (o AS p41_orders)
  DIMENSIONS (o.region AS o.region)
  METRICS (o.total AS SUM(o.amount))

# Only 3 TABLE properties (no PRIMARY_KEY row)
query TTTTT
DESCRIBE SEMANTIC VIEW p41_nopk;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p41_orders
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
METRIC	total	o	TABLE	o
METRIC	total	o	EXPRESSION	SUM(o.amount)
METRIC	total	o	DATA_TYPE	DECIMAL(38,2)
METRIC	total	o	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 6: Error case -- nonexistent view
# ============================================================

statement error
DESCRIBE SEMANTIC VIEW p41_nonexistent;
----
does not exist

# ============================================================
# Test 7: Case insensitivity
# ============================================================

query TTTTT
describe semantic view p41_simple;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p41_orders
TABLE	o	(empty)	PRIMARY_KEY	["id"]
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
METRIC	total	o	TABLE	o
METRIC	total	o	EXPRESSION	SUM(o.amount)
METRIC	total	o	DATA_TYPE	DECIMAL(38,2)
METRIC	total	o	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 8: COUNT(*) verification
# ============================================================

# Simple view with PK: 4 TABLE + 3 DIM + 3 METRIC + 1 ACCESS_MODIFIER = 11 rows
query I
SELECT COUNT(*) FROM describe_semantic_view('p41_simple');
----
11

# No-PK view: 3 TABLE + 3 DIM + 3 METRIC + 1 ACCESS_MODIFIER = 10 rows
query I
SELECT COUNT(*) FROM describe_semantic_view('p41_nopk');
----
10

# Multi-table view: 4+4 TABLE + 4 REL + 3+3 DIM + 3 METRIC + 1 ACCESS_MODIFIER = 22 rows
query I
SELECT COUNT(*) FROM describe_semantic_view('p41_multi');
----
22

# Derived metrics view: 4 TABLE + 3 DIM + 3 METRIC + 2 DERIVED + 2 ACCESS_MODIFIER = 14 rows
query I
SELECT COUNT(*) FROM describe_semantic_view('p41_derived');
----
14

# ============================================================
# Cleanup
# ============================================================

statement ok
DROP SEMANTIC VIEW p41_simple;

statement ok
DROP SEMANTIC VIEW p41_multi;

statement ok
DROP SEMANTIC VIEW p41_facts;

statement ok
DROP SEMANTIC VIEW p41_derived;

statement ok
DROP SEMANTIC VIEW p41_nopk;

statement ok
DROP TABLE p41_line_items;

statement ok
DROP TABLE p41_orders;

statement ok
DROP TABLE p41_customers;
