# Phase 62 Wave 3 — caret rendering coverage for ALTER error paths.
#
# ALTER SEMANTIC VIEW with an unsupported sub-operation keyword (RENAM
# instead of RENAME TO) matches no grammar production, so DuckDB reports its
# own syntax error with a caret under the offending token.
#
# Behavioural property pinned (from RESEARCH.md §6):
#   B6: caret renders for ALTER errors

require semantic_views

statement ok
LOAD semantic_views;

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY);

statement ok
CREATE SEMANTIC VIEW v_for_alter AS TABLES (t AS t PRIMARY KEY (id)) DIMENSIONS (t.id AS id) METRICS (t.c AS COUNT(*));

# B6: ALTER with bad sub-operation keyword (RENAM instead of RENAME TO)
statement error
ALTER SEMANTIC VIEW v_for_alter RENAM TO w;
----
syntax error at or near "RENAM"

# Caret rendering pinned via the LINE 1: substring.
statement error
ALTER SEMANTIC VIEW v_for_alter RENAM TO w;
----
LINE 1:
