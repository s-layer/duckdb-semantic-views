# Phase 8.5b: level-of-detail (LOD) expressions with INCLUDE and EXCLUDE
# DIMENSIONS, as in Snowflake.
#
# `COUNT(orders.order_id) INCLUDE DIMENSIONS (customers.customer_id)` is
# computed at the query's dimensions plus the customer, and
# `SUM(orders.order_amount) EXCLUDE DIMENSIONS (orders.category)` at the
# query's dimensions minus the category. Both are computed over the rows the
# query's WHERE keeps, where a FIXED one sees every row. The data and the
# expected answers are Snowflake's documented example (North: Alice 4 orders
# 1000, Bob 2 orders 300; South: Carol 3 orders 600, Dan 1 order 200) and the
# Phase 8 fixtures 11 and 11b, run on Snowflake 2026-11-13. Each case is
# labelled with its fixture id.

require semantic_views

statement ok
CREATE TABLE customers (customer_id INTEGER, name VARCHAR, region VARCHAR, segment VARCHAR);

statement ok
CREATE TABLE orders (order_id INTEGER, customer_id INTEGER, category VARCHAR, amount DECIMAL(10,2));

statement ok
INSERT INTO customers VALUES (1, 'Alice', 'North', 'Premium'), (2, 'Bob', 'North', 'Standard'),
  (3, 'Carol', 'South', 'Premium'), (4, 'Dan', 'South', 'Standard');

statement ok
INSERT INTO orders VALUES (101, 1, 'Electronics', 400), (102, 1, 'Electronics', 200),
  (103, 1, 'Clothing', 300), (104, 1, 'Clothing', 100), (105, 2, 'Electronics', 200),
  (106, 2, 'Clothing', 100), (107, 3, 'Electronics', 300), (108, 3, 'Electronics', 200),
  (109, 3, 'Clothing', 100), (110, 4, 'Electronics', 200);

# L0: the documented view, INCLUDE and EXCLUDE members included. `orders`
# declares no key, as in the docs.
statement ok
CREATE SEMANTIC VIEW sales_sv
  TABLES (
    customers AS customers PRIMARY KEY (customer_id),
    orders AS orders
  )
  RELATIONSHIPS (
    orders(customer_id) REFERENCES customers
  )
  FACTS (
    orders.order_amount AS amount,
    orders_per_customer AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),
    region_total_fixed AS SUM(orders.order_amount) FIXED DIMENSIONS (customers.region),
    num_orders_incl_customer AS COUNT(orders.order_id) INCLUDE DIMENSIONS (customers.customer_id),
    regional_revenue_excl_cat AS SUM(orders.order_amount) EXCLUDE DIMENSIONS (orders.category),
    region_total_excl_customer AS SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.customer_id)
  )
  DIMENSIONS (
    customers.customer_id AS customer_id,
    customers.region AS region,
    customers.segment AS segment,
    orders.order_id AS order_id,
    orders.category AS category,
    orders_by_region AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.region)
  )
  METRICS (
    orders.total_revenue AS SUM(amount),
    orders.order_count AS COUNT(orders.order_id),
    avg_orders_per_customer AS AVG(orders_per_customer),
    avg_orders_incl_customer AS AVG(num_orders_incl_customer),
    avg_customer_rev_by_region AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)),
    pct_of_regional_total_named AS SUM(orders.order_amount) / AVG(regional_revenue_excl_cat),
    pct_of_regional_total AS SUM(orders.order_amount) / AVG(SUM(orders.order_amount) EXCLUDE DIMENSIONS (orders.category)),
    pct_of_region_by_segment AS SUM(orders.order_amount) / AVG(SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.segment)),
    region_rev_via_fixed AS AVG(region_total_fixed),
    region_rev_via_exclude AS AVG(region_total_excl_customer)
  );

# L6: INCLUDE the customer, by region: the average of each customer's count.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_incl_customer) ORDER BY 1;
----
North	3.0
South	2.0

# L6b: the same metric by segment: the grain is segment and customer.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.segment METRICS avg_orders_incl_customer) ORDER BY 1;
----
Premium	3.5
Standard	1.5

# L7: inline INCLUDE: the average customer revenue in each region.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_customer_rev_by_region) ORDER BY 1;
----
North	650.0
South	400.0

# L7b: by segment.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.segment METRICS avg_customer_rev_by_region) ORDER BY 1;
----
Premium	800.0
Standard	250.0

# L8: a named EXCLUDE fact: each category's share of its region's revenue.
query TTR
SELECT region, category, round(pct_of_regional_total_named, 3) FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, orders.category METRICS pct_of_regional_total_named) ORDER BY 1, 2;
----
North	Clothing	0.385
North	Electronics	0.615
South	Clothing	0.125
South	Electronics	0.875

# L8b: the inline form gives the same answer.
query TTR
SELECT region, category, round(pct_of_regional_total, 3) FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, orders.category METRICS pct_of_regional_total) ORDER BY 1, 2;
----
North	Clothing	0.385
North	Electronics	0.615
South	Clothing	0.125
South	Electronics	0.875

# L9: EXCLUDE a customer dimension: each segment's share of its region.
query TTRR
SELECT region, segment, total_revenue, round(pct_of_region_by_segment, 3) FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, customers.segment METRICS orders.total_revenue, pct_of_region_by_segment) ORDER BY 1, 2;
----
North	Premium	1000.00	0.769
North	Standard	300.00	0.231
South	Premium	600.00	0.75
South	Standard	200.00	0.25

# L10: an excluded dimension the query doesn't group by has no effect.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS orders.total_revenue, pct_of_regional_total) ORDER BY 1;
----
North	1300.00	1.0
South	800.00	1.0

# L11: FIXED is computed before the filter, EXCLUDE after it: Alice's row
# shows North's 1300 and her own 1000.
query TIRR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, customers.customer_id METRICS region_rev_via_fixed, region_rev_via_exclude WHERE customers.customer_id = 1);
----
North	1	1300.0	1000.0

# L11b: a filter with a subquery is applied before the INCLUDE calculation too.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_incl_customer WHERE orders.category IN (SELECT 'Electronics')) ORDER BY 1;
----
North	1.5
South	1.5

# L17: INCLUDE beside a FIXED metric and a plain one at region and category:
# INCLUDE counts each customer's orders in the group's category.
query TTIRR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region, orders.category METRICS orders.order_count, avg_orders_per_customer, avg_orders_incl_customer) ORDER BY 1, 2;
----
North	Clothing	3	3.0	1.5
North	Electronics	3	3.0	1.5
South	Clothing	1	3.0	1.0
South	Electronics	3	2.0	1.5

# L26: an INCLUDE fact can be read only in METRICS, inside an aggregate.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv FACTS num_orders_incl_customer);
----
can be read only in METRICS, as the argument of an aggregate function

# L26c: nor in WHERE.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_incl_customer WHERE num_orders_incl_customer > 2);
----
not in WHERE

# L28: an expression item in DIMENSIONS beside an INCLUDE metric is refused.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.customer_id + 100 METRICS avg_orders_incl_customer);
----
can't be beside an expression in DIMENSIONS

# L28b: beside a FIXED metric it is answered.
query IR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.customer_id + 100 METRICS avg_orders_per_customer) ORDER BY 1;
----
101	4.0
102	2.0
103	3.0
104	1.0

# L29e: an ad-hoc aggregate of an INCLUDE fact is an INCLUDE metric.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS AVG(num_orders_incl_customer)) ORDER BY 1;
----
North	3.0
South	2.0

# L32: grouped by a FIXED LOD dimension, an INCLUDE metric has no grain to
# compute at.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS orders_by_region METRICS avg_orders_incl_customer);
----
can't be grouped by LOD dimension 'orders_by_region'

# L32b: nor filtered by one.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_sv DIMENSIONS customers.region METRICS avg_orders_incl_customer WHERE orders_by_region > 5);
----
reads LOD expression 'orders_by_region'

# L33: DESCRIBE shows an INCLUDE fact's dimensions as an INCLUDE_DIMENSIONS row.
query T
SELECT property_value FROM (DESCRIBE SEMANTIC VIEW sales_sv) WHERE object_name = 'num_orders_incl_customer' AND property = 'INCLUDE_DIMENSIONS';
----
[["customers","customer_id"]]

# L33b: and an EXCLUDE fact's as an EXCLUDE_DIMENSIONS row.
query T
SELECT property_value FROM (DESCRIBE SEMANTIC VIEW sales_sv) WHERE object_name = 'regional_revenue_excl_cat' AND property = 'EXCLUDE_DIMENSIONS';
----
[["orders","category"]]

# L33d: SHOW SEMANTIC FACTS types an INCLUDE and an EXCLUDE fact, as
# Snowflake lists LOD facts with a type (fixture 11 L20; v0.20.0 review F2).
query TT
SELECT name, data_type FROM (SHOW SEMANTIC FACTS IN sales_sv) WHERE name IN ('num_orders_incl_customer', 'regional_revenue_excl_cat') ORDER BY 1;
----
num_orders_incl_customer	BIGINT
regional_revenue_excl_cat	DECIMAL(38,2)

# L33e: and DESCRIBE.
query TT
SELECT object_name, property_value FROM (DESCRIBE SEMANTIC VIEW sales_sv) WHERE object_name IN ('num_orders_incl_customer', 'regional_revenue_excl_cat') AND property = 'DATA_TYPE' ORDER BY 1;
----
num_orders_incl_customer	BIGINT
regional_revenue_excl_cat	DECIMAL(38,2)

# L33c: SHOW SEMANTIC DIMENSIONS ... FOR METRIC lists, for an INCLUDE metric,
# the dimensions its table reaches.
query T
SELECT name FROM (SHOW SEMANTIC DIMENSIONS IN sales_sv FOR METRIC avg_orders_incl_customer) ORDER BY 1;
----
category
customer_id
order_id
region
segment

# Fixture 11b's edge data: Eve (North) has no orders; order 111 has a NULL
# customer, 112 customer 99, who is not in customers.
statement ok
INSERT INTO customers VALUES (5, 'Eve', 'North', 'Premium');

statement ok
INSERT INTO orders VALUES (111, NULL, 'Clothing', 50), (112, 99, 'Clothing', 70);

statement ok
CREATE SEMANTIC VIEW sales_edge
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (
    orders.order_amount AS amount,
    orders_per_customer AS COUNT(orders.order_id) FIXED DIMENSIONS (customers.customer_id),
    num_orders_incl_customer AS COUNT(orders.order_id) INCLUDE DIMENSIONS (customers.customer_id),
    region_total_excl_customer AS SUM(orders.order_amount) EXCLUDE DIMENSIONS (customers.customer_id)
  )
  DIMENSIONS (
    customers.customer_id AS customer_id, customers.region AS region,
    orders.order_id AS order_id, orders.category AS category,
    incl_count AS COUNT(orders.order_id) INCLUDE DIMENSIONS (customers.customer_id)
  )
  METRICS (
    orders.total_revenue AS SUM(amount),
    customers.customer_count AS COUNT(customers.customer_id),
    avg_orders_per_customer AS AVG(orders_per_customer),
    avg_orders_incl_customer AS AVG(num_orders_incl_customer),
    region_rev_via_exclude AS AVG(region_total_excl_customer)
  );

# E1: Eve, with no orders, is in no INCLUDE tuple; the orders with no customer
# row form one NULL tuple of 2.
query TRRIR
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.region METRICS avg_orders_per_customer, avg_orders_incl_customer, customers.customer_count, orders.total_revenue) ORDER BY 1 NULLS LAST;
----
North	3.0	3.0	3	1300.00
South	2.0	2.0	2	800.00
NULL	2.0	2.0	NULL	120.00

# E2: with no dimension: (4 + 2 + 3 + 1 + 2) / 5.
query RR
SELECT * FROM SEMANTIC_VIEW(sales_edge METRICS avg_orders_per_customer, avg_orders_incl_customer);
----
2.4	2.4

# E3: by customer, each customer's own count.
query IRR
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.customer_id METRICS avg_orders_per_customer, avg_orders_incl_customer) ORDER BY 1 NULLS LAST;
----
1	4.0	4.0
2	2.0	2.0
3	3.0	3.0
4	1.0	1.0
NULL	2.0	2.0

# E5: EXCLUDE the customer, by region and customer: every North customer, Eve
# included, shows North's total, and the orders with no customer row their
# NULL region's 120.
query TIRR
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.region, customers.customer_id METRICS orders.total_revenue, region_rev_via_exclude) ORDER BY 1 NULLS LAST, 2 NULLS LAST;
----
North	1	1000.00	1300.0
North	2	300.00	1300.0
North	5	NULL	1300.0
South	3	600.00	800.0
South	4	200.00	800.0
NULL	NULL	120.00	120.0

# L26b: an INCLUDE dimension can't be grouped by either.
statement error
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS incl_count METRICS orders.total_revenue);
----
not in DIMENSIONS

# E6: INCLUDE is computed over the rows the filter keeps, FIXED over every row.
query TRR
SELECT * FROM SEMANTIC_VIEW(sales_edge DIMENSIONS customers.region METRICS avg_orders_incl_customer, avg_orders_per_customer WHERE orders.category = 'Electronics') ORDER BY 1 NULLS LAST;
----
North	1.5	3.0
South	1.5	2.0

# L24e: an INCLUDE expression inline under MAX, and in a larger expression.
statement ok
CREATE SEMANTIC VIEW sales_ok7
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region, orders.order_id AS order_id)
  METRICS (max_cust_rev AS MAX(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)), half AS MAX(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)) / 2);

query TRR
SELECT * FROM SEMANTIC_VIEW(sales_ok7 DIMENSIONS customers.region METRICS max_cust_rev, half) ORDER BY 1 NULLS LAST;
----
North	1000.00	500.0
South	600.00	300.0
NULL	120.00	60.0

statement ok
DROP SEMANTIC VIEW sales_ok7;

# L24f: an INCLUDE fact whose aggregate doesn't bind is refused at CREATE,
# also when no metric reads it, as every member is bound at CREATE (v0.20.0
# review F2).
statement error
CREATE SEMANTIC VIEW sales_bad_incl
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (bad_incl AS SUM(orders.category) INCLUDE DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id, orders.category AS category)
  METRICS (orders.order_count AS COUNT(orders.order_id));
----
fact 'bad_incl' does not bind

# L24g: an INCLUDE fact over a window fact binds at CREATE, as a query reads
# it: the window fact first, as its table's column (v0.20.0 #371 review).
# Orders 101..112 are rows 1..12, so the customers sum 10, 11, 24 and 10, and
# orders 111 and 112, with no customer row, 23.
statement ok
CREATE SEMANTIC VIEW sales_win_incl
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers)
  FACTS (orders.rn AS ROW_NUMBER() OVER (ORDER BY order_id),
    rn_incl AS SUM(orders.rn) INCLUDE DIMENSIONS (customers.customer_id))
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region)
  METRICS (avg_rn AS AVG(rn_incl));

query TR
SELECT * FROM SEMANTIC_VIEW(sales_win_incl DIMENSIONS customers.region METRICS avg_rn) ORDER BY 1 NULLS LAST;
----
North	10.5
South	17.0
NULL	23.0

# Q1: an INCLUDE metric grouped by a child of orders is computed over the
# child's rows, each joined up to its order, as Snowflake computes it (fixture
# 14c, TECH-DEBT #115; the full set of cases is in phase8_lod_child_grain.test).
statement ok
CREATE TABLE order_returns (return_id INTEGER, order_id INTEGER, reason VARCHAR);

statement ok
INSERT INTO order_returns VALUES (1, 101, 'damaged'), (2, 107, 'late');

statement ok
CREATE SEMANTIC VIEW sales_child
  TABLES (customers AS customers PRIMARY KEY (customer_id), orders AS orders PRIMARY KEY (order_id),
    order_returns AS order_returns PRIMARY KEY (return_id))
  RELATIONSHIPS (orders(customer_id) REFERENCES customers, order_returns(order_id) REFERENCES orders)
  FACTS (orders.order_amount AS amount)
  DIMENSIONS (customers.customer_id AS customer_id, customers.region AS region, order_returns.reason AS reason)
  METRICS (avg_customer_rev AS AVG(SUM(orders.order_amount) INCLUDE DIMENSIONS (customers.customer_id)));

query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS order_returns.reason METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
damaged	400.0
late	300.0

# Q1b: and filtered by it, over the rows the filter keeps.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.region METRICS avg_customer_rev WHERE order_returns.reason = 'late') ORDER BY 1 NULLS LAST;
----
South	300.0

# Q1c: grouped by a table it does reference, it is answered.
query TR
SELECT * FROM SEMANTIC_VIEW(sales_child DIMENSIONS customers.region METRICS avg_customer_rev) ORDER BY 1 NULLS LAST;
----
North	650.0
South	400.0
NULL	120.0

statement ok
DROP SEMANTIC VIEW sales_child;

statement ok
DROP SEMANTIC VIEW sales_edge;

statement ok
DROP SEMANTIC VIEW sales_sv;
