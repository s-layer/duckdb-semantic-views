# Phase 29: End-to-end integration test for FACTS
# Tests fact expression inlining, DESCRIBE output,
# and error cases for the full DDL->query->describe->drop lifecycle.

require semantic_views

# ============================================================
# Setup: create physical tables with known data
# ============================================================

statement ok
CREATE TABLE p29_orders (id INTEGER, customer_id INTEGER, region VARCHAR);

statement ok
INSERT INTO p29_orders VALUES (1, 1, 'East'), (2, 2, 'West');

statement ok
CREATE TABLE p29_line_items (id INTEGER, order_id INTEGER, extended_price DECIMAL(10,2), discount DECIMAL(3,2), tax_rate DECIMAL(3,2));

statement ok
INSERT INTO p29_line_items VALUES
    (1, 1, 100.00, 0.10, 0.05),
    (2, 1, 200.00, 0.20, 0.08),
    (3, 2, 150.00, 0.00, 0.10);

statement ok
CREATE TABLE p29_customers (id INTEGER, name VARCHAR, country VARCHAR, state VARCHAR, city VARCHAR);

statement ok
INSERT INTO p29_customers VALUES (1, 'Alice', 'US', 'NY', 'NYC'), (2, 'Bob', 'US', 'CA', 'LA');

# ============================================================
# Test 1: CREATE with FACTS
# ============================================================

statement ok
CREATE SEMANTIC VIEW p29_analytics AS
  TABLES (
    o AS p29_orders PRIMARY KEY (id),
    li AS p29_line_items PRIMARY KEY (id),
    c AS p29_customers PRIMARY KEY (id)
  )
  RELATIONSHIPS (
    li_to_order AS li(order_id) REFERENCES o,
    order_to_customer AS o(customer_id) REFERENCES c
  )
  FACTS (
    li.net_price AS li.extended_price * (1 - li.discount),
    li.tax_amount AS li.net_price * li.tax_rate
  )
  DIMENSIONS (
    o.region AS o.region,
    c.country AS c.country,
    c.state AS c.state,
    c.city AS c.city
  )
  METRICS (
    li.total_net AS SUM(li.net_price),
    li.total_tax AS SUM(li.tax_amount)
  );

# ============================================================
# Test 2: Query metric referencing a single fact (net_price)
# Line item 1: 100 * (1 - 0.10) = 90.00
# Line item 2: 200 * (1 - 0.20) = 160.00
# Line item 3: 150 * (1 - 0.00) = 150.00
# East (order 1, items 1+2): 90 + 160 = 250.00
# West (order 2, item 3): 150.00
# ============================================================

query TR rowsort
SELECT * FROM SEMANTIC_VIEW(p29_analytics DIMENSIONS region METRICS total_net);
----
East	250.00
West	150.00

# ============================================================
# Test 3: Query metric with multi-level fact chain (tax_amount refs net_price)
# tax_amount = net_price * tax_rate
# Item 1: 90.00 * 0.05 = 4.50
# Item 2: 160.00 * 0.08 = 12.80
# Item 3: 150.00 * 0.10 = 15.00
# East: 4.50 + 12.80 = 17.30
# West: 15.00
# ============================================================

query TR rowsort
SELECT * FROM SEMANTIC_VIEW(p29_analytics DIMENSIONS region METRICS total_tax);
----
East	17.30
West	15.00

# ============================================================
# Test 4: Global aggregate -- no dimensions
# total_net = 90 + 160 + 150 = 400.00
# total_tax = 4.50 + 12.80 + 15.00 = 32.30
# ============================================================

query TT
SELECT * FROM SEMANTIC_VIEW(p29_analytics METRICS total_net, total_tax);
----
400.00	32.30

# ============================================================
# Test 5: DESCRIBE shows facts (5 columns, property-per-row)
# ============================================================

query TTTTT
DESCRIBE SEMANTIC VIEW p29_analytics;
----
TABLE	o	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	o	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	o	(empty)	BASE_TABLE_NAME	p29_orders
TABLE	o	(empty)	PRIMARY_KEY	["id"]
TABLE	li	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	li	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	li	(empty)	BASE_TABLE_NAME	p29_line_items
TABLE	li	(empty)	PRIMARY_KEY	["id"]
TABLE	c	(empty)	BASE_TABLE_DATABASE_NAME	memory
TABLE	c	(empty)	BASE_TABLE_SCHEMA_NAME	main
TABLE	c	(empty)	BASE_TABLE_NAME	p29_customers
TABLE	c	(empty)	PRIMARY_KEY	["id"]
RELATIONSHIP	li_to_order	li	TABLE	li
RELATIONSHIP	li_to_order	li	REF_TABLE	o
RELATIONSHIP	li_to_order	li	FOREIGN_KEY	["order_id"]
RELATIONSHIP	li_to_order	li	REF_KEY	["id"]
RELATIONSHIP	order_to_customer	o	TABLE	o
RELATIONSHIP	order_to_customer	o	REF_TABLE	c
RELATIONSHIP	order_to_customer	o	FOREIGN_KEY	["customer_id"]
RELATIONSHIP	order_to_customer	o	REF_KEY	["id"]
FACT	net_price	li	TABLE	li
FACT	net_price	li	EXPRESSION	li.extended_price * (1 - li.discount)
FACT	net_price	li	DATA_TYPE	DECIMAL(18,4)
FACT	net_price	li	ACCESS_MODIFIER	PUBLIC
FACT	tax_amount	li	TABLE	li
FACT	tax_amount	li	EXPRESSION	li.net_price * li.tax_rate
FACT	tax_amount	li	DATA_TYPE	DECIMAL(18,6)
FACT	tax_amount	li	ACCESS_MODIFIER	PUBLIC
DIMENSION	region	o	TABLE	o
DIMENSION	region	o	EXPRESSION	o.region
DIMENSION	region	o	DATA_TYPE	VARCHAR
DIMENSION	country	c	TABLE	c
DIMENSION	country	c	EXPRESSION	c.country
DIMENSION	country	c	DATA_TYPE	VARCHAR
DIMENSION	state	c	TABLE	c
DIMENSION	state	c	EXPRESSION	c.state
DIMENSION	state	c	DATA_TYPE	VARCHAR
DIMENSION	city	c	TABLE	c
DIMENSION	city	c	EXPRESSION	c.city
DIMENSION	city	c	DATA_TYPE	VARCHAR
METRIC	total_net	li	TABLE	li
METRIC	total_net	li	EXPRESSION	SUM(li.net_price)
METRIC	total_net	li	DATA_TYPE	DECIMAL(38,4)
METRIC	total_net	li	ACCESS_MODIFIER	PUBLIC
METRIC	total_tax	li	TABLE	li
METRIC	total_tax	li	EXPRESSION	SUM(li.tax_amount)
METRIC	total_tax	li	DATA_TYPE	DECIMAL(38,6)
METRIC	total_tax	li	ACCESS_MODIFIER	PUBLIC

# ============================================================
# Test 6: Error -- fact cycle (two facts referencing each other)
# ============================================================

statement error
CREATE SEMANTIC VIEW p29_cycle AS
  TABLES (
    o AS p29_orders PRIMARY KEY (id)
  )
  FACTS (
    o.a AS o.b + 1,
    o.b AS o.a + 1
  )
  DIMENSIONS (
    o.region AS o.region
  )
  METRICS (
    o.total AS SUM(o.a)
  );
----
cycle detected in facts

# ============================================================
# Test 7: A fact whose expression references its own name is a
# column reference (identity passthrough), NOT a self-cycle.
# ============================================================

statement ok
CREATE SEMANTIC VIEW p29_self_named AS
  TABLES (
    o AS p29_orders PRIMARY KEY (id)
  )
  FACTS (
    o.customer_id AS o.customer_id
  )
  DIMENSIONS (
    o.region AS o.region
  )
  METRICS (
    o.total AS SUM(o.customer_id)
  );

statement ok
DROP SEMANTIC VIEW p29_self_named;

# ============================================================
# Test 8: Error -- facts source table not in TABLES
# ============================================================

statement error
CREATE SEMANTIC VIEW p29_bad_source AS
  TABLES (
    o AS p29_orders PRIMARY KEY (id)
  )
  FACTS (
    x.price AS x.amount
  )
  DIMENSIONS (
    o.region AS o.region
  )
  METRICS (
    o.total AS count(*)
  );
----
unknown source table

# ============================================================
# Test 9: FACTS without other optional clauses
# ============================================================

statement ok
CREATE SEMANTIC VIEW p29_facts_only AS
  TABLES (
    o AS p29_orders PRIMARY KEY (id)
  )
  FACTS (
    o.flag AS CASE WHEN o.id > 1 THEN 1 ELSE 0 END
  )
  DIMENSIONS (
    o.region AS o.region
  )
  METRICS (
    o.flagged AS SUM(o.flag)
  );

query TI rowsort
SELECT * FROM SEMANTIC_VIEW(p29_facts_only DIMENSIONS region METRICS flagged);
----
East	0
West	1

statement ok
DROP SEMANTIC VIEW p29_facts_only;

# ============================================================
# Cleanup
# ============================================================

statement ok
DROP SEMANTIC VIEW p29_analytics;

statement ok
DROP TABLE p29_line_items;

statement ok
DROP TABLE p29_orders;

statement ok
DROP TABLE p29_customers;
