<REGEX>:.+	dcf_cust_1	SEMANTIC_VIEW	memory	main	(empty)
<REGEX>:.+	dcf_cust_2	SEMANTIC_VIEW	memory	main	(empty)

query TTTTTT nosort
SHOW SEMANTIC VIEWS LIKE 'dcf_cust%' LIMIT 1;
----
