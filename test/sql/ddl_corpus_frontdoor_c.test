require semantic_views

# Phase 3 grammar corpus -- slice F (statement front door), part C of 3.
#
# Ports the cases encoded by:
#   src/parse/search_path.rs   (#[test]s) -- read calls resolve the view name
#                              through the caller's search path
#   src/parse/show_clauses.rs  (#[test]s) -- SHOW ... LIKE / STARTS WITH /
#                              IN SCHEMA / IN DATABASE / LIMIT values
# Parts A and B (ddl_corpus_frontdoor_a/_b.test) hold the rest of the slice and
# explain the conventions. Case map: _notes/phase3-corpus/map-F.md.
#
# Row markers: `[syntax]` = a syntactic reject (`statement error` with an empty
# `----` block, which accepts any message). `[text]` = today's contract on
# something a grammar might plausibly change. `PRE-EXISTING` = today's
# behaviour pinned although it looks wrong.
#
# How the search-path rows discriminate. search_path.rs splices
# `search_path := <caller's path>` into every resolving read call. The fixture
# puts a view `dcf_sp` in two schemas whose `total` differs (dcf_a: 30,
# dcf_b: 3000) and sets the path to dcf_b. A call that got the argument
# resolves to dcf_b (3000); one that did not falls back to "unique match,
# else error" and fails, since the name is in two schemas; one whose argument
# was spliced into the wrong place fails to parse or bind. So every accept row
# below would go red on the bug its Rust test pins.
#
# Since 0.16.0 there is no splice: each read function takes the caller's path
# from its bind (search_path.rs is deleted). The rows still discriminate the
# same way, since a call that ignored the path fails on the duplicated name.

statement ok
CREATE TABLE dcf_orders (id INTEGER PRIMARY KEY, region VARCHAR, amount INTEGER);

statement ok
INSERT INTO dcf_orders VALUES (1, 'north', 10), (2, 'south', 20);

statement ok
CREATE MACRO dcf_ddl(v) AS TABLE SELECT unnest(string_split(rtrim(get_ddl('SEMANTIC_VIEW', v), chr(10)), chr(10))) AS line;

statement ok
CREATE SCHEMA dcf_a;

statement ok
CREATE SCHEMA dcf_b;

statement ok
CREATE SEMANTIC VIEW dcf_a.dcf_sp AS TABLES (o AS dcf_orders PRIMARY KEY (id)) FACTS (o.amt_a AS o.amount) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount)) MATERIALIZATIONS (dcf_mat_a AS (TABLE dcf_orders, DIMENSIONS (region)));

statement ok
CREATE SEMANTIC VIEW dcf_b.dcf_sp AS TABLES (o AS dcf_orders PRIMARY KEY (id)) FACTS (o.amt_b AS o.amount) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount) * 100) MATERIALIZATIONS (dcf_mat_b AS (TABLE dcf_orders, DIMENSIONS (region)));

statement ok
CREATE SEMANTIC VIEW dcf_a.dcf_search_path_v AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));

statement ok
CREATE SEMANTIC VIEW dcf_b.dcf_search_path_v AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount) * 100);

query T nosort
SELECT * FROM dcf_ddl('dcf_b.dcf_sp');
----
CREATE OR REPLACE SEMANTIC VIEW dcf_sp AS
TABLES (
    o AS dcf_orders PRIMARY KEY (id)
)
FACTS (
    o.amt_b AS o.amount
)
DIMENSIONS (
    o.region AS o.region
)
METRICS (
    o.total AS SUM(o.amount) * 100
)
MATERIALIZATIONS (
    dcf_mat_b AS (
        TABLE dcf_orders,
        DIMENSIONS (region)
    )
)

# --- Search path: the fixture's control ---

# F-066: search_path.rs::a_read_call_gains_the_named_parameter (control) — on the default path (main) the name is on neither schema of the path, so the read call refuses rather than guessing between dcf_a and dcf_b
statement error
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
does not exist on the search path

statement ok
SET search_path = 'dcf_b';

# --- Search path: the argument is added to every resolving read call ---

# F-067: search_path.rs::a_read_call_gains_the_named_parameter, ::existing_named_parameters_are_preserved — with the path set to dcf_b, a read call resolves there, and its own named parameters still apply
query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
3000

query TI rowsort
SELECT * FROM semantic_view('dcf_sp', dimensions := ['region'], metrics := ['total']);
----
north	1000
south	2000

# F-068: search_path.rs::every_call_in_one_statement_is_injected — both calls of a UNION ALL resolve through the path
query I rowsort
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']) UNION ALL SELECT * FROM semantic_view('dcf_search_path_v', metrics := ['total']);
----
3000
3000

# F-069: search_path.rs::a_nested_call_argument_does_not_confuse_the_paren_match, ::matching_close_paren_still_ignores_single_and_dollar_quoted_literals (nested-call arm) — the `)` of a nested function call is not the read call's close
query I
SELECT * FROM semantic_view(lower('DCF_SP'), metrics := ['total']);
----
3000

# F-070: search_path.rs::a_paren_inside_a_string_literal_is_not_the_close, ::matching_close_paren_still_ignores_single_and_dollar_quoted_literals (single- and dollar-quoted arms) — a `)` inside a '...' or $$...$$ argument is not the call's close
query TI rowsort
SELECT * FROM semantic_view('dcf_sp', dimensions := ['region'], metrics := ['total'], where_clause := 'region <> '')''');
----
north	1000
south	2000

query TI rowsort
SELECT * FROM semantic_view('dcf_sp', dimensions := ['region'], metrics := ['total'], where_clause := $$region <> ')'$$);
----
north	1000
south	2000

# F-071: search_path.rs::matching_close_paren_ignores_a_close_paren_inside_a_double_quoted_identifier — a `)` inside a double-quoted identifier in the argument list (here a struct field name) is not the call's close
query I
SELECT * FROM semantic_view(({'a)b': 'dcf_sp'})."a)b", metrics := ['total']);
----
3000

# F-072: search_path.rs::the_function_name_matches_case_insensitively — upper / mixed case function names get the argument too
query I
SELECT * FROM SEMANTIC_VIEW('dcf_sp', metrics := ['total']);
----
3000

query I
SELECT * FROM Semantic_View('dcf_sp', metrics := ['total']);
----
3000

# F-073: search_path.rs::a_view_name_that_merely_contains_the_parameter_text_is_still_injected — a view whose NAME contains `search_path` still resolves through the path
query I
SELECT * FROM semantic_view('dcf_search_path_v', metrics := ['total']);
----
3000

# F-074: search_path.rs::a_where_clause_mentioning_the_parameter_is_not_an_argument — `search_path :=` inside a where_clause string literal is not the named argument
query TI rowsort
SELECT * FROM semantic_view('dcf_sp', dimensions := ['region'], metrics := ['total'], where_clause := 'region <> ''search_path := x''');
----
north	1000
south	2000

# --- Search path: an explicit argument wins, and is never doubled ---

# F-075: search_path.rs::a_caller_supplied_search_path_wins — an explicit search_path argument overrides the session path (dcf_a, not dcf_b)
query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'], search_path := ['dcf_a']);
----
30

# F-076: search_path.rs::a_caller_supplied_search_path_wins_whatever_its_case — SEARCH_PATH / Search_Path are the same named argument (a second one would be a duplicate-argument error, see the control below)
query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'], SEARCH_PATH := ['dcf_a']);
----
30

query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'], Search_Path := ['dcf_a']);
----
30

statement error
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'], search_path := ['dcf_a'], search_path := ['dcf_b']);
----
Duplicate named argument

# F-077: search_path.rs::injection_is_idempotent, ::injection_is_idempotent_for_the_nested_shape — the already-injected text itself (what a second rewrite pass sees) runs without a duplicate argument
query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'], search_path := list_concat(current_schemas(false), [current_schema()]));
----
3000

# --- Search path: comments in and around the call (PARSE-5, PARSE-13) ---

# F-078: search_path.rs::a_leading_line_comment_containing_an_apostrophe_does_not_defeat_injection — a `--` comment with an apostrophe ahead of the statement
query I
-- don't touch
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
3000

# F-079: search_path.rs::a_leading_block_comment_containing_an_apostrophe_does_not_defeat_injection
query I
/* it's fine */ SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
3000

# F-080: search_path.rs::a_close_paren_inside_a_block_comment_does_not_end_the_call — the argument lands after the comment, inside the real call
query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'] /* x) */);
----
3000

# F-081: search_path.rs::a_comment_between_the_function_head_and_its_paren_does_not_defeat_injection
query I
SELECT * FROM semantic_view /* c */ ('dcf_sp', metrics := ['total']);
----
3000

# F-082: search_path.rs::an_explicit_search_path_inside_a_comment_does_not_suppress_injection — a commented-out argument is not an opt-out (dcf_b, not the commented dcf_a)
query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'] /* , search_path := ['dcf_a'] */);
----
3000

# F-083: search_path.rs::a_read_call_named_only_inside_a_comment_is_not_injected — commented-out code is not a call site; the statement runs as written
query I
-- SELECT * FROM semantic_view('dcf_sp')
SELECT 1;
----
1

# F-084: search_path.rs::a_leading_line_comment_ended_by_a_bare_carriage_return_does_not_defeat_injection — a `--` comment ended by a bare CR (built with chr(13) and parsed via query(), see part A's header; the file itself cannot hold a CR); control: the same ended by LF
query I
SELECT * FROM query('-- note' || chr(13) || 'SELECT * FROM semantic_view(''dcf_sp'', metrics := [''total''])');
----
3000

query I
SELECT * FROM query('-- note' || chr(10) || 'SELECT * FROM semantic_view(''dcf_sp'', metrics := [''total''])');
----
3000

# --- Search path: what is left alone ---

# F-085: search_path.rs::a_statement_with_no_read_call_is_untouched, ::a_function_name_inside_a_string_literal_is_not_a_call — ordinary statements run as written, and a literal that spells a read call is returned verbatim
statement ok
CREATE TABLE dcf_plain (a INT);

query T
SELECT 'semantic_view(x)' AS lit;
----
semantic_view(x)

query TI
SELECT region, amount FROM dcf_orders WHERE region = 'north';
----
north	10

# F-086: search_path.rs::the_all_variants_are_left_alone — list_semantic_views() and show_semantic_metrics_all() list every view in every schema, not just those on the path
query TTT nosort
SELECT name, database_name, schema_name FROM list_semantic_views();
----
dcf_search_path_v	memory	dcf_a
dcf_sp	memory	dcf_a
dcf_search_path_v	memory	dcf_b
dcf_sp	memory	dcf_b

query TTTTT nosort
SELECT database_name, schema_name, semantic_view_name, name, data_type FROM show_semantic_metrics_all() WHERE semantic_view_name = 'dcf_sp';
----
memory	dcf_a	dcf_sp	total	HUGEINT
memory	dcf_b	dcf_sp	total	HUGEINT

# F-087: search_path.rs::an_unterminated_call_is_left_alone — an unterminated read call is DuckDB's to reject (near miss of F-067) [syntax]
statement error
SELECT * FROM semantic_view('dcf_sp', metrics := ['total'];
----

# F-088: search_path.rs::nested_resolving_calls_do_not_panic_and_both_get_injected — a resolving call nested in another's argument list can only be written as a subquery, which DuckDB refuses in a table-function argument whatever the injection did; pinned so the shape is known to fail cleanly (near miss of F-067)
statement error
SELECT * FROM semantic_view((SELECT semantic_view_name FROM show_semantic_dimensions('dcf_sp') LIMIT 1), metrics := ['total']);
----
cannot contain subqueries

# --- Search path: every resolving read function, and the two that are not (module contract) ---

# F-089: search_path.rs::RESOLVING_READ_FUNCTIONS — every read function that takes a view name resolves it through the path: explain_semantic_view, describe_semantic_view, show_columns_in_semantic_view, show_semantic_dimensions / _metrics / _facts / _materializations, show_semantic_dimensions_for_metric, and the SHOW / DESCRIBE DDL that lower onto them
query I
SELECT count(*) FROM explain_semantic_view('dcf_sp', metrics := ['total']) WHERE explain_output LIKE '%SUM(o.amount) * 100%';
----
1

query T
SELECT property_value FROM describe_semantic_view('dcf_sp') WHERE object_kind = 'METRIC' AND property = 'EXPRESSION';
----
SUM(o.amount) * 100

query TTTTTTTT nosort
SHOW COLUMNS IN SEMANTIC VIEW dcf_sp;
----
memory	dcf_b	dcf_sp	region	VARCHAR	DIMENSION	o.region	(empty)
memory	dcf_b	dcf_sp	amt_b	INTEGER	FACT	o.amount	(empty)
memory	dcf_b	dcf_sp	total	HUGEINT	METRIC	SUM(o.amount) * 100	(empty)

query TTTTTTTTT nosort
SELECT * FROM show_semantic_dimensions('dcf_sp');
----
memory	dcf_b	dcf_sp	dcf_orders	region	VARCHAR	[]	(empty)	[]

query TTTTTTTT nosort
SHOW SEMANTIC METRICS IN dcf_sp;
----
memory	dcf_b	dcf_sp	dcf_orders	total	HUGEINT	[]	(empty)

query TTTTTTTTT nosort
SHOW SEMANTIC FACTS IN dcf_sp;
----
memory	dcf_b	dcf_sp	dcf_orders	amt_b	INTEGER	[]	(empty)	[]

query TTTTTTT nosort
SHOW SEMANTIC MATERIALIZATIONS IN dcf_sp;
----
memory	dcf_b	dcf_sp	dcf_mat_b	dcf_orders	["region"]	[]

