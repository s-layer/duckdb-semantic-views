statement ok
CREATE SEMANTIC VIEW dcf_sw AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.a_b AS o.region, o.axb AS o.region, o.a_bc AS o.region) METRICS (o.total AS SUM(o.amount), o.cnt AS COUNT(*));

statement ok
CREATE SEMANTIC VIEW "dcf_o'brien" AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

statement ok
CREATE SEMANTIC VIEW "dcf_o'bryan" AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

statement ok
CREATE SEMANTIC VIEW "dcf_pct_100%x" AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

statement ok
CREATE SEMANTIC VIEW dcf_pct_1005x AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

statement ok
CREATE SEMANTIC VIEW dcf_cust_1 AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

statement ok
CREATE SEMANTIC VIEW dcf_cust_2 AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

statement ok
CREATE SCHEMA "dcf_sch'ema";

statement ok
CREATE SEMANTIC VIEW "dcf_sch'ema".dcf_q AS TABLES (o AS main.dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region);

# F-096: show_clauses.rs::limit_zero_is_accepted — LIMIT 0 is a zero-row listing; control: the same without LIMIT lists both metrics
