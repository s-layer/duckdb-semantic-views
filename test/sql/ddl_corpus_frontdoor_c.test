query TTTTTT nosort
SHOW SEMANTIC VIEWS LIKE 'dcf_pct_100%';
----
<REGEX>:.+	dcf_pct_100%x	SEMANTIC_VIEW	memory	main	(empty)
<REGEX>:.+	dcf_pct_1005x	SEMANTIC_VIEW	memory	main	(empty)
