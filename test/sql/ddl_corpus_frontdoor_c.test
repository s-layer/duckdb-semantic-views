memory	main	dcf_sw	dcf_orders	axb	VARCHAR	[]	(empty)	[]

# F-100: show_clauses.rs::filter_suffix_escapes_single_quotes (LIKE, STARTS WITH) — a doubled quote in a LIKE pattern or a STARTS WITH prefix is one literal quote that matches, not a break-out of the literal
query TTTTTT nosort
SHOW SEMANTIC VIEWS LIKE 'dcf_o''brien';
----
<REGEX>:.+	dcf_o'brien	SEMANTIC_VIEW	memory	main	(empty)

query TTTTTT nosort
SHOW SEMANTIC VIEWS STARTS WITH 'dcf_o''br';
----
<REGEX>:.+	dcf_o'brien	SEMANTIC_VIEW	memory	main	(empty)
<REGEX>:.+	dcf_o'bryan	SEMANTIC_VIEW	memory	main	(empty)

# PRE-EXISTING (TECH-DEBT #96): `table_name` in SHOW SEMANTIC DIMENSIONS keeps the qualifier as written (`main.dcf_orders`)
# F-101: show_clauses.rs::filter_suffix_escapes_single_quotes (IN SCHEMA, IN DATABASE) — a quote inside a quoted scope name reaches the predicate as data: the schema matches by its real name, a database of that shape matches nothing (no error), and the qualified <db>.<schema> form applies both halves
query TTTTTT nosort
SHOW SEMANTIC VIEWS IN SCHEMA "dcf_sch'ema";
----
<REGEX>:.+	dcf_q	SEMANTIC_VIEW	memory	dcf_sch'ema	(empty)

query TTTTTTTTT nosort
SHOW SEMANTIC DIMENSIONS IN SCHEMA memory."dcf_sch'ema";
----
memory	dcf_sch'ema	dcf_q	main.dcf_orders	region	VARCHAR	[]	(empty)	[]

query TTTTTTTTT nosort
SHOW SEMANTIC DIMENSIONS IN DATABASE "dcf_d'b";
----

query TTTTTTTTT nosort
SHOW SEMANTIC DIMENSIONS IN SCHEMA "dcf_d'b"."dcf_sch'ema";
----

# F-102: show_clauses.rs::starts_with_prefix_is_literal_not_a_like_pattern, ::starts_with_discriminates_underscore_from_wildcard_in_duckdb (underscore) — STARTS WITH 'a_b' is a literal prefix (a_b, a_bc, not axb); LIKE 'a_b' keeps its pattern meaning (a_b and axb, not a_bc)
query TTTTTTTTT nosort
SHOW SEMANTIC DIMENSIONS IN dcf_sw STARTS WITH 'a_b';
----
memory	main	dcf_sw	dcf_orders	a_b	VARCHAR	[]	(empty)	[]
memory	main	dcf_sw	dcf_orders	a_bc	VARCHAR	[]	(empty)	[]

query TTTTTTTTT nosort
SHOW SEMANTIC DIMENSIONS LIKE 'a_b' IN dcf_sw;
----
memory	main	dcf_sw	dcf_orders	a_b	VARCHAR	[]	(empty)	[]
memory	main	dcf_sw	dcf_orders	axb	VARCHAR	[]	(empty)	[]

# F-103: show_clauses.rs::starts_with_prefix_is_literal_not_a_like_pattern, ::starts_with_discriminates_underscore_from_wildcard_in_duckdb (percent) — STARTS WITH 'dcf_pct_100%' matches only the name with a literal `%`; LIKE 'dcf_pct_100%' matches both
