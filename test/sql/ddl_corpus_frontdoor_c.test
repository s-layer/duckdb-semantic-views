dcf_orders	region	VARCHAR	false	[]	(empty)

# F-090: search_path.rs::RESOLVING_READ_FUNCTIONS (base-table schema) — PRE-EXISTING (TECH-DEBT #96): DESCRIBE reports BASE_TABLE_SCHEMA_NAME = the VIEW's schema (dcf_b), but the base table resolved at CREATE to memory.main.dcf_orders (as EXPLAIN shows); there is no dcf_b.dcf_orders
query T
SELECT property_value FROM describe_semantic_view('dcf_sp') WHERE object_kind = 'TABLE' AND property = 'BASE_TABLE_SCHEMA_NAME';
----
dcf_b

query I
SELECT count(*) FROM explain_semantic_view('dcf_sp', metrics := ['total']) WHERE explain_output LIKE '%FROM "memory"."main"."dcf_orders"%';
----
1

# F-091: search_path.rs module doc ("What is deliberately NOT rewritten", TECH-DEBT #25) — the scalar functions get_ddl and read_yaml_from_semantic_view follow the session path too (since 0.16.0; they used to refuse as ambiguous with the name in two schemas, whatever the path said): with the path set to dcf_b they resolve dcf_b's view, whose fact is amt_b
query T
SELECT get_ddl('SEMANTIC_VIEW', 'dcf_sp') LIKE '%o.amt_b AS%';
----
true

query T
SELECT read_yaml_from_semantic_view('dcf_sp') LIKE '%amt_b%' AND read_yaml_from_semantic_view('dcf_sp') NOT LIKE '%amt_a%';
----
true

# --- Search path: which list of schemas is passed ---

# F-092: search_path.rs::the_expression_uses_the_explicit_search_path_not_the_implicit_one — USE puts the schema on the explicit path (and current_schema() repeats it, harmlessly)
statement ok
USE dcf_a;

query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
30

statement ok
USE memory.main;

statement ok
SET search_path = 'dcf_b';

statement ok
CREATE SEMANTIC VIEW main.dcf_sp AS TABLES (o AS main.dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount) * 10000);

# F-093: search_path.rs::the_expression_uses_the_explicit_search_path_not_the_implicit_one — with a real `main` later on the path (dcf_b, main), the first entry wins; current_schemas(true) would have put the temp schema `main` first and resolved main.dcf_sp instead
statement ok
SET search_path = 'dcf_b,main';

query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
3000

# F-094: search_path.rs::the_expression_uses_the_explicit_search_path_not_the_implicit_one — on a fresh path current_schemas(false) is empty, and the appended current_schema() (main) is what resolves
statement ok
RESET search_path;

query I
SELECT * FROM semantic_view('dcf_sp', metrics := ['total']);
----
300000

# F-095: search_path.rs module doc (resolution follows DuckDB's search path) — PRE-EXISTING (TECH-DEBT #97): an UNQUALIFIED base table in a CREATE issued under `SET search_path = 'dcf_b'` is stamped as memory.dcf_b.dcf_orders, a table that does not exist, although DuckDB itself resolves the same name on that path to main.dcf_orders (control: the plain SELECT). CREATE binds every member against the stamped table, so it refuses the view
statement ok
SET search_path = 'dcf_b';

query I
SELECT count(*) FROM dcf_orders;
----
2

statement error
CREATE SEMANTIC VIEW main.dcf_sp_unq AS TABLES (o AS dcf_orders PRIMARY KEY (id)) DIMENSIONS (o.region AS o.region) METRICS (o.total AS SUM(o.amount));
----
semantic view 'dcf_sp_unq': dimension 'region' does not bind: Catalog Error: Table with name dcf_orders does not exist

statement ok
RESET search_path;

